@@ -0,0 +1,34 @@
+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import type { Quote } from "./types";
+
+// The n8n workflow normally finishes in 40–90 s. A quote still pending after this
+// is shown as timed out (a late callback is still accepted).
+export const QUOTE_TIMEOUT_MS = 5 * 60 * 1000;
+
+export function isQuoteTimedOut(quote: Quote, now = Date.now()) {
+  return quote.status === "pending" && now - Date.parse(quote.createdAt) > QUOTE_TIMEOUT_MS;
+}
+
+export function createCallbackToken() {
+  const token = randomBytes(32).toString("base64url");
+  return { token, hash: hashToken(token).toString("hex") };
+}
+
+function hashToken(token: string) {
+  return createHash("sha256").update(token).digest();
+}
+
+export function verifyCallbackToken(token: string, expectedHash: string) {
+  return timingSafeEqual(hashToken(token), Buffer.from(expectedHash, "hex"));
+}
+
+// Only http(s) links are rendered, so a callback can't smuggle in `javascript:` URLs.
+export function parsePdfUrl(value: unknown) {
+  if (typeof value !== "string" || value.length > 2000) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" || url.protocol === "http:" ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
