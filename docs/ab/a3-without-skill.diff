+export type QuoteStatus = "pending" | "ready" | "failed";
+
+export type Quote = {
+  id: string;
+  company: string;
+  email: string;
+  description: string;
+  budget: number | null;
+  status: QuoteStatus;
+  // SHA-256 of the one-time token n8n must present on the callback; the token itself is never stored.
+  callbackTokenHash: string;
+  pdfUrl: string | null;
