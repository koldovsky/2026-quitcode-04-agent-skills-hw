+import type { NextRequest } from "next/server";
+import { db } from "@/lib/db";
+import { parsePdfUrl, verifyCallbackToken } from "@/lib/quotes";
+
+const MAX_BODY_BYTES = 16 * 1024;
+
+// Called by the n8n `quote-request` workflow when the PDF is ready (or generation failed).
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <callback.token from the trigger payload>
+//   { "status": "ready", "pdfUrl": "https://…" }  or  { "status": "failed", "error": "…" }
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+
+  const token = request.headers.get("authorization")?.match(/^Bearer (\S+)$/)?.[1];
+  const quote = await db.getQuote(id);
+  // Same answer for "no such quote" and "wrong token", so ids can't be probed.
+  if (!token || !quote || !verifyCallbackToken(token, quote.callbackTokenHash)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const raw = await request.text();
+  if (raw.length > MAX_BODY_BYTES) {
+    return Response.json({ error: "payload too large" }, { status: 413 });
+  }
+
+  let body: unknown;
+  try {
+    body = JSON.parse(raw);
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+  const payload = (body ?? {}) as { status?: unknown; pdfUrl?: unknown; error?: unknown };
+
+  let result: { status: "ready"; pdfUrl: string } | { status: "failed"; error: string };
+  if (payload.status === "ready") {
+    const pdfUrl = parsePdfUrl(payload.pdfUrl);
+    if (!pdfUrl) return Response.json({ error: "pdfUrl must be an http(s) URL" }, { status: 400 });
+    result = { status: "ready", pdfUrl };
+  } else if (payload.status === "failed") {
+    const error = typeof payload.error === "string" ? payload.error.slice(0, 500) : "unknown error";
+    result = { status: "failed", error };
+  } else {
+    return Response.json({ error: 'status must be "ready" or "failed"' }, { status: 400 });
+  }
+
+  const updated = await db.finalizeQuote(id, result);
+  if (!updated) {
+    // n8n retries after a lost response must not fail the workflow; the first result wins.
+    return Response.json({ ok: true, status: quote.status, alreadyFinal: true });
+  }
+
+  if (result.status === "failed") {
+    console.error(`Quote ${id}: n8n reported a failure: ${result.error}`);
+  }
+  return Response.json({ ok: true, status: result.status });
+}
