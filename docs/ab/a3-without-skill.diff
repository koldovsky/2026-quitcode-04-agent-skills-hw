@@ -0,0 +1,70 @@
+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+import { createCallbackToken } from "@/lib/quotes";
+
+// Only the trigger is awaited: the webhook must be set to "Respond: Immediately" in n8n,
+// the finished quote arrives later at /api/quotes/[id]/callback.
+const TRIGGER_TIMEOUT_MS = 10_000;
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> }
+  | { status: "unavailable" };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors };
+  }
+
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  // The callback base URL comes from config, never from the Host header: otherwise a forged
+  // Host would make n8n send the callback token to someone else's server.
+  const appUrl = process.env.APP_URL;
+  if (!webhookUrl || !appUrl) {
+    console.error("Quote requests are disabled: N8N_QUOTE_WEBHOOK_URL or APP_URL is not set");
+    return { status: "unavailable" };
+  }
+
+  const { token, hash } = createCallbackToken();
+  const quote = await db.insertQuote({ ...parsed.data, callbackTokenHash: hash });
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        createdAt: quote.createdAt,
+        callback: {
+          url: new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString(),
+          token,
+        },
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    if (!response.ok) {
+      throw new Error(`n8n responded with ${response.status}`);
+    }
+  } catch (error) {
+    if (error instanceof Error && error.name === "TimeoutError") {
+      // n8n may have accepted the request and still be working; keep it pending.
+      console.error(`Quote ${quote.id}: n8n did not answer the trigger within ${TRIGGER_TIMEOUT_MS} ms`);
+    } else {
+      console.error(`Quote ${quote.id}: failed to start the n8n workflow`, error);
+      await db.finalizeQuote(quote.id, { status: "failed", error: "trigger failed" });
+    }
+  }
+
+  redirect(`/quotes/${quote.id}`);
+}
