+++ b/components/quote-status-refresher.tsx
@@ -0,0 +1,19 @@
+"use client";
+
+import { useEffect } from "react";
+import { useRouter } from "next/navigation";
+
+const REFRESH_MS = 5_000;
+
+// Re-renders the status page while the quote is in progress. The page stops rendering
+// this component once the quote is ready or failed, which stops the polling.
+export function QuoteStatusRefresher() {
+  const router = useRouter();
+
+  useEffect(() => {
+    const timer = setInterval(() => router.refresh(), REFRESH_MS);
+    return () => clearInterval(timer);
+  }, [router]);
+
+  return null;
+}
