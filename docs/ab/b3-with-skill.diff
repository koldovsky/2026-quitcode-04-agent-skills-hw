+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusRefresher } from "@/components/quote-status-refresher";
+import { db } from "@/lib/db";
+import type { QuoteStatus } from "@/lib/types";
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+const STATUS_TEXT: Record<QuoteStatus, { title: string; text: string; style: string }> = {
+  queued: {
+    title: "Запит прийнято",
+    text: "Передаємо задачу на підготовку кошторису…",
+    style: "border-sky-200 bg-sky-50",
+  },
+  processing: {
+    title: "Готуємо кошторис",
+    text: "Зазвичай це займає 40–90 секунд. Сторінка оновиться сама.",
+    style: "border-amber-200 bg-amber-50",
+  },
+  ready: {
+    title: "Кошторис готовий",
+    text: "Завантажте PDF за посиланням нижче.",
+    style: "border-emerald-200 bg-emerald-50",
+  },
+  failed: {
+    title: "Не вдалося підготувати кошторис",
+    text: "Спробуйте надіслати запит ще раз трохи пізніше.",
+    style: "border-red-200 bg-red-50",
+  },
+};
+
+// Public page, reachable by the random quote id only: it never shows the email.
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await db.getQuote(id);
+  if (!quote) notFound();
+
+  const status = STATUS_TEXT[quote.status];
+  const inProgress = quote.status === "queued" || quote.status === "processing";
+
+  return (
+    <main className="mx-auto w-full max-w-2xl flex-1 space-y-6 px-6 py-12">
+      <Link href="/quotes/new" className="text-sm text-slate-500 hover:text-slate-900">
+        ← Новий запит
+      </Link>
+
+      <div>
+        <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+        <p className="text-sm text-slate-500">Запит від {dateTimeFormat.format(new Date(quote.createdAt))}</p>
+      </div>
+
+      <section className={`space-y-2 rounded-lg border p-5 text-sm ${status.style}`} aria-live="polite">
+        <h2 className="flex items-center gap-2 font-medium">
+          {inProgress && <span className="h-2 w-2 animate-pulse rounded-full bg-current" aria-hidden />}
+          {status.title}
+        </h2>
+        <p className="text-slate-700">{status.text}</p>
+        {quote.status === "ready" && quote.documentUrl && (
+          <a
+            href={quote.documentUrl}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="inline-flex rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700"
+          >
+            Завантажити PDF
+          </a>
+        )}
+      </section>
+
+      {inProgress && <QuoteStatusRefresher />}
+    </main>
+  );
+}
