@@ -0,0 +1,124 @@
+import { createHash, createHmac, timingSafeEqual } from "node:crypto";
+import { db } from "@/lib/db";
+
+// Callbacks from n8n: POST /api/n8n/<event>. The endpoint is public, so only the HMAC signature is trusted.
+// Contract: .claude/skills/integrating-n8n-webhooks/references/contract.md, section 3.
+
+const MAX_BODY_BYTES = 64 * 1024;
+const WINDOW_SECONDS = 300;
+
+type CallbackData = {
+  jobId: string;
+  status: "completed" | "failed";
+  requestIdempotencyKey: string;
+  result?: { documentUrl?: string };
+  error?: { code?: string };
+};
+
+type Callback = { version: 1; event: string; data: CallbackData };
+
+// The status page renders the link, so accept only absolute http(s) URLs (no javascript: and the like).
+function documentUrlOf(data: CallbackData) {
+  const value = data.result?.documentUrl;
+  if (typeof value !== "string" || value.length > 2048) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" || url.protocol === "http:" ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
+
+// One handler per event: "invalid" -> 400, "not-found" -> 404, "ok" -> the state is saved.
+const HANDLERS: Record<string, (data: CallbackData) => Promise<"ok" | "invalid" | "not-found">> = {
+  "quote-request": async (data) => {
+    const documentUrl = data.status === "completed" ? documentUrlOf(data) : null;
+    if (data.status === "completed" && !documentUrl) return "invalid";
+    const quote = await db.getQuoteByRequestKey(data.requestIdempotencyKey);
+    if (!quote) return "not-found";
+    await db.updateQuote(
+      quote.id,
+      data.status === "completed" ? { status: "ready", documentUrl } : { status: "failed" },
+    );
+    return "ok";
+  },
+};
+
+const reply = (status: number, body: Record<string, unknown> = {}) => Response.json(body, { status });
+
+export async function POST(request: Request, ctx: RouteContext<"/api/n8n/[event]">) {
+  const started = Date.now();
+  const { event } = await ctx.params;
+  const correlationId = request.headers.get("x-correlation-id")?.slice(0, 100) ?? "-";
+  const bodyInfo: { bytes?: number; sha256?: string } = {}; // filled once the body is read
+  // Event, direction, correlation id, status, duration, body size and hash. Never bodies or signatures.
+  const done = (status: number, body?: Record<string, unknown>) => {
+    console.info(JSON.stringify({ n8n: "in", event, correlationId, status, ms: Date.now() - started, ...bodyInfo }));
+    return reply(status, body);
+  };
+
+  // 1. Before reading the body
+  const handler = Object.hasOwn(HANDLERS, event) ? HANDLERS[event] : undefined;
+  if (!handler) return done(404, { error: "unknown event" });
+  if (!request.headers.get("content-type")?.toLowerCase().startsWith("application/json")) return done(415);
+  if (Number(request.headers.get("content-length") ?? 0) > MAX_BODY_BYTES) return done(413);
+
+  // 2-3. Raw body, read once; no request.json() and no JSON.parse before the signature
+  const raw = await request.text();
+  const bytes = Buffer.byteLength(raw);
+  Object.assign(bodyInfo, { bytes, sha256: createHash("sha256").update(raw).digest("hex") });
+  if (bytes > MAX_BODY_BYTES) return done(413);
+
+  // 4. Timestamp window, both directions
+  const timestamp = request.headers.get("x-n8n-timestamp") ?? "";
+  if (!/^\d{1,12}$/.test(timestamp) || Math.abs(Date.now() / 1000 - Number(timestamp)) > WINDOW_SECONDS) {
+    return done(401);
+  }
+
+  // 5. Signature over "<timestamp>.<raw body>": length first, then timingSafeEqual
+  const secret = process.env.N8N_CALLBACK_SECRET;
+  if (!secret) return done(500);
+  const expected = Buffer.from(`sha256=${createHmac("sha256", secret).update(`${timestamp}.${raw}`).digest("hex")}`);
+  const given = Buffer.from(request.headers.get("x-n8n-signature") ?? "");
+  if (given.length !== expected.length || !timingSafeEqual(given, expected)) return done(401);
+
+  // 6. Claim the idempotency key
+  const key = request.headers.get("idempotency-key") ?? "";
+  if (!key || key.length > 200) return done(400);
+  if (!(await db.claimCallbackKey(key))) return done(200, { duplicate: true });
+
+  try {
+    // 7. Now parse and check the shape; the key must equal fields of the SIGNED body
+    let body: Callback;
+    try {
+      body = JSON.parse(raw);
+    } catch {
+      await db.releaseCallbackKey(key);
+      return done(400);
+    }
+    const d = body?.data;
+    const shapeOk =
+      body?.version === 1 &&
+      typeof d?.jobId === "string" &&
+      typeof d?.requestIdempotencyKey === "string" &&
+      (d.status === "completed" || d.status === "failed") &&
+      (body.event === `${event}.completed` || body.event === `${event}.failed`);
+    if (!shapeOk || key !== `${d.jobId}:${body.event}`) {
+      await db.releaseCallbackKey(key);
+      return done(400);
+    }
+
+    // 8-9. Save the minimal state BEFORE answering: after a 2xx n8n will not call again
+    const outcome = await handler(d);
+    if (outcome !== "ok") {
+      await db.releaseCallbackKey(key);
+      return done(outcome === "invalid" ? 400 : 404);
+    }
+  } catch {
+    await db.releaseCallbackKey(key);
+    return done(500);
+  }
+
+  // 10. No slow side effects for quote-request yet; they would go into after() here.
+  return done(202, { ok: true });
+}
