+import { createHmac, timingSafeEqual } from "node:crypto";
+import { db } from "@/lib/db";
+import type { QuoteCallbackResult } from "@/lib/types";
+
+// n8n → LeadDesk callbacks. Anyone can POST here: only the HMAC signature (N8N_CALLBACK_SECRET)
+// is trusted, and the order of checks below is the team contract — see
+// .claude/skills/integrating-n8n-webhooks/references/callback.md before changing it.
+
+const KNOWN_EVENTS = new Set(["quote-request"]);
+const MAX_BODY_BYTES = 64 * 1024;
+const WINDOW_SECONDS = 300;
+
+export async function POST(req: Request, ctx: RouteContext<"/api/n8n/[event]">) {
+  const { event } = await ctx.params;
+  if (!KNOWN_EVENTS.has(event)) return Response.json({ error: "not_found" }, { status: 404 });
+  if (!req.headers.get("content-type")?.toLowerCase().startsWith("application/json")) {
+    return Response.json({ error: "unsupported_media_type" }, { status: 415 });
+  }
+
+  const raw = await req.text(); // raw body: the signature covers exactly these bytes
+  if (Buffer.byteLength(raw) > MAX_BODY_BYTES) return Response.json({ error: "too_large" }, { status: 413 });
+
+  const timestamp = req.headers.get("x-n8n-timestamp") ?? "";
+  const ts = Number(timestamp);
+  if (!/^\d+$/.test(timestamp) || Math.abs(Date.now() / 1000 - ts) > WINDOW_SECONDS) return unauthorized();
+  if (!verifySignature(timestamp, raw, req.headers.get("x-n8n-signature"))) return unauthorized();
+
+  const key = req.headers.get("idempotency-key");
+  if (!key) return Response.json({ error: "bad_request" }, { status: 400 });
+  if (!(await db.claimCallbackKey(key))) return Response.json({ duplicate: true }, { status: 200 });
+
+  const correlationId = req.headers.get("x-correlation-id");
+  try {
+    const body = parseCallback(raw);
+    if (!body || body.event !== `${event}.completed` || key !== `${body.data.jobId}:${body.event}`) {
+      await db.releaseCallbackKey(key);
+      return Response.json({ error: "bad_request" }, { status: 400 });
+    }
+    // minimal state is saved BEFORE the response: after a 2xx n8n will not retry
+    if (!(await db.completeQuote(body.data))) {
+      await db.releaseCallbackKey(key);
+      console.warn("n8n.in", { event, correlationId, status: 404, error: "unknown_job" });
+      return Response.json({ error: "not_found" }, { status: 404 });
+    }
+  } catch (error) {
+    await db.releaseCallbackKey(key);
+    console.error("n8n.in", { event, correlationId, status: 500, error: (error as Error).name });
+    return Response.json({ error: "internal" }, { status: 500 });
+  }
+
+  console.info("n8n.in", { event, correlationId, status: 202 });
+  return Response.json({ ok: true }, { status: 202 });
+}
+
+function verifySignature(timestamp: string, raw: string, header: string | null) {
+  const secret = process.env.N8N_CALLBACK_SECRET;
+  if (!secret || !header) return false;
+  const expected = Buffer.from(`sha256=${createHmac("sha256", secret).update(`${timestamp}.${raw}`).digest("hex")}`);
+  const given = Buffer.from(header);
+  return given.length === expected.length && timingSafeEqual(given, expected);
+}
+
+function unauthorized() {
+  return Response.json({ error: "unauthorized" }, { status: 401 });
+}
+
+type Callback = { event: string; data: QuoteCallbackResult };
+
+// Called only after the signature check. Still validated field by field: documentUrl ends up
+// as a link on a public page, so only http(s) URLs are accepted.
+function parseCallback(raw: string): Callback | null {
+  let body;
+  try {
+    body = JSON.parse(raw);
+  } catch {
+    return null;
+  }
+  const data = body?.data;
+  if (body?.version !== 1 || typeof body.event !== "string" || typeof data?.jobId !== "string" || !data.jobId) {
+    return null;
+  }
+  const requestIdempotencyKey = typeof data.requestIdempotencyKey === "string" ? data.requestIdempotencyKey : null;
+
+  if (data.status === "completed") {
+    const documentUrl = safeUrl(data.result?.documentUrl);
+    if (!documentUrl) return null;
+    return { event: body.event, data: { jobId: data.jobId, requestIdempotencyKey, status: "completed", documentUrl, errorCode: null } };
+  }
+  if (data.status === "failed") {
+    const code = data.error?.code;
+    const errorCode = typeof code === "string" && /^[\w.-]{1,64}$/.test(code) ? code : "unknown";
+    return { event: body.event, data: { jobId: data.jobId, requestIdempotencyKey, status: "failed", documentUrl: null, errorCode } };
+  }
+  return null;
+}
+
+function safeUrl(value: unknown) {
+  if (typeof value !== "string" || value.length > 2048) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" || url.protocol === "http:" ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
