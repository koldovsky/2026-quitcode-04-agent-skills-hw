+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusRefresh } from "@/components/quote-status-refresh";
+import { db } from "@/lib/db";
+import type { Quote } from "@/lib/types";
+
+// The page is public and the random id in its URL is the only key to it: keep it out of search
+// engines and out of the Referer header, and show no contact details.
+export const metadata: Metadata = {
+  title: "Статус кошторису · Studio Nova",
+  robots: { index: false, follow: false },
+  referrer: "no-referrer",
+};
+
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
+// The workflow takes 40–90 s; after this the request most likely got lost on the way.
+const STALE_AFTER_MS = 5 * 60 * 1000;
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+function isStale(quote: Quote) {
+  return Date.now() - Date.parse(quote.createdAt) > STALE_AFTER_MS;
+}
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = UUID_RE.test(id) ? await db.getQuote(id) : null;
+  if (!quote) notFound();
+
+  const pending = quote.status === "queued" || quote.status === "processing";
+  const stale = pending && isStale(quote);
+
+  return (
+    <main className="flex flex-1 items-center justify-center px-6 py-16">
+      <div className="w-full max-w-md space-y-6 rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
+        <div className="space-y-1">
+          <h1 className="text-xl font-semibold">Кошторис для {quote.company}</h1>
+          <p className="text-sm text-slate-500">Запит від {dateTimeFormat.format(new Date(quote.createdAt))}</p>
+        </div>
+
+        {pending && !stale && (
+          <div className="space-y-2 rounded-lg bg-sky-50 p-4 text-sm text-sky-800">
+            <p className="font-medium">{quote.status === "queued" ? "Запит у черзі" : "Готуємо кошторис…"}</p>
+            <p>Зазвичай це займає одну-дві хвилини. Сторінка оновиться сама.</p>
+            <QuoteStatusRefresh />
+          </div>
+        )}
+
+        {stale && (
+          <div className="space-y-2 rounded-lg bg-amber-50 p-4 text-sm text-amber-800">
+            <p className="font-medium">Кошторис затримується</p>
+            <p>
+              Оновіть сторінку за кілька хвилин. Якщо кошторис так і не з&apos;явиться —{" "}
+              <Link href="/" className="underline">
+                залиште заявку
+              </Link>
+              , і менеджер підготує його вручну.
+            </p>
+          </div>
+        )}
+
+        {quote.status === "ready" && quote.documentUrl && (
+          <div className="space-y-3 rounded-lg bg-emerald-50 p-4 text-sm text-emerald-800">
+            <p className="font-medium">Кошторис готовий</p>
+            <a
+              href={quote.documentUrl}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="inline-flex rounded-md bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700"
+            >
+              Завантажити PDF
+            </a>
+          </div>
+        )}
+
+        {quote.status === "failed" && (
+          <div className="space-y-2 rounded-lg bg-red-50 p-4 text-sm text-red-800">
+            <p className="font-medium">Не вдалося підготувати кошторис автоматично</p>
+            <p>
+              <Link href="/quotes/new" className="underline">
+                Спробуйте ще раз
+              </Link>{" "}
+              або{" "}
+              <Link href="/" className="underline">
+                залиште заявку
+              </Link>
+              , і менеджер підготує кошторис вручну.
+            </p>
+          </div>
+        )}
+
+        <Link href="/quotes/new" className="block text-center text-sm text-slate-500 hover:text-slate-900">
+          ← Новий запит
+        </Link>
+      </div>
+    </main>
+  );
+}
