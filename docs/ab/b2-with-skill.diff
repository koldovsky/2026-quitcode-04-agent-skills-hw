+import crypto from "node:crypto";
+import { db } from "@/lib/db";
+import { handleQuoteCallback, parseCallback } from "@/lib/n8n/callbacks";
+
+// Signed callbacks from n8n. Public endpoint: only the HMAC signature is trusted.
+// The order of the steps matters — see .claude/skills/integrating-n8n-webhooks/references/callback-route.md.
+
+const MAX_BODY_BYTES = 64 * 1024;
+const WINDOW_SECONDS = 300;
+const HANDLERS = { "quote-request": handleQuoteCallback } as const;
+
+export async function POST(req: Request, ctx: RouteContext<"/api/n8n/[event]">) {
+  const { event } = await ctx.params;
+  const handler = HANDLERS[event as keyof typeof HANDLERS];
+  if (!handler) return Response.json({ error: "not_found" }, { status: 404 });
+  if (!req.headers.get("content-type")?.toLowerCase().startsWith("application/json"))
+    return Response.json({ error: "unsupported_media_type" }, { status: 415 });
+
+  const raw = await req.text();
+  if (Buffer.byteLength(raw) > MAX_BODY_BYTES) return Response.json({ error: "too_large" }, { status: 413 });
+
+  const ts = Number(req.headers.get("x-n8n-timestamp"));
+  if (!Number.isFinite(ts) || Math.abs(Date.now() / 1000 - ts) > WINDOW_SECONDS) return unauthorized();
+
+  const secret = process.env.N8N_CALLBACK_SECRET;
+  if (!secret) return Response.json({ error: "not_configured" }, { status: 500 });
+  const expected = Buffer.from("sha256=" + crypto.createHmac("sha256", secret).update(`${ts}.${raw}`).digest("hex"));
+  const received = Buffer.from(req.headers.get("x-n8n-signature") ?? "");
+  if (received.length !== expected.length || !crypto.timingSafeEqual(received, expected)) return unauthorized();
+
+  const key = req.headers.get("idempotency-key") ?? "";
+  if (!key) return badRequest();
+  if (!(await db.claimCallbackKey(key))) return Response.json({ duplicate: true }, { status: 200 });
+
+  try {
+    const body = parseCallback(JSON.parse(raw));
+    // The key header is not signed, so it must equal fields of the signed body.
+    if (!body || body.event !== `${event}.${body.data.status}` || key !== `${body.data.jobId}:${body.event}`) {
+      await db.releaseCallbackKey(key);
+      return badRequest();
+    }
+
+    // Saved before answering: after a 2xx n8n never sends this callback again.
+    const outcome = await handler(body);
+    if (outcome !== "ok") {
+      await db.releaseCallbackKey(key);
+      return outcome === "not_found" ? Response.json({ error: "unknown_job" }, { status: 404 }) : badRequest();
+    }
+
+    const { correlationId } = body.data;
+    console.info("n8n.callback", { event: body.event, correlationId, status: 202, bytes: raw.length });
+    return Response.json({ ok: true }, { status: 202 });
+  } catch {
+    await db.releaseCallbackKey(key);
+    return Response.json({ error: "internal" }, { status: 500 });
+  }
+}
+
+const unauthorized = () => Response.json({ error: "unauthorized" }, { status: 401 });
+const badRequest = () => Response.json({ error: "bad_request" }, { status: 400 });
