diff --git a/lib/n8n/callbacks.ts b/lib/n8n/callbacks.ts
new file mode 100644
index 0000000..7dc409f
--- /dev/null
+++ b/lib/n8n/callbacks.ts
@@ -0,0 +1,76 @@
+import "server-only";
+import { db } from "@/lib/db";
+
+// Body of a signed callback from n8n. Parsed only after the signature is verified
+// (app/api/n8n/[event]/route.ts).
+export type N8nCallback = {
+  version: 1;
+  event: string;
+  data: {
+    jobId: string;
+    status: "completed" | "failed";
+    correlationId: string | null;
+    requestIdempotencyKey: string | null;
+    documentUrl: string | null;
+    errorCode: string | null;
+  };
+};
+
+export type CallbackOutcome = "ok" | "not_found" | "invalid";
+
+const MAX_ID_LENGTH = 128;
+const ERROR_CODE_RE = /^[A-Za-z0-9_.-]{1,64}$/;
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+
+const shortString = (value: unknown) =>
+  typeof value === "string" && value.length > 0 && value.length <= MAX_ID_LENGTH ? value : null;
+
+export function parseCallback(value: unknown): N8nCallback | null {
+  if (!isRecord(value) || value.version !== 1 || typeof value.event !== "string" || !isRecord(value.data)) return null;
+  const { data } = value;
+  const jobId = shortString(data.jobId);
+  if (!jobId || (data.status !== "completed" && data.status !== "failed")) return null;
+
+  const result = isRecord(data.result) ? data.result : {};
+  const error = isRecord(data.error) ? data.error : {};
+  return {
+    version: 1,
+    event: value.event,
+    data: {
+      jobId,
+      status: data.status,
+      correlationId: shortString(data.correlationId),
+      requestIdempotencyKey: shortString(data.requestIdempotencyKey),
+      documentUrl: typeof result.documentUrl === "string" ? result.documentUrl : null,
+      errorCode: typeof error.code === "string" && ERROR_CODE_RE.test(error.code) ? error.code : null,
+    },
+  };
+}
+
+// The link ends up in an <a href>, so only absolute https URLs are accepted.
+function httpsUrl(value: string | null) {
+  if (!value || value.length > 2048) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function handleQuoteCallback(body: N8nCallback): Promise<CallbackOutcome> {
+  const { jobId, requestIdempotencyKey, status } = body.data;
+  const quote = await db.findQuoteForCallback(requestIdempotencyKey, jobId);
+  if (!quote) return "not_found";
+
+  if (status === "completed") {
+    const documentUrl = httpsUrl(body.data.documentUrl);
+    if (!documentUrl) return "invalid";
+    await db.updateQuote(quote.id, { status: "ready", jobId, documentUrl, errorCode: null }, ["queued", "processing"]);
+  } else {
+    await db.updateQuote(quote.id, { status: "failed", jobId, errorCode: body.data.errorCode ?? "workflow_failed" }, ["queued", "processing"]);
+  }
+  return "ok";
+}
diff --git a/lib/n8n/client.ts b/lib/n8n/client.ts
new file mode 100644
index 0000000..5e92a20
--- /dev/null
+++ b/lib/n8n/client.ts
@@ -0,0 +1,79 @@
+import "server-only";
+
+// The only module that calls n8n. Contract: .claude/skills/integrating-n8n-webhooks.
+
+const RETRY_DELAYS_MS = [1_000, 3_000];
+const MAX_JOB_ID_LENGTH = 128;
+
+export type TriggerResult =
+  | { ok: true; status: number; attempts: number; jobId: string | null }
+  | { ok: false; status: number | null; attempts: number };
+
+export async function triggerN8nWebhook(options: {
+  event: string;                 // kebab-case, = webhook path
+  data: Record<string, unknown>; // only what the workflow needs
+  idempotencyKey: string;        // stored with the record, the same on every retry
+  correlationId: string;
+  callback?: boolean;            // true for async workflows (202 + signed callback)
+}): Promise<TriggerResult> {
+  const base = process.env.N8N_WEBHOOK_BASE_URL;
+  const token = process.env.N8N_WEBHOOK_TOKEN;
+  const appBaseUrl = process.env.APP_BASE_URL;
+  if (!base || !token || (options.callback && !appBaseUrl)) {
+    console.error("n8n.webhook", { event: options.event, correlationId: options.correlationId, status: "not_configured" });
+    return { ok: false, status: null, attempts: 0 };
+  }
+
+  const body = JSON.stringify({
+    version: 1,
+    event: options.event,
+    data: options.data,
+    ...(options.callback ? { callbackUrl: `${appBaseUrl}/api/n8n/${options.event}` } : {}),
+  });
+
+  for (let attempt = 1; ; attempt++) {
+    const started = Date.now();
+    let status: number | null = null;
+    try {
+      const res = await fetch(`${base}/${options.event}`, {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+          "x-n8n-token": token,
+          "idempotency-key": options.idempotencyKey,
+          "x-correlation-id": options.correlationId,
+        },
+        body,
+        signal: AbortSignal.timeout(10_000),
+        cache: "no-store",
+      });
+      status = res.status;
+      if (res.ok) {
+        const jobId = status === 202 ? await readJobId(res) : null;
+        if (status !== 202) await res.body?.cancel();
+        console.info("n8n.webhook", { event: options.event, correlationId: options.correlationId, status, attempt, ms: Date.now() - started });
+        return { ok: true, status, attempts: attempt, jobId };
+      }
+      await res.body?.cancel();
+    } catch {
+      // network error or TimeoutError — retry
+    }
+    console.warn("n8n.webhook", { event: options.event, correlationId: options.correlationId, status, attempt, ms: Date.now() - started });
+    const retryable = status === null || status >= 500; // 5xx and 524; 4xx is not retried
+    if (!retryable || attempt > RETRY_DELAYS_MS.length) return { ok: false, status, attempts: attempt };
+    await new Promise((r) => setTimeout(r, RETRY_DELAYS_MS[attempt - 1]));
+  }
+}
+
+// Respond to Webhook answers 202 {"job_id": …}. That id is the only thing we take from
+// n8n's response (the callback carries it as data.jobId); a missing or odd body is fine.
+async function readJobId(res: Response) {
+  try {
+    const jobId = ((await res.json()) as { job_id?: unknown } | null)?.job_id;
+    if (typeof jobId !== "string" && typeof jobId !== "number") return null;
+    const value = String(jobId);
+    return value.length > 0 && value.length <= MAX_JOB_ID_LENGTH ? value : null;
+  } catch {
+    return null;
+  }
+}
diff --git a/lib/quote-form.ts b/lib/quote-form.ts
new file mode 100644
index 0000000..3ebeaca
--- /dev/null
+++ b/lib/quote-form.ts
@@ -0,0 +1,49 @@
+import type { NewQuote } from "./types";
+
+export type QuoteFormField = "company" | "email" | "description" | "budget";
+
+export type QuoteFormValues = Record<QuoteFormField, string>;
+
+export type QuoteParseResult =
+  | { ok: true; data: NewQuote }
+  | { ok: false; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues };
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const MIN_BUDGET = 100;
+const MAX_BUDGET = 1_000_000;
+
+function text(formData: FormData, name: QuoteFormField, max: number) {
+  const value = formData.get(name);
+  return typeof value === "string" ? value.trim().slice(0, max) : "";
+}
+
+export function parseQuoteForm(formData: FormData): QuoteParseResult {
+  const values: QuoteFormValues = {
+    company: text(formData, "company", 120),
+    email: text(formData, "email", 200).toLowerCase(),
+    description: text(formData, "description", 4000),
+    budget: text(formData, "budget", 12),
+  };
+
+  const errors: Partial<Record<QuoteFormField, string>> = {};
+
+  if (!values.company) errors.company = "Вкажіть компанію";
+  if (!EMAIL_RE.test(values.email)) errors.email = "Перевірте email";
+  if (values.description.length < 20) errors.description = "Опишіть задачу хоча б кількома реченнями";
+
+  let budget: number | null = null;
+  if (values.budget) {
+    const amount = Number(values.budget.replace(/[\s,]/g, ""));
+    if (!Number.isInteger(amount) || amount < MIN_BUDGET || amount > MAX_BUDGET) {
+      errors.budget = `Вкажіть суму в доларах: від ${MIN_BUDGET} до ${MAX_BUDGET.toLocaleString("uk-UA")}`;
+    } else {
+      budget = amount;
+    }
+  }
+
+  if (Object.keys(errors).length > 0) return { ok: false, errors, values };
+  return {
+    ok: true,
+    data: { company: values.company, email: values.email, description: values.description, budget },
+  };
+}
