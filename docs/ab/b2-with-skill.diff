+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusRefresh } from "@/components/quote-status-refresh";
+import { db } from "@/lib/db";
+import type { Quote, QuoteStatus } from "@/lib/types";
+
+// The workflow normally finishes within 90 s; past this point we tell the visitor it is late.
+const OVERDUE_MS = 5 * 60 * 1000;
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+const usd = new Intl.NumberFormat("uk-UA", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
+
+const STATUS_TEXT: Record<QuoteStatus, { label: string; className: string }> = {
+  queued: { label: "У черзі", className: "bg-slate-100 text-slate-700" },
+  processing: { label: "Готуємо кошторис", className: "bg-amber-100 text-amber-800" },
+  ready: { label: "Готово", className: "bg-emerald-100 text-emerald-800" },
+  failed: { label: "Не вдалося", className: "bg-red-100 text-red-700" },
+};
+
+function isOverdue(quote: Quote) {
+  return Date.now() - Date.parse(quote.createdAt) > OVERDUE_MS;
+}
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await db.getQuote(id);
+  if (!quote) notFound();
+
+  const inProgress = quote.status === "queued" || quote.status === "processing";
+  const status = STATUS_TEXT[quote.status];
+
+  return (
+    <div className="flex flex-1 flex-col">
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
+          <Link href="/" className="text-lg font-semibold tracking-tight">
+            Studio Nova
+          </Link>
+          <Link href="/quotes/new" className="text-sm text-slate-500 hover:text-slate-900">
+            Новий запит
+          </Link>
+        </div>
+      </header>
+
+      <main className="mx-auto w-full max-w-3xl flex-1 space-y-6 px-6 py-12">
+        <div className="flex items-start justify-between gap-4">
+          <div>
+            <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+            <p className="text-sm text-slate-500">Запит від {dateTimeFormat.format(new Date(quote.createdAt))}</p>
+          </div>
+          <span className={`rounded-full px-3 py-1 text-sm font-medium ${status.className}`}>{status.label}</span>
+        </div>
+
+        <section className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" aria-live="polite">
+          {inProgress && (
+            <div className="space-y-1">
+              <p className="font-medium">Кошторис готується — зазвичай до двох хвилин.</p>
+              <p className="text-sm text-slate-600">
+                {isOverdue(quote)
+                  ? "Це триває довше, ніж зазвичай. Сторінка оновиться сама, щойно кошторис буде готовий."
+                  : "Сторінку можна не оновлювати: статус зміниться автоматично."}
+              </p>
+            </div>
+          )}
+          {quote.status === "ready" && quote.documentUrl && (
+            <div className="space-y-3">
+              <p className="font-medium">Кошторис готовий.</p>
+              <a
+                href={quote.documentUrl}
+                target="_blank"
+                rel="noopener noreferrer"
+                className="inline-block rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
+              >
+                Завантажити PDF
+              </a>
+            </div>
+          )}
+          {quote.status === "failed" && (
+            <div className="space-y-1">
+              <p className="font-medium">Не вдалося підготувати кошторис.</p>
+              <p className="text-sm text-slate-600">
+                Спробуйте{" "}
+                <Link href="/quotes/new" className="text-indigo-600 hover:underline">
+                  надіслати запит ще раз
+                </Link>{" "}
+                трохи пізніше.
+              </p>
+            </div>
+          )}
+        </section>
+
+        <section className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
+          <h2 className="mb-3 text-sm font-medium text-slate-500">Опис задачі</h2>
+          <p className="whitespace-pre-line text-sm">{quote.description}</p>
+          <p className="mt-4 text-sm text-slate-600">
+            Бюджет: {quote.budget === null ? "не вказано" : usd.format(quote.budget)}
+          </p>
+        </section>
+      </main>
+
+      {inProgress && <QuoteStatusRefresh />}
+    </div>
+  );
+}
