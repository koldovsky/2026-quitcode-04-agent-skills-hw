@@ -0,0 +1,21 @@
+"use server";
+
+import { redirect } from "next/navigation";
+import { after } from "next/server";
+import { parseQuoteForm, type QuoteFormField, type QuoteFormValues } from "@/lib/quote-form";
+import { createQuoteRequest, startQuoteWorkflow } from "@/lib/quotes";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues };
+
+// A Server Action is a public endpoint. The quote form is public too, so there is no session to
+// check; everything is validated here and the caller only ever gets a status, never a database row.
+export async function requestQuote(_prevState: RequestQuoteState, formData: FormData): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) return { status: "invalid", errors: parsed.errors, values: parsed.values };
+
+  const quote = await createQuoteRequest(parsed.data); // saved as "queued" before n8n is called
+  after(() => startQuoteWorkflow(quote.id)); // the workflow takes 40-90 s: the visitor never waits for it
+  redirect(`/quotes/${quote.id}`);
+}
