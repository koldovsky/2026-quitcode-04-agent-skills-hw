+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { connection } from "next/server";
+import { QuoteStatusRefresh } from "@/components/quote-status-refresh";
+import { db } from "@/lib/db";
+import { isHttpsUrl } from "@/lib/n8n/envelope";
+import { isQuoteOverdue } from "@/lib/quotes";
+import type { QuoteStatus } from "@/lib/types";
+
+// The page is public and found by an unguessable UUID, so it shows only the status, the company
+// name and the document link - never the email or the text of the request.
+export const metadata: Metadata = { title: "Статус кошторису · LeadDesk", robots: { index: false } };
+
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+const STATUS_VIEW: Record<QuoteStatus, { title: string; hint: string; tone: string }> = {
+  queued: {
+    title: "Запит прийнято",
+    hint: "Передаємо його в роботу.",
+    tone: "border-sky-200 bg-sky-50",
+  },
+  processing: {
+    title: "Готуємо кошторис",
+    hint: "Це займає від хвилини до півтори. Сторінку можна залишити відкритою — вона оновиться сама.",
+    tone: "border-amber-200 bg-amber-50",
+  },
+  completed: {
+    title: "Кошторис готовий",
+    hint: "PDF можна завантажити за посиланням нижче.",
+    tone: "border-emerald-200 bg-emerald-50",
+  },
+  failed: {
+    title: "Не вдалося підготувати кошторис",
+    hint: "Спробуйте надіслати запит ще раз. Якщо помилка повториться — назвіть нам номер запиту.",
+    tone: "border-red-200 bg-red-50",
+  },
+};
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  await connection(); // the status changes when n8n calls back: always render per request
+  const { id } = await params;
+  const quote = UUID_RE.test(id) ? await db.getQuote(id) : null;
+  if (!quote) notFound();
+
+  const view = STATUS_VIEW[quote.status];
+  const open = quote.status === "queued" || quote.status === "processing";
+  const documentUrl = quote.status === "completed" && isHttpsUrl(quote.documentUrl) ? quote.documentUrl : null;
+
+  return (
+    <main className="mx-auto w-full max-w-2xl flex-1 space-y-6 px-6 py-12">
+      <div>
+        <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+        <p className="mt-1 text-sm text-slate-500">Номер запиту: {quote.id}</p>
+      </div>
+
+      <section aria-live="polite" className={`space-y-2 rounded-lg border p-5 ${view.tone}`}>
+        <h2 className="font-medium">{view.title}</h2>
+        <p className="text-sm text-slate-700">{view.hint}</p>
+        {documentUrl && (
+          <a
+            href={documentUrl}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="inline-block rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
+          >
+            Завантажити PDF
+          </a>
+        )}
+        {isQuoteOverdue(quote) && (
+          <p className="text-sm text-amber-800">
+            Це триває довше, ніж зазвичай. Якщо результату немає, назвіть нам номер запиту.
+          </p>
+        )}
+      </section>
+
+      {quote.status === "failed" && (
+        <Link href="/quotes/new" className="inline-block text-sm text-indigo-600 hover:text-indigo-800">
+          Надіслати новий запит
+        </Link>
+      )}
+
+      {open && <QuoteStatusRefresh createdAt={quote.createdAt} />}
+    </main>
+  );
+}
