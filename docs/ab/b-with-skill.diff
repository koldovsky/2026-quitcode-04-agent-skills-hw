diff --git a/lib/n8n/client.ts b/lib/n8n/client.ts
new file mode 100644
index 0000000..23d908b
--- /dev/null
+++ b/lib/n8n/client.ts
@@ -0,0 +1,83 @@
+import "server-only";
+import { createHash, randomUUID } from "node:crypto";
+
+// The only place that talks to n8n (skill integrating-n8n-webhooks). Logs carry the event, status,
+// duration, attempt, correlation id, body length and a hash prefix - never bodies or secrets.
+
+const TIMEOUT_MS = 10_000;
+const RETRY_DELAYS_MS = [1_000, 3_000]; // at most 2 retries
+
+export type TriggerOptions = {
+  idempotencyKey: string; // UUID created once per business operation, stored with the record
+  correlationId?: string;
+  callbackUrl?: string; // async workflows only
+};
+
+export type TriggerResult =
+  | { ok: true; status: number; jobId: string | null }
+  | { ok: false; status: number | null; reason: "not-configured" | "rejected" | "unavailable" };
+
+export function n8nCallbackUrl(event: string): string | null {
+  const base = process.env.APP_BASE_URL;
+  return base ? `${base.replace(/\/+$/, "")}/api/n8n/${event}` : null;
+}
+
+const retryable = (status: number) => status >= 500; // 5xx incl. 524; never 4xx
+
+export async function triggerWorkflow(
+  event: string,
+  data: Record<string, unknown>,
+  options: TriggerOptions,
+): Promise<TriggerResult> {
+  const baseUrl = process.env.N8N_WEBHOOK_BASE_URL;
+  const token = process.env.N8N_WEBHOOK_TOKEN;
+  const correlationId = options.correlationId ?? randomUUID();
+  if (!baseUrl || !token) {
+    console.warn(`n8n -> ${event} skipped: N8N_WEBHOOK_BASE_URL or N8N_WEBHOOK_TOKEN is not set corr=${correlationId}`);
+    return { ok: false, status: null, reason: "not-configured" };
+  }
+
+  const url = `${baseUrl.replace(/\/+$/, "")}/${event}`;
+  const envelope = JSON.stringify({ version: 1, event, data, ...(options.callbackUrl ? { callbackUrl: options.callbackUrl } : {}) });
+  const size = `${Buffer.byteLength(envelope)} B sha256=${createHash("sha256").update(envelope).digest("hex").slice(0, 16)}`;
+  const tries = RETRY_DELAYS_MS.length + 1;
+  let lastStatus: number | null = null;
+
+  for (let attempt = 1; attempt <= tries; attempt++) {
+    const started = Date.now();
+    let outcome: string;
+    try {
+      const response = await fetch(url, {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+          "x-n8n-token": token,
+          "idempotency-key": options.idempotencyKey,
+          "x-correlation-id": correlationId,
+        },
+        body: envelope,
+        signal: AbortSignal.timeout(TIMEOUT_MS),
+      });
+      const answer = await response.text(); // only job_id is read, and only from a 202
+      lastStatus = response.status;
+      outcome = String(response.status);
+      console.info(`n8n -> ${event} ${outcome} in ${Date.now() - started} ms (try ${attempt}/${tries}) corr=${correlationId} ${size}`);
+      if (response.ok) return { ok: true, status: response.status, jobId: response.status === 202 ? readJobId(answer) : null };
+      if (!retryable(response.status)) return { ok: false, status: response.status, reason: "rejected" };
+    } catch (error) {
+      outcome = error instanceof Error && error.name === "TimeoutError" ? "timeout" : "network error";
+      console.warn(`n8n -> ${event} ${outcome} after ${Date.now() - started} ms (try ${attempt}/${tries}) corr=${correlationId}`);
+    }
+    if (attempt < tries) await new Promise((resolve) => setTimeout(resolve, RETRY_DELAYS_MS[attempt - 1]));
+  }
+  return { ok: false, status: lastStatus, reason: "unavailable" };
+}
+
+function readJobId(answer: string): string | null {
+  try {
+    const value = JSON.parse(answer) as { job_id?: unknown };
+    return typeof value.job_id === "string" ? value.job_id : null;
+  } catch {
+    return null;
+  }
+}
diff --git a/lib/n8n/envelope.ts b/lib/n8n/envelope.ts
new file mode 100644
index 0000000..3f9f5f5
--- /dev/null
+++ b/lib/n8n/envelope.ts
@@ -0,0 +1,92 @@
+import "server-only";
+
+// Shape of a callback from n8n (contract version 1). The route verifies the signature first and
+// only then calls parseCallbackEnvelope: signed data is authentic but still untrusted input.
+
+export type CallbackData = {
+  jobId: string;
+  correlationId: string | null;
+  requestIdempotencyKey: string;
+  completedAt: string | null;
+} & ({ status: "completed"; documentUrl: string } | { status: "failed"; errorCode: string });
+
+export type CallbackEnvelope = { version: 1; event: string; data: CallbackData };
+
+export type CallbackOutcome = { status: "applied"; afterResponse?: () => void | Promise<void> } | { status: "unknown-job" };
+
+export type CallbackHandler = (data: CallbackData) => Promise<CallbackOutcome>;
+
+const MAX_ID_LENGTH = 200;
+const MAX_URL_LENGTH = 2048;
+const ERROR_CODE_RE = /^[A-Za-z0-9_.-]{1,64}$/;
+
+export function isHttpsUrl(value: unknown): value is string {
+  if (typeof value !== "string" || value.length > MAX_URL_LENGTH) return false;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" && !url.username && !url.password;
+  } catch {
+    return false;
+  }
+}
+
+// Reads the body in chunks and gives up as soon as it exceeds the limit, so an oversized
+// request is never buffered whole. null = too large.
+export async function readBodyLimited(request: Request, maxBytes: number): Promise<Uint8Array | null> {
+  const declared = Number(request.headers.get("content-length"));
+  if (Number.isFinite(declared) && declared > maxBytes) return null;
+  if (!request.body) return new Uint8Array(0);
+
+  const reader = request.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    total += value.byteLength;
+    if (total > maxBytes) {
+      await reader.cancel();
+      return null;
+    }
+    chunks.push(value);
+  }
+  return Buffer.concat(chunks);
+}
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+
+const isId = (value: unknown): value is string =>
+  typeof value === "string" && value.length > 0 && value.length <= MAX_ID_LENGTH;
+
+// null = not the shape the contract describes (the route answers 400).
+export function parseCallbackEnvelope(rawBody: Uint8Array, expectedEvent: string): CallbackEnvelope | null {
+  let value: unknown;
+  try {
+    value = JSON.parse(new TextDecoder().decode(rawBody));
+  } catch {
+    return null;
+  }
+  if (!isRecord(value) || value.version !== 1 || value.event !== expectedEvent || !isRecord(value.data)) return null;
+
+  const data = value.data;
+  if (!isId(data.jobId) || !isId(data.requestIdempotencyKey)) return null;
+  const common = {
+    jobId: data.jobId,
+    requestIdempotencyKey: data.requestIdempotencyKey,
+    correlationId: typeof data.correlationId === "string" ? data.correlationId.slice(0, 64) : null,
+    completedAt: typeof data.completedAt === "string" ? data.completedAt.slice(0, 40) : null,
+  };
+
+  if (data.status === "completed") {
+    const documentUrl = isRecord(data.result) ? data.result.documentUrl : undefined;
+    if (!isHttpsUrl(documentUrl)) return null;
+    return { version: 1, event: value.event, data: { ...common, status: "completed", documentUrl } };
+  }
+  if (data.status === "failed") {
+    const code = isRecord(data.error) ? data.error.code : undefined;
+    const errorCode = typeof code === "string" && ERROR_CODE_RE.test(code) ? code : "workflow-failed";
+    return { version: 1, event: value.event, data: { ...common, status: "failed", errorCode } };
+  }
+  return null;
+}
diff --git a/lib/n8n/signature.ts b/lib/n8n/signature.ts
new file mode 100644
index 0000000..431edf7
--- /dev/null
+++ b/lib/n8n/signature.ts
@@ -0,0 +1,28 @@
+import "server-only";
+import { createHmac, timingSafeEqual } from "node:crypto";
+
+export const CALLBACK_WINDOW_SECONDS = 300;
+
+export type VerifyResult =
+  | { ok: true }
+  | { ok: false; reason: "no-secret" | "bad-timestamp" | "stale-timestamp" | "bad-signature" };
+
+// HMAC-SHA256(secret, "<timestamp>.<raw body>") over the exact bytes n8n sent. Nothing is parsed here.
+export function verifyN8nSignature(input: {
+  rawBody: Uint8Array;
+  timestamp: string | null;
+  signature: string | null;
+  secret: string | undefined;
+}): VerifyResult {
+  if (!input.secret) return { ok: false, reason: "no-secret" };
+  const ts = input.timestamp ?? "";
+  if (!/^\d{1,12}$/.test(ts)) return { ok: false, reason: "bad-timestamp" };
+  if (Math.abs(Math.floor(Date.now() / 1000) - Number(ts)) > CALLBACK_WINDOW_SECONDS) {
+    return { ok: false, reason: "stale-timestamp" };
+  }
+  const expected = createHmac("sha256", input.secret).update(`${ts}.`).update(input.rawBody).digest();
+  const hex = /^sha256=([0-9a-f]{64})$/i.exec(input.signature ?? "")?.[1];
+  const given = hex ? Buffer.from(hex, "hex") : Buffer.alloc(0);
+  if (given.length !== expected.length || !timingSafeEqual(given, expected)) return { ok: false, reason: "bad-signature" };
+  return { ok: true };
+}
diff --git a/lib/quote-form.ts b/lib/quote-form.ts
new file mode 100644
index 0000000..9053298
--- /dev/null
+++ b/lib/quote-form.ts
@@ -0,0 +1,52 @@
+export const MAX_BUDGET = 10_000_000;
+
+export type QuoteFormField = "company" | "email" | "description" | "budget";
+
+// What the visitor typed, kept as strings so an invalid form can be shown back unchanged.
+export type QuoteFormValues = Record<QuoteFormField, string>;
+
+export type QuoteFormData = {
+  company: string;
+  email: string;
+  description: string;
+  budget: number | null;
+};
+
+export type QuoteParseResult =
+  | { ok: true; data: QuoteFormData }
+  | { ok: false; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues };
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const CONTROL_CHARS_RE = /[\u0000-\u001f\u007f]/g;
+
+function text(formData: FormData, name: QuoteFormField, max: number, multiline = false) {
+  const value = formData.get(name);
+  if (typeof value !== "string") return "";
+  const clean = multiline ? value.replace(/[\u0000-\u0009\u000b\u000c\u000e-\u001f\u007f]/g, "") : value.replace(CONTROL_CHARS_RE, " ");
+  return clean.trim().slice(0, max);
+}
+
+export function parseQuoteForm(formData: FormData): QuoteParseResult {
+  const values: QuoteFormValues = {
+    company: text(formData, "company", 120),
+    email: text(formData, "email", 200).toLowerCase(),
+    description: text(formData, "description", 2000, true),
+    budget: text(formData, "budget", 12).replace(/\s+/g, ""),
+  };
+
+  const errors: Partial<Record<QuoteFormField, string>> = {};
+  if (!values.company) errors.company = "Вкажіть назву компанії";
+  if (!EMAIL_RE.test(values.email)) errors.email = "Перевірте email";
+  if (values.description.length < 10) errors.description = "Опишіть задачу хоча б одним реченням";
+
+  let budget: number | null = null;
+  if (values.budget) {
+    budget = /^\d{1,8}$/.test(values.budget) ? Number(values.budget) : NaN;
+    if (!(budget >= 1 && budget <= MAX_BUDGET)) {
+      errors.budget = `Вкажіть суму в доларах цілим числом (до ${MAX_BUDGET.toLocaleString("en-US")}) або залиште поле порожнім`;
+    }
+  }
+
+  if (Object.keys(errors).length > 0) return { ok: false, errors, values };
+  return { ok: true, data: { company: values.company, email: values.email, description: values.description, budget } };
+}
diff --git a/lib/quotes.ts b/lib/quotes.ts
new file mode 100644
index 0000000..6c32a05
--- /dev/null
+++ b/lib/quotes.ts
@@ -0,0 +1,62 @@
+import "server-only";
+import { db } from "@/lib/db";
+import { n8nCallbackUrl, triggerWorkflow } from "@/lib/n8n/client";
+import type { CallbackData, CallbackOutcome } from "@/lib/n8n/envelope";
+import type { NewQuote, Quote } from "@/lib/types";
+
+// Event name = webhook path in n8n = segment of the callback route (docs/n8n-integrations.md).
+export const QUOTE_EVENT = "quote-request";
+
+// The workflow takes 40-90 s; a quote still open after this long is shown as "taking longer than usual".
+const OVERDUE_AFTER_MS = 5 * 60 * 1000;
+
+export function createQuoteRequest(input: NewQuote) {
+  return db.insertQuote(input);
+}
+
+export function isQuoteOverdue(quote: Pick<Quote, "status" | "createdAt">) {
+  const open = quote.status === "queued" || quote.status === "processing";
+  return open && Date.now() - Date.parse(quote.createdAt) > OVERDUE_AFTER_MS;
+}
+
+// Runs in after(): the visitor already has the status page. The record is "queued" until n8n
+// accepts the job, then "processing" until the signed callback arrives.
+export async function startQuoteWorkflow(id: string) {
+  try {
+    const quote = await db.getQuote(id);
+    if (!quote || quote.status !== "queued") return;
+
+    const callbackUrl = n8nCallbackUrl(QUOTE_EVENT);
+    const result = callbackUrl
+      ? await triggerWorkflow(
+          QUOTE_EVENT,
+          { quoteId: quote.id, company: quote.company, email: quote.email, description: quote.description, budget: quote.budget },
+          { idempotencyKey: quote.id, correlationId: quote.correlationId, callbackUrl },
+        )
+      : ({ ok: false, status: null, reason: "not-configured" } as const);
+
+    if (result.ok) {
+      if (result.status !== 202) console.warn(`quote ${quote.id}: n8n answered ${result.status}, expected 202 - no callback will follow`);
+      await db.markQuoteProcessing(quote.id, result.jobId);
+    } else {
+      await db.failQuote(quote.id, `n8n-${result.reason}`);
+    }
+  } catch (error) {
+    console.error(`quote ${id}: starting the workflow failed: ${error instanceof Error ? error.name : "error"}`);
+    await db.failQuote(id, "internal-error").catch(() => undefined);
+  }
+}
+
+// Called by the callback route after the signature, the idempotency key and the shape are verified.
+// Short durable write only: it runs before the 2xx to n8n.
+export async function handleQuoteCallback(data: CallbackData): Promise<CallbackOutcome> {
+  const quote = await db.getQuote(data.requestIdempotencyKey);
+  if (!quote) return { status: "unknown-job" };
+
+  if (data.status === "completed") {
+    await db.completeQuote(quote.id, { jobId: data.jobId, documentUrl: data.documentUrl });
+  } else {
+    await db.failQuote(quote.id, data.errorCode, data.jobId);
+  }
+  return { status: "applied" };
+}
