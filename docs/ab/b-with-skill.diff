--- /dev/null
+++ b/components/quote-status-refresh.tsx
@@ -0,0 +1,27 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useEffect } from "react";
+
+const REFRESH_EVERY_MS = 4_000;
+const GIVE_UP_AFTER_MS = 15 * 60 * 1000;
+
+// Rendered only while the quote is queued or processing: re-runs the Server Component so the page
+// picks up the result of the n8n callback. Stops when the quote is old enough to be stuck.
+export function QuoteStatusRefresh({ createdAt }: { createdAt: string }) {
+  const router = useRouter();
+
+  useEffect(() => {
+    const started = Date.parse(createdAt);
+    const timer = setInterval(() => {
+      if (Date.now() - started > GIVE_UP_AFTER_MS) {
+        clearInterval(timer);
+      } else if (document.visibilityState === "visible") {
+        router.refresh();
+      }
+    }, REFRESH_EVERY_MS);
+    return () => clearInterval(timer);
+  }, [createdAt, router]);
+
+  return null;
+}
