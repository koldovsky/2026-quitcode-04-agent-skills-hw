+              вручну.
+            </p>
+          </section>
+        )}
+
+        {quote.status === "ready" && quote.documentUrl && (
+          <section className="space-y-3 rounded-lg border border-emerald-200 bg-emerald-50 p-5 text-sm text-emerald-900">
+            <p className="font-medium">Кошторис готовий</p>
