+++ b/components/quote-status-refresh.tsx
@@ -0,0 +1,17 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useEffect } from "react";
+
+// Rendered by the status page only while the quote is queued or processing: once the page
+// shows a final status this component is gone and the polling stops with it.
+export function QuoteStatusRefresh({ intervalMs = 3000 }: { intervalMs?: number }) {
+  const router = useRouter();
+
+  useEffect(() => {
+    const timer = setInterval(() => router.refresh(), intervalMs);
+    return () => clearInterval(timer);
+  }, [router, intervalMs]);
+
+  return null;
+}
