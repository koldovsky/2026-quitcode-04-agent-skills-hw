+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusRefresh } from "@/components/quote-status-refresh";
+import { getQuoteView } from "@/lib/quotes";
+import type { QuoteStatus } from "@/lib/types";
+
+// The address is the only key to this page: keep it out of search results.
+export const metadata: Metadata = {
+  title: "Статус кошторису · LeadDesk",
+  robots: { index: false, follow: false },
+};
+
+const STATUS_TEXT: Record<QuoteStatus, { title: string; hint: string }> = {
+  queued: { title: "У черзі", hint: "Запит прийнято, зараз передаємо його в роботу." },
+  processing: {
+    title: "Готуємо кошторис",
+    hint: "Зазвичай це займає від 40 секунд до півтори хвилини. Сторінка оновлюється сама.",
+  },
+  ready: { title: "Кошторис готовий", hint: "" },
+  failed: { title: "Не вдалося підготувати кошторис", hint: "Спробуйте ще раз або напишіть нам." },
+};
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await getQuoteView(id);
+  if (!quote) notFound();
+
+  const text = STATUS_TEXT[quote.status];
+  const waiting = quote.status === "queued" || quote.status === "processing";
+
+  return (
+    <main className="mx-auto w-full max-w-2xl flex-1 space-y-6 px-6 py-12">
+      <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+
+      <section aria-live="polite" className="space-y-3 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
+        <p className="text-lg font-medium">{text.title}</p>
+        {text.hint && <p className="text-sm text-slate-600">{text.hint}</p>}
+
+        {quote.status === "ready" &&
+          (quote.documentUrl ? (
+            <a
+              href={quote.documentUrl}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="inline-block rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
+            >
+              Відкрити PDF
+            </a>
+          ) : (
+            <p className="text-sm text-slate-600">Посилання на файл недоступне — напишіть нам, і ми надішлемо його.</p>
+          ))}
+
+        {quote.status === "failed" && (
+          <Link href="/quotes/new" className="inline-block text-sm text-indigo-600 hover:underline">
+            Надіслати новий запит
+          </Link>
+        )}
+      </section>
+
+      {waiting && <QuoteStatusRefresh />}
+    </main>
+  );
+}
