+"use client";
+
+import { useActionState, useEffect } from "react";
+import { useRouter } from "next/navigation";
+import { requestQuote, type RequestQuoteState } from "@/app/quotes/actions";
+import { QUOTE_BUDGET_OPTIONS } from "@/lib/quote-form";
+
+const initialState: RequestQuoteState = { status: "idle" };
+
+const inputClass =
+  "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500";
+
+export function QuoteForm() {
+  const router = useRouter();
+  const [state, formAction, pending] = useActionState(requestQuote, initialState);
+  const errors = state.status === "invalid" ? state.errors : {};
+  const values = state.status === "invalid" ? state.values : undefined;
+
+  useEffect(() => {
+    if (state.status === "ok") router.push(`/quotes/${state.id}`);
+  }, [state, router]);
+
+  if (state.status === "ok") {
+    return <p className="py-8 text-center text-sm text-slate-600">Запит прийнято, відкриваємо статус…</p>;
+  }
+
+  return (
+    // key remounts the fields with the submitted values after a failed validation
+    <form key={JSON.stringify(values)} action={formAction} className="space-y-4" noValidate>
+      <div className="grid gap-4 sm:grid-cols-2">
+        <label className="block text-sm font-medium">
+          Компанія
+          <input name="company" autoComplete="organization" defaultValue={values?.company} className={inputClass} />
+          {errors.company && <span className="mt-1 block text-xs text-red-600">{errors.company}</span>}
+        </label>
+        <label className="block text-sm font-medium">
+          Email
+          <input name="email" type="email" autoComplete="email" defaultValue={values?.email} className={inputClass} />
+          {errors.email && <span className="mt-1 block text-xs text-red-600">{errors.email}</span>}
+        </label>
+      </div>
+
+      <label className="block text-sm font-medium">
+        Опис задачі
+        <textarea name="description" rows={6} defaultValue={values?.description} className={inputClass} />
+        {errors.description && <span className="mt-1 block text-xs text-red-600">{errors.description}</span>}
+      </label>
+
+      <label className="block text-sm font-medium">
+        Бюджет
+        <select name="budget" defaultValue={values?.budget ?? ""} className={inputClass}>
+          {QUOTE_BUDGET_OPTIONS.map((option) => (
+            <option key={option.value} value={option.value}>
+              {option.label}
+            </option>
+          ))}
+        </select>
+        {errors.budget && <span className="mt-1 block text-xs text-red-600">{errors.budget}</span>}
+      </label>
+
+      <button
+        type="submit"
+        disabled={pending}
+        className="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60"
+      >
+        {pending ? "Надсилаємо…" : "Отримати кошторис"}
+      </button>
+    </form>
+  );
+}
diff --git a/docs/n8n-integrations.md b/docs/n8n-integrations.md
new file mode 100644
index 0000000..8924127
--- /dev/null
+++ b/docs/n8n-integrations.md
@@ -0,0 +1,22 @@
+# Інтеграції з n8n
+
+| event | напрям | шлях n8n | режим | власник |
+|---|---|---|---|---|
+| `quote-request` | Next.js → n8n → колбек `/api/n8n/quote-request` | `/webhook/quote-request` | Respond to Webhook 202 `{job_id}` + підписаний колбек | уточнити |
+| `lead-created` | Next.js → n8n | `/webhook-test/lead-created` (тестовий URL!) | Immediately | уточнити |
+
+`lead-created` поки не відповідає контракту (тестовий URL, повний запис ліда в тілі, без токена й
+ключів, `await` у Server Action) — потрібна окрема міграція.
+
+## Що має налаштувати власник воркфлоу `quote-request`
+
+- Webhook: `POST`, Path `quote-request`, Header Auth (`x-n8n-token`), Respond — «Using 'Respond to
+  Webhook' Node»; одразу за ним Remove Duplicates за `idempotency-key`, далі Respond to Webhook 202
+  `{"job_id": "{{ $execution.id }}"}`.
+- Вхідні дані — `body.data`: `quoteId`, `company`, `budget` (число або `null`), `description`.
+  Email клієнта не передаємо.
+- Після генерації PDF — підписаний колбек на `body.callbackUrl` (Raw JSON, `x-n8n-timestamp`,
+  `x-n8n-signature`, `idempotency-key` = `<jobId>:quote-request.completed`, `x-correlation-id`).
+  У `data`: `jobId`, `status`, `requestIdempotencyKey` (= вхідний `idempotency-key`),
+  `result.documentUrl` (http/https) або `error.code`.
+- Retry On Fail на вузлі колбека: 3 спроби, 1000 мс.
