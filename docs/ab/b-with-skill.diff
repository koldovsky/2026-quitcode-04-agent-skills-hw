new file mode 100644
index 0000000..ab6a932
--- /dev/null
+++ b/lib/quotes.ts
@@ -0,0 +1,83 @@
+import "server-only";
+import { randomUUID } from "node:crypto";
+import type { QuoteFormData } from "./quote-form";
+
+// In-memory stand-in for the quotes table. Quote requests are generated by the n8n workflow
+// `quote-request` (40–90 s); the result arrives via the signed callback /api/n8n/quote-request.
+
+export const QUOTE_STATUSES = ["queued", "processing", "completed", "failed"] as const;
+export type QuoteStatus = (typeof QUOTE_STATUSES)[number];
+
+export type Quote = QuoteFormData & {
+  id: string; // random UUID — the status page URL must not be guessable
+  status: QuoteStatus;
+  idempotencyKey: string; // sent to n8n on every attempt; the callback finds the quote by it
+  correlationId: string;
+  jobId: string | null;
+  documentUrl: string | null;
+  errorCode: string | null;
+  createdAt: string;
+  updatedAt: string;
+};
+
+const FINAL_STATUSES: readonly QuoteStatus[] = ["completed", "failed"];
+
+export function isFinalQuoteStatus(status: QuoteStatus) {
+  return FINAL_STATUSES.includes(status);
+}
+
+// One store per server process (also survives module reloads in `next dev`).
+const g = globalThis as unknown as { leadDeskQuotes?: Map<string, Quote> };
+const quotes = (g.leadDeskQuotes ??= new Map());
+
+export async function insertQuote(data: QuoteFormData): Promise<Quote> {
+  const now = new Date().toISOString();
+  const quote: Quote = {
+    ...data,
+    id: randomUUID(),
+    status: "queued",
+    idempotencyKey: randomUUID(),
+    correlationId: randomUUID(),
+    jobId: null,
+    documentUrl: null,
+    errorCode: null,
+    createdAt: now,
+    updatedAt: now,
+  };
+  quotes.set(quote.id, quote);
+  return structuredClone(quote);
+}
+
+export async function getQuote(id: string): Promise<Quote | null> {
+  const quote = quotes.get(id);
+  return quote ? structuredClone(quote) : null;
+}
+
+/** Result of the workflow trigger. Never overwrites a final status set by an early callback. */
+export async function markQuoteTriggered(id: string, ok: boolean) {
+  const quote = quotes.get(id);
+  if (!quote || quote.status !== "queued") return;
+  quote.status = ok ? "processing" : "failed";
+  if (!ok) quote.errorCode = "trigger_failed";
+  quote.updatedAt = new Date().toISOString();
+}
+
+export type QuoteResult = {
+  jobId: string;
+  requestIdempotencyKey: string;
+  status: "completed" | "failed";
+  documentUrl: string | null;
+  errorCode: string | null;
+};
+
+/** Saves the callback result. Returns false if no quote has this idempotency key. */
+export async function saveQuoteResult(result: QuoteResult) {
+  const quote = [...quotes.values()].find((q) => q.idempotencyKey === result.requestIdempotencyKey);
+  if (!quote) return false;
+  quote.status = result.status;
+  quote.jobId = result.jobId;
+  quote.documentUrl = result.status === "completed" ? result.documentUrl : null;
+  quote.errorCode = result.status === "failed" ? result.errorCode : null;
+  quote.updatedAt = new Date().toISOString();
+  return true;
+}
