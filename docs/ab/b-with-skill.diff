index 0000000..adc02e7
--- /dev/null
+++ b/lib/n8n/callback.ts
@@ -0,0 +1,88 @@
+import "server-only";
+import { createHmac, timingSafeEqual } from "node:crypto";
+
+export const MAX_CALLBACK_BYTES = 64 * 1024;
+const MAX_CLOCK_SKEW_S = 300;
+
+// Signature: "sha256=" + hex HMAC-SHA256(secret, `${timestamp}.${rawBody}`), checked on the RAW body.
+export function verifyCallbackSignature(
+  rawBody: string,
+  timestamp: string | null,
+  signature: string | null,
+  now = Date.now(),
+): boolean {
+  const secret = process.env.N8N_CALLBACK_SECRET;
+  if (!secret || !timestamp || !signature || !/^\d+$/.test(timestamp)) return false;
+  if (Math.abs(Math.floor(now / 1000) - Number(timestamp)) > MAX_CLOCK_SKEW_S) return false;
+
+  const expected = Buffer.from(`sha256=${createHmac("sha256", secret).update(`${timestamp}.${rawBody}`).digest("hex")}`);
+  const given = Buffer.from(signature);
+  // timingSafeEqual throws on different lengths, so compare lengths first. Never ===.
+  return given.length === expected.length && timingSafeEqual(given, expected);
+}
+
+// Demo store: a process-local Set on globalThis (Route Handlers and Server Actions are
+// separate bundles). In production this is a DB/KV row with a unique constraint.
+const globalForKeys = globalThis as unknown as { n8nCallbackKeys?: Set<string> };
+const claimedKeys = (globalForKeys.n8nCallbackKeys ??= new Set<string>());
+
+export function claimIdempotencyKey(key: string): boolean {
+  if (claimedKeys.has(key)) return false;
+  claimedKeys.add(key);
+  return true;
+}
+
+export function releaseIdempotencyKey(key: string) {
+  claimedKeys.delete(key);
+}
+
+export type CallbackPayload = {
+  event: string;
+  jobId: string;
+  status: "completed" | "failed";
+  requestIdempotencyKey: string | null;
+  documentUrl: string | null;
+};
+
+// The document link is rendered as <a href>: accept only http(s), never javascript: and friends.
+function httpUrlOrNull(value: unknown) {
+  if (typeof value !== "string") return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" || url.protocol === "http:" ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
+
+// Runs only AFTER the signature check. Returns null when the shape is wrong or the
+// unsigned idempotency-key header does not match the signed body.
+export function parseCallback(rawBody: string, pathEvent: string, idempotencyKey: string): CallbackPayload | null {
+  let body: unknown;
+  try {
+    body = JSON.parse(rawBody);
+  } catch {
+    return null;
+  }
+  if (typeof body !== "object" || body === null) return null;
+  const { version, event, data } = body as { version?: unknown; event?: unknown; data?: Record<string, unknown> };
+  if (version !== 1 || typeof event !== "string" || typeof data !== "object" || data === null) return null;
+  if (event !== `${pathEvent}.completed` && event !== `${pathEvent}.failed`) return null;
+
+  const { jobId, status, requestIdempotencyKey, result } = data as {
+    jobId?: unknown; status?: unknown; requestIdempotencyKey?: unknown; result?: { documentUrl?: unknown };
+  };
+  if (typeof jobId !== "string" || (status !== "completed" && status !== "failed")) return null;
+  if (idempotencyKey !== `${jobId}:${event}`) return null;
+
+  const documentUrl = status === "completed" ? httpUrlOrNull(result?.documentUrl) : null;
+  if (status === "completed" && !documentUrl) return null;
+
+  return {
+    event,
+    jobId,
+    status,
+    requestIdempotencyKey: typeof requestIdempotencyKey === "string" ? requestIdempotencyKey : null,
+    documentUrl,
+  };
+}
diff --git a/lib/n8n/client.ts b/lib/n8n/client.ts
new file mode 100644
index 0000000..5bb588c
--- /dev/null
+++ b/lib/n8n/client.ts
@@ -0,0 +1,84 @@
+import "server-only";
+import { createHash } from "node:crypto";
+
+// The only place that calls n8n. One event = one webhook path.
+export type N8nEvent = "quote-request";
+
+const TIMEOUT_MS = 10_000;
+const RETRY_DELAYS_MS = [1_000, 3_000]; // at most 3 attempts in total
+
+export type TriggerResult =
+  | { ok: true; status: number; jobId: string | null }
+  | { ok: false; status: number | null };
+
+function requireEnv(name: "N8N_WEBHOOK_BASE_URL" | "N8N_WEBHOOK_TOKEN" | "APP_BASE_URL") {
+  const value = process.env[name];
+  if (!value) throw new Error(`${name} is not set`);
+  return value.replace(/\/$/, "");
+}
+
+export function callbackUrlFor(event: N8nEvent) {
+  return `${requireEnv("APP_BASE_URL")}/api/n8n/${event}`;
+}
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+export async function triggerWorkflow(
+  event: N8nEvent,
+  data: Record<string, unknown>,
+  options: { idempotencyKey: string; correlationId: string; withCallback: boolean },
+): Promise<TriggerResult> {
+  const baseUrl = requireEnv("N8N_WEBHOOK_BASE_URL");
+  if (!baseUrl.endsWith("/webhook")) throw new Error("N8N_WEBHOOK_BASE_URL must end with /webhook");
+  const token = requireEnv("N8N_WEBHOOK_TOKEN");
+
+  const body = JSON.stringify({
+    version: 1,
+    event,
+    data,
+    ...(options.withCallback ? { callbackUrl: callbackUrlFor(event) } : {}),
+  });
+  const bodySha256 = createHash("sha256").update(body).digest("hex");
+
+  for (let attempt = 1; attempt <= RETRY_DELAYS_MS.length + 1; attempt++) {
+    const started = Date.now();
+    let status: number | null = null;
+    try {
+      const response = await fetch(`${baseUrl}/${event}`, {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+          "x-n8n-token": token,
+          "idempotency-key": options.idempotencyKey,
+          "x-correlation-id": options.correlationId,
+        },
+        body,
+        signal: AbortSignal.timeout(TIMEOUT_MS),
+      });
+      status = response.status;
+      logAttempt(event, options.correlationId, attempt, status, started, body, bodySha256);
+
+      if (response.ok) {
+        // Only the status matters; for 202 the Respond to Webhook node sends {"job_id": "..."}.
+        const json = status === 202 ? await response.json().catch(() => null) : null;
+        return { ok: true, status, jobId: typeof json?.job_id === "string" ? json.job_id : null };
+      }
+      // 4xx is a configuration error (403 token, 404 unpublished or test URL): never retried.
+      if (status < 500) return { ok: false, status };
+    } catch (error) {
+      // Network error or TimeoutError from AbortSignal.timeout: retried.
+      logAttempt(event, options.correlationId, attempt, error instanceof Error ? error.name : "Error", started, body, bodySha256);
+    }
+    if (attempt <= RETRY_DELAYS_MS.length) await sleep(RETRY_DELAYS_MS[attempt - 1]);
+    else return { ok: false, status };
+  }
+  return { ok: false, status: null };
+}
+
+// Never log the body, the token or personal data: event, correlation id, status, timing, size and hash only.
+function logAttempt(event: string, correlationId: string, attempt: number, outcome: number | string, started: number, body: string, bodySha256: string) {
+  console.info(
+    `n8n -> ${event} attempt=${attempt} outcome=${outcome} ms=${Date.now() - started} ` +
+      `correlation=${correlationId} bytes=${Buffer.byteLength(body)} sha256=${bodySha256}`,
+  );
+}
diff --git a/lib/quote-form.ts b/lib/quote-form.ts
new file mode 100644
index 0000000..b2f5221
--- /dev/null
+++ b/lib/quote-form.ts
@@ -0,0 +1,54 @@
+export const DESCRIPTION_MAX_LENGTH = 2000;
+export const BUDGET_MAX_USD = 1_000_000;
+
+export type QuoteFormField = "company" | "email" | "description" | "budget";
+
+export type QuoteFormData = {
+  company: string;
+  email: string;
+  description: string;
+  budget: number | null;
+};
+
+// What the user typed, sent back on errors so the form keeps it.
+export type QuoteFormValues = Record<QuoteFormField, string>;
+
+export type QuoteParseResult =
+  | { ok: true; data: QuoteFormData }
+  | { ok: false; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues };
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function text(formData: FormData, name: QuoteFormField, max: number) {
+  const value = formData.get(name);
+  // Browsers submit textarea line breaks as CRLF but count them as one character
+  // for maxLength, so normalize before cutting.
+  return typeof value === "string" ? value.replace(/\r\n?/g, "\n").trim().slice(0, max) : "";
+}
+
+export function parseQuoteForm(formData: FormData): QuoteParseResult {
+  const values: QuoteFormValues = {
+    company: text(formData, "company", 120),
+    email: text(formData, "email", 200).toLowerCase(),
+    description: text(formData, "description", DESCRIPTION_MAX_LENGTH),
+    budget: text(formData, "budget", 12).replace(/\s/g, ""),
+  };
+
+  const errors: Partial<Record<QuoteFormField, string>> = {};
+
+  if (!values.company) errors.company = "Вкажіть назву компанії";
+  if (!EMAIL_RE.test(values.email)) errors.email = "Перевірте email";
+  if (values.description.length < 10) errors.description = "Опишіть задачу хоча б одним реченням";
+
+  let budget: number | null = null;
+  if (values.budget) {
+    budget = /^\d+$/.test(values.budget) ? Number(values.budget) : NaN;
+    if (!(budget >= 1 && budget <= BUDGET_MAX_USD)) {
+      errors.budget = `Вкажіть суму цілим числом від 1 до ${BUDGET_MAX_USD.toLocaleString("uk-UA")}`;
+    }
+  }
+
+  return Object.keys(errors).length > 0
+    ? { ok: false, errors, values }
+    : { ok: true, data: { company: values.company, email: values.email, description: values.description, budget } };
+}
diff --git a/lib/quotes.ts b/lib/quotes.ts
new file mode 100644
index 0000000..bbdd2bc
--- /dev/null
+++ b/lib/quotes.ts
@@ -0,0 +1,79 @@
+import { randomUUID } from "node:crypto";
+import type { CallbackPayload } from "@/lib/n8n/callback";
+import type { TriggerResult } from "@/lib/n8n/client";
+import type { QuoteFormData } from "@/lib/quote-form";
+
+// queued: saved, n8n not called yet · processing: n8n accepted (202), waiting for the callback ·
+// ready: the PDF link arrived · failed: n8n rejected the request or reported a failure.
+export type QuoteStatus = "queued" | "processing" | "ready" | "failed";
+
+export type Quote = QuoteFormData & {
+  id: string;
+  status: QuoteStatus;
+  // Created once with the record and sent in every retry to n8n.
+  idempotencyKey: string;
+  correlationId: string;
+  jobId: string | null;
+  documentUrl: string | null;
+  createdAt: string;
+  updatedAt: string;
+};
+
+// The workflow takes 40–90 s. Past this the status page stops polling and says it is late.
+const OVERDUE_AFTER_MS = 5 * 60 * 1000;
+
+// Demo store on globalThis: Route Handlers and Server Actions are separate bundles, a
+// module-level Map would give each its own copy. In production: a table with a unique
+// idempotency_key.
+const globalForQuotes = globalThis as unknown as { leadDeskQuotes?: Map<string, Quote> };
+const quotes = (globalForQuotes.leadDeskQuotes ??= new Map<string, Quote>());
+
+export async function insertQuote(input: QuoteFormData) {
+  const now = new Date().toISOString();
+  const quote: Quote = {
+    ...input,
+    // Unguessable: the status page is public and opened by this id alone.
+    id: randomUUID(),
+    status: "queued",
+    idempotencyKey: randomUUID(),
+    correlationId: randomUUID(),
+    jobId: null,
+    documentUrl: null,
+    createdAt: now,
+    updatedAt: now,
+  };
+  quotes.set(quote.id, quote);
+  return structuredClone(quote);
+}
+
+export async function getQuote(id: string) {
+  const quote = quotes.get(id);
+  return quote ? structuredClone(quote) : null;
+}
+
+// The callback can arrive before this runs, so never move a quote back from a final status.
+export async function markQuoteTriggered(id: string, result: TriggerResult) {
+  const quote = quotes.get(id);
+  if (!quote) return;
+  if (result.ok && result.jobId && !quote.jobId) quote.jobId = result.jobId;
+  if (quote.status === "queued") quote.status = result.ok ? "processing" : "failed";
+  quote.updatedAt = new Date().toISOString();
+}
+
+export async function completeQuoteFromCallback(payload: CallbackPayload) {
+  const quote = [...quotes.values()].find(
+    (q) =>
+      (payload.requestIdempotencyKey !== null && q.idempotencyKey === payload.requestIdempotencyKey) ||
+      q.jobId === payload.jobId,
+  );
+  if (!quote) return false;
+  quote.jobId = payload.jobId;
+  quote.status = payload.status === "completed" ? "ready" : "failed";
+  quote.documentUrl = payload.documentUrl;
+  quote.updatedAt = new Date().toISOString();
+  return true;
+}
+
+export function isQuoteOverdue(quote: Quote, now = Date.now()) {
+  return (quote.status === "queued" || quote.status === "processing") && now - Date.parse(quote.createdAt) > OVERDUE_AFTER_MS;
+}
