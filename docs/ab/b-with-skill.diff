+++ b/lib/n8n/client.ts
@@ -0,0 +1,82 @@
+import "server-only";
+
+// Single door out to n8n. Direct fetch()es to n8n belong nowhere else — see
+// .claude/skills/integrating-n8n-webhooks/references/env-and-request.md.
+
+const REQUEST_TIMEOUT_MS = 10_000;
+const RETRY_DELAYS_MS = [1_000, 3_000];
+
+type SendEventInput = {
+  event: string;
+  data: Record<string, unknown>;
+  callbackUrl?: string;
+  idempotencyKey: string;
+  correlationId: string;
+};
+
+function sleep(ms: number) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function isRetryableStatus(status: number) {
+  return status >= 500 || status === 524;
+}
+
+/**
+ * Fires a workflow event at n8n. Never throws — a failed send is logged and
+ * left for the caller to notice (e.g. the quote page never leaves "queued").
+ * Runs from `after()`, so nothing downstream is waiting on this promise.
+ */
+export async function sendN8nEvent({ event, data, callbackUrl, idempotencyKey, correlationId }: SendEventInput) {
+  const baseUrl = process.env.N8N_WEBHOOK_BASE_URL;
+  const token = process.env.N8N_WEBHOOK_TOKEN;
+  if (!baseUrl || !token) {
+    console.error(`n8n:${event} not configured`, { correlationId });
+    return;
+  }
+
+  const body = JSON.stringify({
+    version: 1,
+    event,
+    data,
+    ...(callbackUrl ? { callbackUrl } : {}),
+  });
+
+  for (let attempt = 0; ; attempt++) {
+    let status: number | null = null;
+
+    try {
+      const response = await fetch(`${baseUrl}/${event}`, {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+          "x-n8n-token": token,
+          "idempotency-key": idempotencyKey,
+          "x-correlation-id": correlationId,
+        },
+        body,
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+      });
+      status = response.status;
+    } catch (error) {
+      console.error(`n8n:${event} request failed`, {
+        correlationId,
+        attempt,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+
+    if (status !== null && status >= 200 && status < 300) {
+      console.log(`n8n:${event} accepted`, { correlationId, attempt, status });
+      return;
+    }
+
+    const retryable = status === null || isRetryableStatus(status);
+    if (!retryable || attempt >= RETRY_DELAYS_MS.length) {
+      console.error(`n8n:${event} gave up`, { correlationId, attempt, status });
+      return;
+    }
+
+    await sleep(RETRY_DELAYS_MS[attempt]);
+  }
+}
diff --git a/lib/quote-form.ts b/lib/quote-form.ts
new file mode 100644
index 0000000..454251f
--- /dev/null
+++ b/lib/quote-form.ts
@@ -0,0 +1,49 @@
+import { BUDGET_OPTIONS } from "./lead-form";
+
+export { BUDGET_OPTIONS };
+
+export type QuoteFormField = "company" | "email" | "description" | "budget";
+
+export type QuoteFormData = {
+  company: string;
+  email: string;
+  description: string;
+  budget: number | null;
+};
+
+export type ParseResult =
+  | { ok: true; data: QuoteFormData }
+  | { ok: false; errors: Partial<Record<QuoteFormField, string>> };
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function text(formData: FormData, name: QuoteFormField, max = 200) {
+  const value = formData.get(name);
+  return typeof value === "string" ? value.trim().slice(0, max) : "";
+}
+
+export function parseQuoteForm(formData: FormData): ParseResult {
+  const data: QuoteFormData = {
+    company: text(formData, "company", 120),
+    email: text(formData, "email", 200).toLowerCase(),
+    description: text(formData, "description", 2000),
+    budget: null,
+  };
+
+  const errors: Partial<Record<QuoteFormField, string>> = {};
+
+  if (!data.company) errors.company = "Вкажіть назву компанії";
+  if (!EMAIL_RE.test(data.email)) errors.email = "Перевірте email";
+  if (data.description.length < 10) errors.description = "Опишіть задачу хоча б одним реченням";
+
+  const budget = text(formData, "budget", 10);
+  if (budget) {
+    if (!BUDGET_OPTIONS.some((option) => option.value === budget)) {
+      errors.budget = "Оберіть бюджет зі списку";
+    } else {
+      data.budget = Number(budget);
+    }
+  }
+
+  return Object.keys(errors).length > 0 ? { ok: false, errors } : { ok: true, data };
+}
