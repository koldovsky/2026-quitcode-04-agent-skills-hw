+            </a>
+          )}
+
+          {quote.status === "failed" && (
+            <p className="text-sm text-slate-600">
+              Не вдалося підготувати кошторис. Спробуйте надіслати запит ще раз або зв&apos;яжіться з нами.
+            </p>
+          )}
+        </div>
+      </main>
+    </div>
+  );
+}
