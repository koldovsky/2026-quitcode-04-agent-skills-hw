+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { getQuoteStatus, type QuoteStatus } from "@/lib/quotes";
+
+const STATUS_LABELS: Record<QuoteStatus, string> = {
+  queued: "У черзі",
+  processing: "Готуємо кошторис",
+  ready: "Готово",
+  failed: "Не вдалося підготувати",
+};
+
+const STATUS_STYLES: Record<QuoteStatus, string> = {
+  queued: "bg-slate-100 text-slate-600 ring-slate-200",
+  processing: "bg-amber-50 text-amber-700 ring-amber-200",
+  ready: "bg-emerald-50 text-emerald-700 ring-emerald-200",
+  failed: "bg-red-50 text-red-700 ring-red-200",
+};
+
+export default async function QuoteStatusPage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await getQuoteStatus(id);
+  if (!quote) notFound();
+
+  const pending = quote.status === "queued" || quote.status === "processing";
+
+  return (
+    <div className="flex flex-1 flex-col">
+      {pending && <meta httpEquiv="refresh" content="5" />}
+
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
+          <Link href="/" className="text-lg font-semibold tracking-tight">
+            Studio Nova
+          </Link>
+        </div>
+      </header>
+
+      <main className="mx-auto w-full max-w-2xl flex-1 px-6 py-12">
+        <div className="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
+          <div className="flex items-center justify-between gap-4">
+            <h1 className="text-xl font-semibold tracking-tight">Запит на кошторис</h1>
+            <span className={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${STATUS_STYLES[quote.status]}`}>
+              {STATUS_LABELS[quote.status]}
+            </span>
+          </div>
+          <p className="text-sm text-slate-500">{quote.id}</p>
+
+          {pending && (
+            <p className="text-sm text-slate-600">
+              Підготовка кошторису триває — зазвичай до кількох хвилин. Сторінка оновиться сама.
+            </p>
+          )}
+
+          {quote.status === "ready" && quote.documentUrl && (
+            <a
+              href={quote.documentUrl}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="inline-flex rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
+            >
