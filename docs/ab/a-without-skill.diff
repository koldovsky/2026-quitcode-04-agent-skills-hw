+export type QuoteStatus = (typeof QUOTE_STATUSES)[number];
+
+export type QuoteRequest = {
+  id: string;
+  company: string;
+  email: string;
+  description: string;
+  budget: number | null;
+  status: QuoteStatus;
+  pdfUrl: string | null;
+  error: string | null;
+  callbackToken: string;
+  createdAt: string;
+  updatedAt: string;
+};
+
+export type NewQuoteRequest = Pick<QuoteRequest, "company" | "email" | "description" | "budget">;
+
+export type QuoteResolution =
+  | { status: "ready"; pdfUrl: string }
+  | { status: "failed"; error: string };
+
+export type QuoteRequestPublic = Omit<QuoteRequest, "callbackToken">;
