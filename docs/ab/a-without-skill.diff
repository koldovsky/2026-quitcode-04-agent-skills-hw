+"use client";
+
+import { useEffect, useState } from "react";
+import type { QuoteRequest } from "@/lib/types";
+
+const POLL_INTERVAL_MS = 4000;
+
+type QuoteStatusPayload = Pick<QuoteRequest, "status" | "pdfUrl" | "error" | "updatedAt">;
+
+export function QuoteStatusView({ initial }: { initial: QuoteRequest }) {
+  const [quote, setQuote] = useState(initial);
+
+  useEffect(() => {
+    if (quote.status !== "pending") return;
+
+    let cancelled = false;
+    const interval = setInterval(async () => {
+      try {
+        const res = await fetch(`/api/quotes/${quote.id}`, { cache: "no-store" });
+        if (!res.ok || cancelled) return;
+        const data: QuoteStatusPayload = await res.json();
+        if (!cancelled) setQuote((prev) => ({ ...prev, ...data }));
+      } catch {
+        // Мережева помилка — спробуємо ще раз на наступному тику.
+      }
+    }, POLL_INTERVAL_MS);
+
+    return () => {
+      cancelled = true;
+      clearInterval(interval);
+    };
+  }, [quote.status, quote.id]);
+
+  if (quote.status === "pending") {
+    return (
+      <div className="flex items-center gap-3 rounded-lg border border-sky-200 bg-sky-50 p-5 text-sm text-sky-700">
+        <span
+          aria-hidden
+          className="h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-sky-300 border-t-sky-600"
+        />
+        <p>Готуємо кошторис… Зазвичай це займає 1–2 хвилини, сторінка оновиться автоматично.</p>
+      </div>
+    );
+  }
+
+  if (quote.status === "ready") {
+    return (
+      <div className="space-y-3 rounded-lg border border-emerald-200 bg-emerald-50 p-5 text-sm text-emerald-700">
+        <p className="font-medium">Кошторис готовий.</p>
+        {quote.pdfUrl && (
+          <a
+            href={quote.pdfUrl}
+            target="_blank"
+            rel="noreferrer"
+            className="inline-flex rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700"
+          >
+            Завантажити PDF
+          </a>
+        )}
+      </div>
+    );
+  }
+
+  return (
+    <div className="space-y-1 rounded-lg border border-red-200 bg-red-50 p-5 text-sm text-red-700">
+      <p className="font-medium">Не вдалося підготувати кошторис.</p>
+      {quote.error && <p>{quote.error}</p>}
+    </div>
+  );
+}
