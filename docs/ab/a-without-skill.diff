+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusRefresher } from "@/components/quote-status-refresher";
+import { db } from "@/lib/db";
+import type { QuoteRequest, QuoteStatus } from "@/lib/types";
+
+// The address is the only thing that protects a quote request, so keep it out of search.
+export const metadata: Metadata = {
+  title: "Статус кошторису — LeadDesk",
+  robots: { index: false, follow: false },
+};
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+const usd = new Intl.NumberFormat("uk-UA", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
+
+const SLOW_AFTER_MS = 3 * 60 * 1000;
+
+const STATUS_VIEW: Record<QuoteStatus, { label: string; panel: string }> = {
+  pending: { label: "Надсилаємо запит", panel: "border-slate-200 bg-slate-50 text-slate-700" },
+  processing: { label: "Готуємо кошторис", panel: "border-sky-200 bg-sky-50 text-sky-800" },
+  ready: { label: "Кошторис готовий", panel: "border-emerald-200 bg-emerald-50 text-emerald-800" },
+  failed: { label: "Не вдалося підготувати кошторис", panel: "border-red-200 bg-red-50 text-red-800" },
+};
+
+function isTakingLong(quote: QuoteRequest) {
+  return quote.status === "processing" && Date.now() - Date.parse(quote.createdAt) > SLOW_AFTER_MS;
+}
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await db.getQuoteRequest(id);
+  if (!quote) notFound();
+
+  const view = STATUS_VIEW[quote.status];
+  const inProgress = quote.status === "pending" || quote.status === "processing";
+
+  const details: Array<[string, string]> = [
+    ["Компанія", quote.company],
+    ["Бюджет", quote.budget === null ? "—" : usd.format(quote.budget)],
+    ["Створено", dateTimeFormat.format(new Date(quote.createdAt))],
+  ];
+
+  return (
+    <div className="space-y-6">
+      <div className="space-y-1">
+        <h1 className="text-3xl font-semibold tracking-tight">Запит на кошторис</h1>
+        <p className="text-sm text-slate-500">Збережіть цю адресу, щоб повернутися до результату пізніше.</p>
+      </div>
+
+      <section role="status" aria-live="polite" className={`space-y-2 rounded-lg border p-5 text-sm ${view.panel}`}>
+        <h2 className="text-base font-medium">{view.label}</h2>
+
+        {inProgress && (
+          <p>
+            Це займає від 40 секунд до півтори хвилини. Сторінка оновиться сама, коли кошторис буде готовий.
+          </p>
+        )}
+        {isTakingLong(quote) && <p>Це триває довше, ніж зазвичай. Можна повернутися до цієї сторінки пізніше.</p>}
+
+        {quote.status === "ready" && quote.documentUrl && (
+          <a
+            href={quote.documentUrl}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="inline-block rounded-md bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700"
+          >
+            Завантажити кошторис (PDF)
+          </a>
+        )}
+
+        {quote.status === "failed" && (
+          <p>
+            Спробуйте{" "}
+            <Link href="/quotes/new" className="font-medium underline">
+              надіслати запит ще раз
+            </Link>
+            .
+          </p>
+        )}
+      </section>
+
+      <dl className="grid grid-cols-1 gap-x-6 gap-y-3 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-3">
+        {details.map(([label, value]) => (
+          <div key={label}>
+            <dt className="text-slate-500">{label}</dt>
+            <dd className="font-medium break-words">{value}</dd>
+          </div>
+        ))}
+      </dl>
+
+      <section className="space-y-2 rounded-lg border border-slate-200 bg-white p-5 text-sm">
+        <h2 className="font-medium">Опис задачі</h2>
+        <p className="whitespace-pre-line break-words text-slate-700">{quote.description}</p>
+      </section>
+
+      {inProgress && <QuoteStatusRefresher />}
+    </div>
+  );
+}
