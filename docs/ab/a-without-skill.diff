--- /dev/null
+++ b/app/quotes/actions.ts
@@ -0,0 +1,70 @@
+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, quoteFormValues, type QuoteFormField, type QuoteFormValues } from "@/lib/quote-form";
+import type { Quote } from "@/lib/types";
+
+const PUBLIC_FORM_WORKSPACE_ID = "ws_studio_nova";
+
+// The n8n webhook must be set to "Respond: Immediately": the workflow itself runs 40–90 s and
+// reports back through /api/quotes/callback. We only wait for n8n to accept the job.
+const TRIGGER_TIMEOUT_MS = 10_000;
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues }
+  | { status: "error"; message: string; values: QuoteFormValues };
+
+async function triggerQuoteWorkflow(quote: Quote) {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appUrl = process.env.APP_URL;
+  if (!webhookUrl || !appUrl) {
+    throw new Error("N8N_QUOTE_WEBHOOK_URL and APP_URL must be set");
+  }
+
+  const response = await fetch(webhookUrl, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({
+      quoteId: quote.id,
+      company: quote.company,
+      email: quote.email,
+      description: quote.description,
+      budget: quote.budget,
+      // Built from config, never from the Host header: n8n sends the callback secret to this URL.
+      callbackUrl: new URL("/api/quotes/callback", appUrl).toString(),
+    }),
+    signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+  });
+  if (!response.ok) {
+    throw new Error(`n8n responded with ${response.status}`);
+  }
+}
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: quoteFormValues(formData) };
+  }
+
+  const quote = await db.insertQuote({ ...parsed.data, workspaceId: PUBLIC_FORM_WORKSPACE_ID });
+
+  try {
+    await triggerQuoteWorkflow(quote);
+  } catch (error) {
+    console.error(`Failed to start quote workflow for ${quote.id}`, error);
+    await db.completeQuote(quote.id, { status: "failed", error: "workflow trigger failed" });
+    return {
+      status: "error",
+      message: "Не вдалося запустити підготовку кошторису. Спробуйте ще раз за хвилину.",
+      values: quoteFormValues(formData),
+    };
+  }
+
+  // redirect() throws, so it stays outside the try block.
+  redirect(`/quotes/${quote.id}`);
+}
