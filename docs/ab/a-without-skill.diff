+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+
+const N8N_QUOTE_WEBHOOK_URL = process.env.N8N_QUOTE_WEBHOOK_URL;
+const APP_BASE_URL = process.env.APP_BASE_URL ?? "http://localhost:3000";
+const TRIGGER_TIMEOUT_MS = 10_000;
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors };
+  }
+
+  const quote = await db.insertQuoteRequest(parsed.data);
+
+  let triggerError: string | null = null;
+
+  if (!N8N_QUOTE_WEBHOOK_URL) {
+    console.error(`N8N_QUOTE_WEBHOOK_URL is not configured; quote ${quote.id} cannot start`);
+    triggerError = "Розрахунок кошторисів тимчасово недоступний. Спробуйте пізніше.";
+  } else {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), TRIGGER_TIMEOUT_MS);
+    try {
+      await fetch(N8N_QUOTE_WEBHOOK_URL, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        signal: controller.signal,
+        body: JSON.stringify({
+          quoteId: quote.id,
+          company: quote.company,
+          email: quote.email,
+          description: quote.description,
+          budget: quote.budget,
+          callbackUrl: `${APP_BASE_URL}/api/quotes/${quote.id}/callback`,
+          callbackToken: quote.callbackToken,
+        }),
+      });
+    } catch (error) {
+      console.error(`Failed to start quote workflow for ${quote.id}`, error);
+      triggerError = "Не вдалося запустити розрахунок кошторису. Спробуйте пізніше.";
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+
+  if (triggerError) {
+    await db.resolveQuoteRequest(quote.id, { status: "failed", error: triggerError });
+  }
+
+  redirect(`/quotes/${quote.id}`);
+}
