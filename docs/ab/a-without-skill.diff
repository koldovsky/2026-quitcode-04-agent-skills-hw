+"use client";
+
+import { useEffect } from "react";
+import { useRouter } from "next/navigation";
+
+// Re-renders the server page while n8n is still preparing the PDF. The page
+// stops rendering this component once the quote is ready, failed or overdue.
+export function QuoteStatusPoller({ intervalMs = 5000 }: { intervalMs?: number }) {
+  const router = useRouter();
+
+  useEffect(() => {
+    const timer = setInterval(() => router.refresh(), intervalMs);
+    return () => clearInterval(timer);
+  }, [router, intervalMs]);
+
+  return null;
+}
