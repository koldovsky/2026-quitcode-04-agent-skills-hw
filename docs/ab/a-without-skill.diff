+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { connection } from "next/server";
+import { QuoteStatusRefresher } from "@/components/quote-status-refresher";
+import { db } from "@/lib/db";
+import { isQuoteStale } from "@/lib/quote-workflow";
+import type { QuoteStatus } from "@/lib/types";
+
+// The URL is the only key to this page: keep it out of search engines.
+export const metadata: Metadata = { title: "Кошторис", robots: { index: false, follow: false } };
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+const STATUS_LABELS: Record<QuoteStatus, { label: string; className: string }> = {
+  queued: { label: "У черзі", className: "bg-slate-100 text-slate-700" },
+  processing: { label: "Готуємо", className: "bg-amber-100 text-amber-800" },
+  ready: { label: "Готово", className: "bg-emerald-100 text-emerald-800" },
+  failed: { label: "Помилка", className: "bg-red-100 text-red-800" },
+};
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  await connection();
+  const { id } = await params;
+  const quote = await db.getQuote(id);
+  if (!quote) notFound();
+
+  const inProgress = quote.status === "queued" || quote.status === "processing";
+  const stale = isQuoteStale(quote);
+  const badge = STATUS_LABELS[quote.status];
+
+  return (
+    <main className="mx-auto w-full max-w-2xl flex-1 space-y-6 px-6 py-12">
+      {inProgress && !stale && <QuoteStatusRefresher />}
+
+      <div className="flex items-start justify-between gap-4">
+        <div className="space-y-1">
+          <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+          <p className="text-sm text-slate-500">
+            Запит від {dateTimeFormat.format(new Date(quote.createdAt))}
+          </p>
+        </div>
+        <span className={`rounded-full px-3 py-1 text-sm font-medium ${badge.className}`}>
+          {badge.label}
+        </span>
+      </div>
+
+      <section className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" aria-live="polite">
+        {inProgress && !stale && (
+          <div className="space-y-2">
+            <p className="font-medium">Готуємо ваш кошторис…</p>
+            <p className="text-sm text-slate-600">
+              Зазвичай це займає одну-дві хвилини. Сторінка оновиться сама — її можна залишити
+              відкритою або повернутися за цим посиланням пізніше.
+            </p>
+          </div>
+        )}
+
+        {stale && (
+          <div className="space-y-2">
+            <p className="font-medium">Кошторис готується довше, ніж зазвичай</p>
+            <p className="text-sm text-slate-600">
+              Оновіть сторінку трохи пізніше. Якщо статус не зміниться — напишіть нам, і ми
+              надішлемо кошторис вручну.
+            </p>
+          </div>
+        )}
+
+        {quote.status === "ready" && quote.pdfUrl && (
+          <div className="space-y-4">
+            <p className="font-medium">Кошторис готовий.</p>
+            <a
+              href={quote.pdfUrl}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="inline-block rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
+            >
+              Завантажити PDF
+            </a>
+          </div>
+        )}
+
+        {quote.status === "failed" && (
+          <div className="space-y-2">
+            <p className="font-medium text-red-700">Не вдалося підготувати кошторис</p>
+            <p className="text-sm text-slate-600">{quote.error}</p>
+            <Link href="/quotes/new" className="inline-block text-sm text-indigo-600 hover:underline">
+              Надіслати запит ще раз
+            </Link>
+          </div>
+        )}
+      </section>
+    </main>
+  );
+}
