+"use client";
+
+import { useEffect, useState } from "react";
+import type { QuoteRequestPublic } from "@/lib/types";
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+const POLL_MS = 4000;
+
+export function QuoteStatusView({ initialQuote }: { initialQuote: QuoteRequestPublic }) {
+  const [quote, setQuote] = useState(initialQuote);
+
+  useEffect(() => {
+    if (quote.status !== "pending") return;
+
+    let cancelled = false;
+    const interval = setInterval(async () => {
+      try {
+        const res = await fetch(`/api/quotes/${quote.id}`, { cache: "no-store" });
+        if (!res.ok) return;
+        const data: { quote: QuoteRequestPublic } = await res.json();
+        if (!cancelled) setQuote(data.quote);
+      } catch {
+        // тимчасова помилка мережі — спробуємо ще раз на наступному тіку
+      }
+    }, POLL_MS);
+
+    return () => {
+      cancelled = true;
+      clearInterval(interval);
+    };
+  }, [quote.status, quote.id]);
+
+  return (
+    <div className="space-y-4">
+      <div>
+        <h1 className="text-2xl font-semibold tracking-tight">Запит на кошторис</h1>
+        <p className="text-sm text-slate-500">
+          {quote.id} · {quote.company}
+        </p>
+      </div>
+
+      {quote.status === "pending" && (
+        <div className="rounded-lg border border-slate-200 bg-white p-5 text-sm">
+          <p className="font-medium">Готуємо кошторис…</p>
+          <p className="mt-1 text-slate-600">
+            Зазвичай це займає 40–90 секунд. Сторінка оновиться автоматично.
+          </p>
+        </div>
+      )}
+
+      {quote.status === "ready" && quote.pdfUrl && (
+        <div className="rounded-lg border border-emerald-200 bg-emerald-50 p-5 text-sm">
+          <p className="font-medium text-emerald-800">Кошторис готовий</p>
+          <a
+            href={quote.pdfUrl}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="mt-3 inline-block rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
+          >
+            Завантажити PDF
+          </a>
+        </div>
+      )}
+
+      {quote.status === "failed" && (
+        <div className="rounded-lg border border-red-200 bg-red-50 p-5 text-sm">
+          <p className="font-medium text-red-800">Не вдалося підготувати кошторис</p>
+          <p className="mt-1 text-red-700">{quote.error ?? "Спробуйте, будь ласка, ще раз."}</p>
+        </div>
+      )}
+
+      <dl className="grid grid-cols-1 gap-x-6 gap-y-3 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2">
+        <div>
+          <dt className="text-slate-500">Email</dt>
+          <dd className="font-medium break-words">{quote.email}</dd>
+        </div>
+        <div>
+          <dt className="text-slate-500">Бюджет</dt>
+          <dd className="font-medium">{quote.budget === null ? "—" : `$${quote.budget} / міс.`}</dd>
+        </div>
+        <div className="sm:col-span-2">
+          <dt className="text-slate-500">Опис задачі</dt>
+          <dd className="whitespace-pre-line font-medium">{quote.description}</dd>
+        </div>
+        <div>
+          <dt className="text-slate-500">Створено</dt>
+          <dd className="font-medium">{dateTimeFormat.format(new Date(quote.createdAt))}</dd>
+        </div>
+      </dl>
+    </div>
+  );
+}
