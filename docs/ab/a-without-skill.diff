+import type { NextRequest } from "next/server";
+import { after } from "next/server";
+import { logAudit } from "@/lib/audit";
+import { db } from "@/lib/db";
+import { isAuthorizedCallback } from "@/lib/quote-workflow";
+import type { QuoteResult } from "@/lib/types";
+
+// Called by the n8n `quote-request` workflow when the PDF is ready (or the
+// workflow gave up):
+//
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <N8N_CALLBACK_SECRET>
+//   { "status": "ready", "pdfUrl": "https://…/quote.pdf" }
+//   { "status": "failed", "error": "…" }
+//
+// Safe to retry: a quote that is already ready is left unchanged.
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  if (!isAuthorizedCallback(request.headers.get("authorization"))) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const { id } = await ctx.params;
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "invalid JSON body" }, { status: 400 });
+  }
+
+  const result = parseQuoteResult(body);
+  if (!result) {
+    return Response.json(
+      { error: 'expected { "status": "ready", "pdfUrl": "https://…" } or { "status": "failed", "error": "…" }' },
+      { status: 400 },
+    );
+  }
+
+  const outcome = await db.completeQuote(id, result);
+  if (outcome === "not_found") {
+    return Response.json({ error: "quote not found" }, { status: 404 });
+  }
+
+  if (outcome === "updated") {
+    after(() => logAudit(result.status === "ready" ? "quote.ready" : "quote.failed", id));
+  }
+
+  return Response.json({ ok: true, outcome });
+}
+
+function parseQuoteResult(body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready") {
+    // The URL is rendered as a link for the client: allow only http(s), never
+    // javascript: or data: URLs.
+    if (typeof pdfUrl !== "string" || pdfUrl.length > 2000) return null;
+    let url: URL;
+    try {
+      url = new URL(pdfUrl);
+    } catch {
+      return null;
+    }
+    if (url.protocol !== "https:" && url.protocol !== "http:") return null;
+    return { status: "ready", pdfUrl: url.toString() };
+  }
+
+  if (status === "failed") {
+    return { status: "failed", error: typeof error === "string" && error ? error.slice(0, 500) : "unknown" };
+  }
+
+  return null;
+}
