@@ -0,0 +1,44 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useRouter } from "next/navigation";
+
+const REFRESH_EVERY_MS = 4000;
+// The workflow takes 40–90 s; past this point something has most likely gone wrong in n8n.
+const SLOW_AFTER_MS = 3 * 60 * 1000;
+
+function formatElapsed(ms: number) {
+  const seconds = Math.floor(ms / 1000);
+  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
+}
+
+// Rendered only while the quote is processing: re-renders the page from the server until the
+// status changes, which unmounts this component and stops the polling.
+export function QuoteProgress({ createdAt }: { createdAt: string }) {
+  const router = useRouter();
+  const [elapsedMs, setElapsedMs] = useState<number | null>(null);
+
+  useEffect(() => {
+    const startedAt = Date.parse(createdAt);
+    const clock = setInterval(() => setElapsedMs(Math.max(0, Date.now() - startedAt)), 1000);
+    const refresh = setInterval(() => router.refresh(), REFRESH_EVERY_MS);
+    return () => {
+      clearInterval(clock);
+      clearInterval(refresh);
+    };
+  }, [createdAt, router]);
+
+  if (elapsedMs === null) return null;
+
+  return (
+    <div className="space-y-2 text-sm">
+      <p className="tabular-nums text-slate-500">Минуло {formatElapsed(elapsedMs)}</p>
+      {elapsedMs > SLOW_AFTER_MS && (
+        <p className="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-amber-800">
+          Це триває довше, ніж зазвичай. Сторінка й далі оновлюється сама, або відкрийте це посилання
+          пізніше.
+        </p>
+      )}
+    </div>
+  );
+}
