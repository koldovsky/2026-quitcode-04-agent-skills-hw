@@ -0,0 +1,59 @@
+import { createHash, timingSafeEqual } from "node:crypto";
+import type { Quote } from "./types";
+
+// The n8n `quote-request` workflow runs for 40–90 s, far longer than a form
+// submit should wait. Its Webhook node must answer immediately ("Respond:
+// Immediately"); the finished PDF arrives later through the callback route.
+const TRIGGER_TIMEOUT_MS = 10_000;
+
+// After this the status page stops polling and tells the client we are late.
+export const QUOTE_OVERDUE_MS = 5 * 60 * 1000;
+
+export function isQuoteOverdue(quote: Quote, now = Date.now()) {
+  return quote.status === "pending" && now - Date.parse(quote.createdAt) > QUOTE_OVERDUE_MS;
+}
+
+function callbackUrl(quoteId: string) {
+  // Never built from the request's Host header: n8n sends the shared secret to
+  // this URL, so a spoofed Host would leak it.
+  const base = process.env.APP_URL ?? "http://localhost:3000";
+  return new URL(`/api/quotes/${encodeURIComponent(quoteId)}/callback`, base).toString();
+}
+
+export async function triggerQuoteWorkflow(quote: Quote): Promise<{ ok: true } | { ok: false; error: string }> {
+  const url = process.env.N8N_QUOTE_WEBHOOK_URL;
+  if (!url) return { ok: false, error: "N8N_QUOTE_WEBHOOK_URL is not set" };
+
+  try {
+    const response = await fetch(url, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl: callbackUrl(quote.id),
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    if (!response.ok) return { ok: false, error: `n8n responded with HTTP ${response.status}` };
+    return { ok: true };
+  } catch (error) {
+    return { ok: false, error: error instanceof Error ? error.message : String(error) };
+  }
+}
+
+function digest(value: string) {
+  return createHash("sha256").update(value).digest();
+}
+
+// n8n's HTTP Request node sends `Authorization: Bearer <N8N_CALLBACK_SECRET>`.
+// Fails closed when the secret is not configured.
+export function isAuthorizedCallback(authorization: string | null) {
+  const secret = process.env.N8N_CALLBACK_SECRET;
+  if (!secret || !authorization?.startsWith("Bearer ")) return false;
+  // Hashing first gives equal-length buffers, which timingSafeEqual requires.
+  return timingSafeEqual(digest(authorization.slice("Bearer ".length)), digest(secret));
+}
