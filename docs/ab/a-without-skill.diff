@@ -0,0 +1,73 @@
+import { createHash, timingSafeEqual } from "node:crypto";
+import type { NextRequest } from "next/server";
+import { db } from "@/lib/db";
+import type { QuoteOutcome } from "@/lib/types";
+
+// Called by the n8n `quote-request` workflow when it finishes. n8n has no session cookie,
+// so the request is authenticated with a shared secret instead:
+//
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <N8N_QUOTE_CALLBACK_SECRET>
+//   { "status": "ready", "pdfUrl": "https://..." }   or   { "status": "failed", "error": "..." }
+//
+// Safe to retry: repeating an outcome is a no-op and a `ready` quote is never overwritten.
+
+function hasValidSecret(request: NextRequest, secret: string) {
+  const header = request.headers.get("authorization") ?? "";
+  const token = header.startsWith("Bearer ") ? header.slice("Bearer ".length) : "";
+  // Hash both sides so timingSafeEqual gets equal-length input and the secret's length does not leak.
+  const digest = (value: string) => createHash("sha256").update(value).digest();
+  return timingSafeEqual(digest(token), digest(secret));
+}
+
+// The PDF link is rendered as an href on a public page, so accept web URLs only (no javascript:, data:, ...).
+function parsePdfUrl(value: unknown) {
+  if (typeof value !== "string" || value.length > 2000) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" || url.protocol === "http:" ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const secret = process.env.N8N_QUOTE_CALLBACK_SECRET;
+  if (!secret) {
+    console.error("N8N_QUOTE_CALLBACK_SECRET is not set: quote callbacks are refused");
+    return Response.json({ error: "callback is not configured" }, { status: 503 });
+  }
+  if (!hasValidSecret(request, secret)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const { id } = await ctx.params;
+  const body: unknown = await request.json().catch(() => null);
+  const payload = typeof body === "object" && body !== null ? (body as Record<string, unknown>) : {};
+
+  let outcome: QuoteOutcome;
+  if (payload.status === "ready") {
+    const pdfUrl = parsePdfUrl(payload.pdfUrl);
+    if (!pdfUrl) {
+      return Response.json({ error: "pdfUrl must be an http(s) URL" }, { status: 400 });
+    }
+    outcome = { status: "ready", pdfUrl };
+  } else if (payload.status === "failed") {
+    outcome = { status: "failed" };
+  } else {
+    return Response.json({ error: 'status must be "ready" or "failed"' }, { status: 400 });
+  }
+
+  const quote = await db.settleQuote(id, outcome);
+  if (!quote) {
+    return Response.json({ error: "quote not found" }, { status: 404 });
+  }
+
+  if (outcome.status === "failed") {
+    // n8n's error text may hold internal details: it goes to the log, never to the public status page.
+    const detail = typeof payload.error === "string" ? `: ${JSON.stringify(payload.error.slice(0, 300))}` : "";
+    console.error(`Quote ${id}: the n8n workflow reported a failure${detail}`);
+  }
+
+  return Response.json({ ok: true, status: quote.status });
+}
