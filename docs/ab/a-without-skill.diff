@@ -0,0 +1,102 @@
+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import type { QuoteRequest, QuoteResult, QuoteStatus } from "./types";
+
+// Integration with the client's n8n "quote-request" workflow. It needs 40–90 s
+// to build the PDF, so it runs in two steps: startQuoteWorkflow only hands the
+// job over, and n8n reports the result to /api/quotes/[id]/callback.
+
+const START_TIMEOUT_MS = 10_000;
+
+// Well past the 90 s the workflow needs: if n8n has not reported back by now,
+// the run died on its side and the status page stops waiting.
+const RESULT_TIMEOUT_MS = 5 * 60 * 1000;
+
+function hashToken(token: string) {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+// A fresh token per request: n8n gets the token, the database keeps only its hash.
+export function createCallbackToken() {
+  const token = randomBytes(32).toString("base64url");
+  return { token, hash: hashToken(token) };
+}
+
+export function verifyCallbackToken(authorization: string | null, expectedHash: string) {
+  const token = authorization?.match(/^Bearer (\S+)$/)?.[1];
+  if (!token) return false;
+  const actual = Buffer.from(hashToken(token), "hex");
+  const expected = Buffer.from(expectedHash, "hex");
+  return actual.length === expected.length && timingSafeEqual(actual, expected);
+}
+
+export async function startQuoteWorkflow(quote: QuoteRequest, callbackToken: string) {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appBaseUrl = process.env.APP_BASE_URL;
+  if (!webhookUrl || !appBaseUrl) {
+    console.error("quote.workflow_start failed: set N8N_QUOTE_WEBHOOK_URL and APP_BASE_URL");
+    return false;
+  }
+
+  try {
+    // The workflow's Webhook node must respond immediately. If it answered only
+    // when the PDF is done, this request would hit the timeout every time.
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callback: {
+          url: new URL(`/api/quotes/${quote.id}/callback`, appBaseUrl).href,
+          token: callbackToken,
+        },
+      }),
+      signal: AbortSignal.timeout(START_TIMEOUT_MS),
+    });
+    if (!response.ok) {
+      console.error(`quote.workflow_start failed for ${quote.id}: n8n responded ${response.status}`);
+      return false;
+    }
+    return true;
+  } catch (error) {
+    console.error(`quote.workflow_start failed for ${quote.id}: ${error instanceof Error ? error.name : "UnknownError"}`);
+    return false;
+  }
+}
+
+// The link ends up in an <a href> on a public page: accept web links only, never
+// javascript:, data: or file: URLs.
+function parsePdfUrl(value: unknown) {
+  if (typeof value !== "string" || value.length > 2000) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" || url.protocol === "http:" ? url.href : null;
+  } catch {
+    return null;
+  }
+}
+
+// Expected body: { "status": "ready", "pdfUrl": "https://…" } or { "status": "failed" }.
+export function parseQuoteCallback(body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl } = body as Record<string, unknown>;
+
+  if (status === "failed") return { status: "failed" };
+  if (status === "ready") {
+    const url = parsePdfUrl(pdfUrl);
+    return url ? { status: "ready", pdfUrl: url } : null;
+  }
+  return null;
+}
+
+// What the client sees. A late callback can still finish the request, because
+// the stored status stays "pending".
+export function quoteDisplayStatus(quote: Pick<QuoteRequest, "status" | "createdAt">): QuoteStatus {
+  if (quote.status === "pending" && Date.now() - Date.parse(quote.createdAt) > RESULT_TIMEOUT_MS) {
+    return "failed";
+  }
+  return quote.status;
+}
