@@ -0,0 +1,55 @@
+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import {
+  parseQuoteForm,
+  readQuoteValues,
+  type QuoteField,
+  type QuoteFormValues,
+} from "@/lib/quote-form";
+import { createCallbackToken, hashCallbackToken, startQuoteWorkflow } from "@/lib/quotes";
+
+const PUBLIC_FORM_WORKSPACE_ID = "ws_studio_nova";
+const START_FAILED_MESSAGE = "Не вдалося запустити підготовку кошторису. Спробуйте ще раз за кілька хвилин.";
+
+export type QuoteFormState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteField, string>>; values: QuoteFormValues }
+  | { status: "error"; message: string; values: QuoteFormValues };
+
+export async function requestQuote(
+  _prevState: QuoteFormState,
+  formData: FormData,
+): Promise<QuoteFormState> {
+  // Any error keeps what the user typed: React 19 resets the form after every action.
+  const values = readQuoteValues(formData);
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: parsed.values };
+  }
+
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appUrl = process.env.APP_URL;
+  if (!webhookUrl || !appUrl) {
+    console.error("quote.request misconfigured: N8N_QUOTE_WEBHOOK_URL or APP_URL is not set");
+    return { status: "error", message: START_FAILED_MESSAGE, values };
+  }
+
+  const callbackToken = createCallbackToken();
+  const quote = await db.insertQuote({
+    ...parsed.data,
+    workspaceId: PUBLIC_FORM_WORKSPACE_ID,
+    callbackTokenHash: hashCallbackToken(callbackToken),
+  });
+
+  // Waits only for n8n to accept the request; the PDF arrives later via the callback route.
+  const start = await startQuoteWorkflow(quote, callbackToken, { webhookUrl, appUrl });
+  if (start === "failed") {
+    await db.finishQuote(quote.id, { status: "failed", failureReason: "workflow did not start" });
+    return { status: "error", message: START_FAILED_MESSAGE, values };
+  }
+
+  // Outside any try/catch: redirect() works by throwing.
+  redirect(`/quotes/${quote.id}`);
+}
