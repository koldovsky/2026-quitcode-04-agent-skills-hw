@@ -0,0 +1,42 @@
+import { db } from "@/lib/db";
+
+type CallbackPayload = {
+  status?: string;
+  pdfUrl?: string;
+  error?: string;
+};
+
+export async function POST(request: Request, { params }: RouteContext<"/api/quotes/[id]/callback">) {
+  const expectedSecret = process.env.N8N_QUOTE_CALLBACK_SECRET;
+  if (expectedSecret && request.headers.get("x-n8n-secret") !== expectedSecret) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const { id } = await params;
+  const quote = await db.getQuote(id);
+  if (!quote) {
+    return Response.json({ error: "not found" }, { status: 404 });
+  }
+
+  let payload: CallbackPayload;
+  try {
+    payload = await request.json();
+  } catch {
+    return Response.json({ error: "invalid json body" }, { status: 400 });
+  }
+
+  if (payload.status === "ready") {
+    if (typeof payload.pdfUrl !== "string" || !payload.pdfUrl) {
+      return Response.json({ error: "pdfUrl is required when status is 'ready'" }, { status: 400 });
+    }
+    await db.updateQuoteStatus(id, "ready", { pdfUrl: payload.pdfUrl });
+  } else if (payload.status === "failed") {
+    await db.updateQuoteStatus(id, "failed", {
+      errorMessage: typeof payload.error === "string" ? payload.error.slice(0, 500) : "Помилка формування кошторису",
+    });
+  } else {
+    return Response.json({ error: "status must be 'ready' or 'failed'" }, { status: 400 });
+  }
+
+  return Response.json({ ok: true });
+}
