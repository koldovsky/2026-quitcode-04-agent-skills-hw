+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusPoller } from "@/components/quote-status-poller";
+import { db } from "@/lib/db";
+import { QUOTE_BUDGET_OPTIONS } from "@/lib/quote-form";
+import { isQuoteOverdue, quoteDeadline } from "@/lib/quotes";
+
+// Anyone with the link can open this page, so keep it out of search engines.
+export const metadata: Metadata = {
+  title: "Кошторис — Studio Nova",
+  robots: { index: false, follow: false },
+};
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await db.getQuote(id);
+  if (!quote) notFound();
+
+  const overdue = isQuoteOverdue(quote);
+  const budgetLabel = QUOTE_BUDGET_OPTIONS.find((option) => option.value === String(quote.budget ?? ""))?.label;
+
+  return (
+    <main className="mx-auto w-full max-w-2xl flex-1 space-y-6 px-6 py-12">
+      <Link href="/" className="text-sm text-slate-500 hover:text-slate-900">
+        ← Studio Nova
+      </Link>
+
+      <div>
+        <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+        <p className="text-sm text-slate-500">Запит від {dateTimeFormat.format(new Date(quote.createdAt))}</p>
+      </div>
+
+      <section aria-live="polite" className="rounded-lg border border-slate-200 bg-white p-5 text-sm">
+        {quote.status === "ready" && quote.pdfUrl ? (
+          <div className="space-y-3">
+            <p className="font-medium text-emerald-700">Кошторис готовий.</p>
+            <a
+              href={quote.pdfUrl}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="inline-flex rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700"
+            >
+              Завантажити PDF
+            </a>
+          </div>
+        ) : quote.status === "failed" ? (
+          <div className="space-y-2">
+            <p className="font-medium text-red-700">Не вдалося підготувати кошторис автоматично.</p>
+            <p className="text-slate-600">
+              <Link href="/quotes/new" className="text-indigo-600 hover:underline">
+                Спробуйте ще раз
+              </Link>{" "}
+              трохи пізніше.
+            </p>
+          </div>
+        ) : overdue ? (
+          <p className="text-slate-600">
+            Кошторис готується довше, ніж зазвичай. Оновіть цю сторінку за кілька хвилин — посилання
+            на PDF з&apos;явиться тут.
+          </p>
+        ) : (
+          <div className="flex items-center gap-3">
+            <span className="h-4 w-4 animate-spin rounded-full border-2 border-indigo-600 border-t-transparent" />
+            <p className="text-slate-600">Готуємо кошторис — зазвичай це займає 1–2 хвилини. Сторінка оновиться сама.</p>
+            <QuoteStatusPoller deadline={quoteDeadline(quote)} />
+          </div>
+        )}
+      </section>
+
+      <dl className="grid grid-cols-1 gap-x-6 gap-y-3 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2">
+        <div>
+          <dt className="text-slate-500">Email</dt>
+          <dd className="font-medium break-words">{quote.email}</dd>
+        </div>
+        <div>
+          <dt className="text-slate-500">Бюджет</dt>
+          <dd className="font-medium">{budgetLabel ?? "—"}</dd>
+        </div>
+        <div className="sm:col-span-2">
+          <dt className="text-slate-500">Опис задачі</dt>
+          <dd className="whitespace-pre-line text-slate-700">{quote.description}</dd>
+        </div>
+      </dl>
+    </main>
+  );
+}
