@@ -0,0 +1,59 @@
+"use server";
+
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { logAudit } from "@/lib/audit";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors };
+  }
+
+  const quote = await db.insertQuote(parsed.data);
+  await logAudit("quote.requested", quote.id);
+
+  // Where the `quote-request` workflow POSTs the finished PDF (40–90s later).
+  const requestHeaders = await headers();
+  const host = requestHeaders.get("host") ?? "127.0.0.1:3000";
+  const proto = requestHeaders.get("x-forwarded-proto") ?? "http";
+  const callbackUrl = `${proto}://${host}/api/quotes/${quote.id}/callback`;
+
+  // Trigger the workflow. Its webhook responds immediately; the PDF arrives
+  // later via `callbackUrl`, so we do not block on the full 40–90s run here.
+  try {
+    const response = await fetch(process.env.N8N_QUOTE_WEBHOOK_URL!, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl,
+        callbackSecret: process.env.N8N_CALLBACK_SECRET,
+      }),
+    });
+    if (!response.ok) {
+      throw new Error(`n8n responded ${response.status}`);
+    }
+  } catch (error) {
+    console.error(`Failed to trigger quote workflow for ${quote.id}`, error);
+    await db.updateQuoteResult(quote.id, {
+      status: "failed",
+      error: "Не вдалося запустити підготовку кошторису. Спробуйте ще раз.",
+    });
+  }
+
+  redirect(`/quotes/${quote.id}`);
+}
