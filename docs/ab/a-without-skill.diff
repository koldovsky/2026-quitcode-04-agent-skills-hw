@@ -0,0 +1,83 @@
+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import { db } from "./db";
+import type { Quote, QuoteResult } from "./types";
+
+// The workflow normally takes 40–90 s. After this long without a callback the status page stops
+// polling and tells the client the quote is late.
+export const QUOTE_STALE_AFTER_MS = 5 * 60 * 1000;
+
+export function isQuoteStale(quote: Pick<Quote, "status" | "createdAt">) {
+  return quote.status === "pending" && Date.now() - Date.parse(quote.createdAt) > QUOTE_STALE_AFTER_MS;
+}
+
+// n8n's webhook should answer right away ("Respond: Immediately"); the result arrives via callback.
+const TRIGGER_TIMEOUT_MS = 15_000;
+
+// Each quote gets its own callback token: n8n receives it with the job and sends it back as
+// `Authorization: Bearer <token>`. Only its sha256 is stored, and it stops working once the quote is final.
+export function createCallbackToken() {
+  const token = randomBytes(32).toString("base64url");
+  return { token, hash: hashToken(token).toString("hex") };
+}
+
+function hashToken(token: string) {
+  return createHash("sha256").update(token).digest();
+}
+
+export function callbackTokenMatches(token: string, storedHash: string | null) {
+  if (!storedHash) return false;
+  const expected = Buffer.from(storedHash, "hex");
+  const actual = hashToken(token);
+  return expected.length === actual.length && timingSafeEqual(actual, expected);
+}
+
+export async function startQuoteWorkflow(quote: Quote, callbackToken: string) {
+  try {
+    const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+    const appUrl = process.env.APP_BASE_URL;
+    if (!webhookUrl || !appUrl) throw new Error("N8N_QUOTE_WEBHOOK_URL or APP_BASE_URL is not set");
+
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl: new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString(),
+        callbackToken,
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    if (!response.ok) throw new Error(`n8n responded with ${response.status}`);
+  } catch (error) {
+    console.error(`Failed to start quote workflow for ${quote.id}`, error);
+    await db.completeQuote(quote.id, { status: "failed", error: "Workflow did not start" });
+  }
+}
+
+function isAllowedPdfUrl(value: string) {
+  try {
+    const url = new URL(value);
+    // Rendered as a link on a public page: never allow javascript:, data: and friends.
+    return url.protocol === "https:" || (url.protocol === "http:" && process.env.NODE_ENV !== "production");
+  } catch {
+    return false;
+  }
+}
+
+// Expected body: { "status": "ready", "pdfUrl": "https://…" } or { "status": "failed", "error": "…" }.
+export function parseQuoteCallback(body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready" && typeof pdfUrl === "string" && isAllowedPdfUrl(pdfUrl)) {
+    return { status: "ready", pdfUrl };
+  }
+  if (status === "failed") {
+    return { status: "failed", error: typeof error === "string" && error ? error.slice(0, 500) : "Unknown error" };
+  }
+  return null;
+}
