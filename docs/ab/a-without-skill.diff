@@ -0,0 +1,90 @@
+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import { db } from "./db";
+import type { Quote, QuoteResult } from "./types";
+
+// The `quote-request` workflow takes 40–90 s. Past this point the status page stops
+// polling and asks the requester to come back later; a late callback is still accepted.
+const QUOTE_EXPECTED_MAX_MS = 5 * 60 * 1000;
+
+export function quoteDeadline(quote: Quote) {
+  return Date.parse(quote.createdAt) + QUOTE_EXPECTED_MAX_MS;
+}
+
+export function isQuoteOverdue(quote: Quote) {
+  return quote.status === "pending" && Date.now() >= quoteDeadline(quote);
+}
+
+// n8n should acknowledge the webhook right away ("Respond: Immediately"). If it only
+// answers when the workflow ends, we stop waiting here and leave the quote pending.
+const DISPATCH_TIMEOUT_MS = 15_000;
+
+function sha256(value: string) {
+  return createHash("sha256").update(value).digest();
+}
+
+export function createCallbackToken() {
+  const token = randomBytes(32).toString("base64url");
+  return { token, hash: sha256(token).toString("hex") };
+}
+
+export function isValidCallbackToken(token: string, expectedHash: string) {
+  return timingSafeEqual(sha256(token), Buffer.from(expectedHash, "hex"));
+}
+
+/** Starts the n8n workflow. Runs after the response, so it records failures instead of throwing. */
+export async function dispatchQuoteWorkflow(
+  quote: Quote,
+  { webhookUrl, callbackUrl, callbackToken }: { webhookUrl: string; callbackUrl: string; callbackToken: string },
+) {
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl,
+        callbackToken,
+      }),
+      signal: AbortSignal.timeout(DISPATCH_TIMEOUT_MS),
+    });
+    if (!response.ok) {
+      await db.completeQuote(quote.id, { status: "failed", error: `n8n webhook responded ${response.status}` });
+    }
+  } catch (error) {
+    if (error instanceof DOMException && error.name === "TimeoutError") {
+      console.warn(`n8n did not acknowledge quote ${quote.id} within ${DISPATCH_TIMEOUT_MS} ms; waiting for callback`);
+      return;
+    }
+    console.error(`Failed to start quote-request workflow for ${quote.id}`, error);
+    await db.completeQuote(quote.id, { status: "failed", error: "n8n webhook unreachable" });
+  }
+}
+
+function isHttpUrl(value: string) {
+  try {
+    const { protocol } = new URL(value);
+    return protocol === "https:" || protocol === "http:";
+  } catch {
+    return false;
+  }
+}
+
+/** Validates the body n8n posts back: `{ status: "ready", pdfUrl }` or `{ status: "failed", error? }`. */
+export function parseQuoteResult(body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready") {
+    return typeof pdfUrl === "string" && pdfUrl.length <= 2000 && isHttpUrl(pdfUrl)
+      ? { status: "ready", pdfUrl }
+      : null;
+  }
