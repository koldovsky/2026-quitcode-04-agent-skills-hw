@@ -0,0 +1,38 @@
+import { db } from "@/lib/db";
+import { isValidCallbackToken, parseQuoteCallback } from "@/lib/quotes";
+
+// Called by the n8n workflow "quote-request" when the PDF quote is ready or has failed.
+// The contract is described in lib/quotes.ts.
+export async function POST(request: Request, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+
+  // Authenticate before reading the body. An unknown id gets the same 401 as a wrong token.
+  const quote = await db.getQuote(id);
+  if (!quote || !isValidCallbackToken(request.headers.get("authorization"), quote)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "body must be JSON" }, { status: 400 });
+  }
+  const parsed = parseQuoteCallback(body);
+  if (!parsed.ok) {
+    return Response.json({ error: parsed.error }, { status: 400 });
+  }
+
+  const settled = await db.settleQuote(id, parsed.data);
+  if (!settled) {
+    // A retried delivery of the same result is fine; a different result for a settled quote is not.
+    const current = await db.getQuote(id);
+    if (current?.status === parsed.data.status) {
+      return Response.json({ status: current.status });
+    }
+    return Response.json({ error: "quote already settled", status: current?.status }, { status: 409 });
+  }
+
+  console.info("quote.settled", { quoteId: id, status: parsed.data.status });
+  return Response.json({ status: parsed.data.status });
+}
