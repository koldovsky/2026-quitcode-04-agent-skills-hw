+++ b/lib/quote-workflow.ts
@@ -0,0 +1,47 @@
+import { db } from "./db";
+import type { Quote } from "./types";
+
+// The n8n webhook must answer right away ("Respond: Immediately"); the 40–90 s of PDF work
+// happens after that, and n8n reports the result to /api/quotes/[id]/callback.
+const TRIGGER_TIMEOUT_MS = 15_000;
+
+// The workflow normally takes 40–90 s; a quote still in progress after this is treated as stuck.
+const STALE_AFTER_MS = 5 * 60 * 1000;
+
+export function isQuoteStale(quote: Quote) {
+  const inProgress = quote.status === "queued" || quote.status === "processing";
+  return inProgress && Date.now() - Date.parse(quote.createdAt) > STALE_AFTER_MS;
+}
+
+export async function startQuoteWorkflow(quote: Quote) {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appUrl = process.env.APP_URL;
+
+  try {
+    if (!webhookUrl || !appUrl) throw new Error("N8N_QUOTE_WEBHOOK_URL or APP_URL is not set");
+
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl: new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString(),
+        callbackToken: quote.callbackToken,
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    if (!response.ok) throw new Error(`n8n responded with ${response.status}`);
+
+    await db.markQuoteProcessing(quote.id);
+  } catch (error) {
+    console.error(`Failed to start quote-request workflow for quote ${quote.id}`, error);
+    await db.finishQuote(quote.id, {
+      status: "failed",
+      error: "Не вдалося запустити підготовку кошторису. Спробуйте ще раз трохи згодом.",
+    });
+  }
+}
