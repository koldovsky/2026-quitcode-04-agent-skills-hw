@@ -0,0 +1,29 @@
+"use server";
+
+import { after } from "next/server";
+import { redirect } from "next/navigation";
+import { logAudit } from "@/lib/audit";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormState } from "@/lib/quote-form";
+import { triggerQuoteWorkflow } from "@/lib/quote-workflow";
+
+const PUBLIC_FORM_WORKSPACE_ID = "ws_studio_nova";
+
+export async function requestQuote(_prevState: QuoteFormState, formData: FormData): Promise<QuoteFormState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) return { status: "invalid", errors: parsed.errors, values: parsed.values };
+
+  const quote = await db.insertQuote({ ...parsed.data, workspaceId: PUBLIC_FORM_WORKSPACE_ID });
+
+  // Only starts the workflow; the PDF is reported later to the callback route.
+  const triggered = await triggerQuoteWorkflow(quote);
+  if (!triggered.ok) {
+    console.error(`Failed to start quote-request workflow for ${quote.id}: ${triggered.error}`);
+    // The client sees a generic failure on the status page, not n8n details.
+    await db.completeQuote(quote.id, { status: "failed", error: "workflow_not_started" });
+  }
+
+  after(() => logAudit(triggered.ok ? "quote.requested" : "quote.trigger_failed", quote.id));
+
+  redirect(`/quotes/${quote.id}`);
+}
