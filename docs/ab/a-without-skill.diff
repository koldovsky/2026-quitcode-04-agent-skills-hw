index 0000000..40147af
--- /dev/null
+++ b/app/quotes/actions.ts
@@ -0,0 +1,53 @@
+"use server";
+
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+
+export type SubmitQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> };
+
+export async function submitQuoteRequest(
+  _prevState: SubmitQuoteState,
+  formData: FormData,
+): Promise<SubmitQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors };
+  }
+
+  const quote = await db.insertQuoteRequest(parsed.data);
+
+  const requestHeaders = await headers();
+  const baseUrl = process.env.APP_BASE_URL ?? requestHeaders.get("origin") ?? "http://localhost:3000";
+
+  try {
+    const response = await fetch(process.env.N8N_QUOTE_WEBHOOK_URL!, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl: `${baseUrl}/api/quotes/webhook`,
+      }),
+    });
+
+    if (!response.ok) {
+      await db.updateQuoteRequestStatus(quote.id, "error", {
+        errorMessage: `n8n відповів статусом ${response.status}`,
+      });
+    }
+  } catch (error) {
+    console.error(`Failed to start quote workflow for ${quote.id}`, error);
+    await db.updateQuoteRequestStatus(quote.id, "error", {
+      errorMessage: "Не вдалося запустити воркфлоу підготовки кошторису",
+    });
+  }
+
+  redirect(`/quotes/${quote.id}`);
+}
