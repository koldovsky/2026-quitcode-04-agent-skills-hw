 };
+
+export const QUOTE_STATUSES = ["pending", "ready", "failed"] as const;
+
+export type QuoteStatus = (typeof QUOTE_STATUSES)[number];
+
+export type Quote = {
+  id: string;
+  company: string;
+  email: string;
+  description: string;
+  budget: number | null;
+  status: QuoteStatus;
+  pdfUrl: string | null;
+  error: string | null;
+  // sha256 of the one-time token n8n must send back in the callback.
+  callbackTokenHash: string;
+  createdAt: string;
+  completedAt: string | null;
+};
+
