+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import type { Quote, QuoteResult } from "./types";
+
+// Contract with the n8n workflow `quote-request`:
+//
+// 1. LeadDesk POSTs to N8N_QUOTE_WEBHOOK_URL:
+//      { quoteId, company, email, description, budget, callbackUrl, callbackToken }
+//    The Webhook node must use "Respond: Immediately": the workflow runs 40–90 s, and nobody
+//    should wait for it inside a Server Action.
+// 2. When the PDF is ready (or the workflow fails), n8n POSTs to `callbackUrl` with the header
+//    `Authorization: Bearer <callbackToken>` and one of these JSON bodies:
+//      { "status": "ready", "pdfUrl": "https://…" }
+//      { "status": "failed", "error": "…" }
+
+// Enough for n8n to accept the webhook, not to run the workflow.
+const START_TIMEOUT_MS = 10_000;
+// The workflow takes 40–90 s: past this, the status page says it is taking longer than usual.
+const STALE_AFTER_MS = 3 * 60 * 1000;
+// A callback that never came: the page stops polling (a reload still shows the current status).
+const POLL_FOR_MS = 15 * 60 * 1000;
+
+export function createCallbackToken() {
+  return randomBytes(32).toString("base64url");
+}
+
+export function hashCallbackToken(token: string) {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+export function verifyCallbackToken(token: string, expectedHash: string) {
+  const actual = Buffer.from(hashCallbackToken(token), "hex");
+  const expected = Buffer.from(expectedHash, "hex");
+  return actual.length === expected.length && timingSafeEqual(actual, expected);
+}
+
+export type WorkflowStart = "started" | "unknown" | "failed";
+
+export async function startQuoteWorkflow(
+  quote: Quote,
+  callbackToken: string,
+  { webhookUrl, appUrl }: { webhookUrl: string; appUrl: string },
+): Promise<WorkflowStart> {
+  // Built from APP_URL, never from the request's Host header: a forged Host would send the
+  // callback token to someone else's server.
+  const callbackUrl = new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString();
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl,
+        callbackToken,
+      }),
+      signal: AbortSignal.timeout(START_TIMEOUT_MS),
+    });
+    if (!response.ok) {
+      console.error("quote.workflow_start failed", { quoteId: quote.id, httpStatus: response.status });
+      return "failed";
+    }
+    return "started";
+  } catch (error) {
+    if (error instanceof DOMException && error.name === "TimeoutError") {
+      // n8n may have accepted the request and still be running it: the callback decides.
+      console.warn("quote.workflow_start timed out", { quoteId: quote.id });
+      return "unknown";
+    }
+    console.error("quote.workflow_start failed", { quoteId: quote.id, error });
+    return "failed";
+  }
+}
+
+const PDF_URL_MAX_LENGTH = 2000;
+const FAILURE_REASON_MAX_LENGTH = 500;
+
+function isHttpUrl(value: string) {
+  try {
+    const { protocol } = new URL(value);
+    return protocol === "https:" || protocol === "http:";
+  } catch {
+    return false;
+  }
+}
+
+// The body comes from outside: only the two documented shapes are accepted.
+export function parseQuoteCallback(body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready") {
+    // pdfUrl ends up in an <a href>, so it must be a plain web link.
+    return typeof pdfUrl === "string" && pdfUrl.length <= PDF_URL_MAX_LENGTH && isHttpUrl(pdfUrl)
+      ? { status: "ready", pdfUrl }
+      : null;
+  }
+  if (status === "failed") {
+    return {
+      status: "failed",
+      failureReason: typeof error === "string" ? error.slice(0, FAILURE_REASON_MAX_LENGTH) : null,
+    };
+  }
+  return null;
+}
+
+export function getQuoteProgress(quote: Quote, now = Date.now()) {
+  const elapsed = now - Date.parse(quote.createdAt);
+  const processing = quote.status === "processing";
+  return {
+    stale: processing && elapsed > STALE_AFTER_MS,
+    polling: processing && elapsed < POLL_FOR_MS,
+  };
+}
