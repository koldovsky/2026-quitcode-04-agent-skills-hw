@@ -0,0 +1,55 @@
+"use server";
+
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> };
+
+async function getBaseUrl() {
+  if (process.env.APP_BASE_URL) return process.env.APP_BASE_URL;
+  const requestHeaders = await headers();
+  const protocol = requestHeaders.get("x-forwarded-proto") ?? "http";
+  const host = requestHeaders.get("host");
+  return `${protocol}://${host}`;
+}
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors };
+  }
+
+  const quote = await db.insertQuoteRequest(parsed.data);
+
+  try {
+    const baseUrl = await getBaseUrl();
+    const response = await fetch(process.env.N8N_QUOTE_WEBHOOK_URL!, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        taskDescription: quote.taskDescription,
+        budget: quote.budget,
+        callbackUrl: `${baseUrl}/api/quotes/${quote.id}/callback`,
+      }),
+      signal: AbortSignal.timeout(10_000),
+    });
+    if (!response.ok) {
+      await db.markQuoteFailed(quote.id, `Воркфлоу відповів помилкою ${response.status}`);
+    }
+  } catch (error) {
+    console.error(`Failed to trigger quote-request workflow for ${quote.id}`, error);
+    await db.markQuoteFailed(quote.id, "Не вдалося запустити підготовку кошторису");
+  }
+
+  redirect(`/quotes/${quote.id}`);
+}
