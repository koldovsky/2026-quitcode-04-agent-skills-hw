@@ -0,0 +1,58 @@
+import { isAuthorizedCallback } from "@/lib/n8n-quote";
+import { isFinalStatus, quotes } from "@/lib/quotes";
+
+// Called by the n8n quote-request workflow when the PDF is ready (or failed).
+// Body: { "status": "ready", "pdfUrl": "https://…" } | { "status": "failed", "error": "…" }
+export async function POST(request: Request, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  if (!isAuthorizedCallback(request)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const { id } = await ctx.params;
+  const quote = quotes.get(id);
+  if (!quote) {
+    return Response.json({ error: "quote not found" }, { status: 404 });
+  }
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+  const payload = (body ?? {}) as Record<string, unknown>;
+
+  // n8n retries on errors; a repeated callback for a finished quote is a no-op.
+  if (isFinalStatus(quote.status)) {
+    return Response.json({ ok: true, status: quote.status });
+  }
+
+  if (payload.status === "ready") {
+    const pdfUrl = parsePdfUrl(payload.pdfUrl);
+    if (!pdfUrl) {
+      return Response.json({ error: "pdfUrl must be an https URL" }, { status: 400 });
+    }
+    quotes.update(id, { status: "ready", pdfUrl, error: null });
+    return Response.json({ ok: true, status: "ready" });
+  }
+
+  if (payload.status === "failed") {
+    const error = typeof payload.error === "string" ? payload.error.slice(0, 500) : "workflow-failed";
+    quotes.update(id, { status: "failed", error });
+    return Response.json({ ok: true, status: "failed" });
+  }
+
+  return Response.json({ error: "status must be 'ready' or 'failed'" }, { status: 400 });
+}
+
+function parsePdfUrl(value: unknown) {
+  if (typeof value !== "string") return null;
+  try {
+    const url = new URL(value);
+    const isLocalDev =
+      process.env.NODE_ENV !== "production" && url.protocol === "http:" && ["localhost", "127.0.0.1"].includes(url.hostname);
+    return url.protocol === "https:" || isLocalDev ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
