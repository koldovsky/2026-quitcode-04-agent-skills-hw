+import { timingSafeEqual } from "node:crypto";
+import type { NextRequest } from "next/server";
+import { db } from "@/lib/db";
+
+// Called by the n8n quote-request workflow when the PDF is ready (or the run failed).
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <callbackToken from the trigger payload>
+//   { "status": "ready", "pdfUrl": "https://…" } | { "status": "failed", "error": "…" }
+
+function tokenMatches(expected: string, header: string | null) {
+  const given = header?.startsWith("Bearer ") ? header.slice("Bearer ".length) : "";
+  const a = Buffer.from(given);
+  const b = Buffer.from(expected);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+function parsePdfUrl(value: unknown) {
+  if (typeof value !== "string" || value.length > 2000) return null;
+  try {
+    const url = new URL(value);
+    // The link is rendered as <a href>, so anything but http(s) (e.g. javascript:) is rejected.
+    return url.protocol === "https:" || url.protocol === "http:" ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+  const quote = await db.getQuote(id);
+  if (!quote || !tokenMatches(quote.callbackToken, request.headers.get("authorization"))) {
+    return Response.json({ error: "not found" }, { status: 404 });
+  }
+
+  const body: unknown = await request.json().catch(() => null);
+  const payload = typeof body === "object" && body !== null ? (body as Record<string, unknown>) : {};
+
+  if (payload.status === "ready") {
+    const pdfUrl = parsePdfUrl(payload.pdfUrl);
+    if (!pdfUrl) return Response.json({ error: "pdfUrl must be an http(s) URL" }, { status: 400 });
+    // A repeated "ready" is fine (n8n retries); only a conflicting one is reported.
+    if (quote.status === "ready" && quote.pdfUrl !== pdfUrl) {
+      return Response.json({ error: "quote is already ready" }, { status: 409 });
+    }
+    await db.finishQuote(id, { status: "ready", pdfUrl });
+    return Response.json({ ok: true });
+  }
+
+  if (payload.status === "failed") {
+    if (quote.status === "ready") {
+      return Response.json({ error: "quote is already ready" }, { status: 409 });
+    }
+    const error =
+      typeof payload.error === "string" && payload.error.trim()
+        ? payload.error.trim().slice(0, 500)
+        : "Не вдалося підготувати кошторис.";
+    await db.finishQuote(id, { status: "failed", error });
+    return Response.json({ ok: true });
+  }
+
+  return Response.json({ error: 'status must be "ready" or "failed"' }, { status: 400 });
+}
