@@ -0,0 +1,42 @@
+"use server";
+
+import { randomUUID } from "node:crypto";
+import { redirect } from "next/navigation";
+import { after } from "next/server";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+import { createCallbackToken, dispatchQuoteWorkflow } from "@/lib/quotes";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> }
+  | { status: "unavailable" };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors };
+  }
+
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  // The callback URL comes from config, not the Host header: n8n posts the token to it.
+  const appUrl = process.env.APP_URL;
+  if (!webhookUrl || !appUrl) {
+    console.error("Quote requests need N8N_QUOTE_WEBHOOK_URL and APP_URL to be set");
+    return { status: "unavailable" };
+  }
+
+  // The id is the only thing guarding the public status page, so it must be unguessable.
+  const id = randomUUID();
+  const { token, hash } = createCallbackToken();
+  const quote = await db.insertQuote({ ...parsed.data, id, callbackTokenHash: hash });
+  const callbackUrl = new URL(`/api/quotes/${id}/callback`, appUrl).toString();
+
+  // The workflow runs 40–90 s: start it after the response and let the status page wait.
+  after(() => dispatchQuoteWorkflow(quote, { webhookUrl, callbackUrl, callbackToken: token }));
+
+  redirect(`/quotes/${id}`);
+}
