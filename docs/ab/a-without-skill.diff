@@ -0,0 +1,71 @@
+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import { db } from "./db";
+import type { Quote } from "./types";
+
+// The quote-request workflow takes 40–90 s, so it is never awaited in a
+// request: the Server Action only starts it, and n8n reports the result to
+// /api/quotes/[id]/callback. The n8n Webhook node should use
+// "Respond: Immediately", otherwise the trigger below times out (harmlessly).
+const TRIGGER_TIMEOUT_MS = 10_000;
+
+// After this long without a callback the status page says the quote is late.
+const QUOTE_OVERDUE_MS = 5 * 60_000;
+
+export function isQuoteOverdue(quote: Quote) {
+  return quote.status === "pending" && Date.now() - Date.parse(quote.createdAt) > QUOTE_OVERDUE_MS;
+}
+
+export function createCallbackToken() {
+  const token = randomBytes(32).toString("base64url");
+  return { token, hash: hashToken(token).toString("hex") };
+}
+
+function hashToken(token: string) {
+  return createHash("sha256").update(token).digest();
+}
+
+export function isValidCallbackToken(quote: Quote, token: string) {
+  const expected = Buffer.from(quote.callbackTokenHash, "hex");
+  const actual = hashToken(token);
+  return expected.length === actual.length && timingSafeEqual(expected, actual);
+}
+
+export async function triggerQuoteWorkflow(quote: Quote, callbackToken: string) {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appUrl = process.env.APP_BASE_URL;
+  if (!webhookUrl || !appUrl) {
+    console.error("N8N_QUOTE_WEBHOOK_URL or APP_BASE_URL is not set; quote workflow not started");
+    await db.completeQuote(quote.id, { status: "failed", error: "Сервіс кошторисів не налаштовано" });
+    return;
+  }
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callback: {
+          url: new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString(),
+          // n8n sends this back as `Authorization: Bearer <token>`.
+          token: callbackToken,
+        },
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    if (!response.ok) throw new Error(`n8n responded with ${response.status}`);
+  } catch (error) {
+    // A timeout means n8n accepted the request but answers only at the end of
+    // the run; the workflow is still going, so wait for the callback.
+    if (error instanceof DOMException && error.name === "TimeoutError") {
+      console.warn(`Quote ${quote.id}: n8n webhook did not answer in ${TRIGGER_TIMEOUT_MS} ms, waiting for callback`);
+      return;
+    }
+    console.error(`Quote ${quote.id}: failed to start n8n workflow`, error);
+    await db.completeQuote(quote.id, { status: "failed", error: "Не вдалося запустити підготовку кошторису" });
+  }
+}
