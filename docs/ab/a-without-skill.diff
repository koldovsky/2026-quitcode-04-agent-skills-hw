+import { db } from "@/lib/db";
+
+type CallbackPayload =
+  | { status: "ready"; pdfUrl: string }
+  | { status: "failed"; error?: string };
+
+function isCallbackPayload(value: unknown): value is CallbackPayload {
+  if (typeof value !== "object" || value === null) return false;
+  const status = (value as { status?: unknown }).status;
+  if (status === "ready") {
+    return typeof (value as { pdfUrl?: unknown }).pdfUrl === "string";
+  }
+  return status === "failed";
+}
+
+export async function POST(request: Request, { params }: RouteContext<"/api/quotes/[id]/callback">) {
+  const secret = process.env.N8N_CALLBACK_SECRET;
+  if (!secret || request.headers.get("x-n8n-secret") !== secret) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const { id } = await params;
+  const quote = await db.getQuoteRequest(id);
+  if (!quote) {
+    return Response.json({ error: "quote not found" }, { status: 404 });
+  }
+
+  const body: unknown = await request.json().catch(() => null);
+  if (!isCallbackPayload(body)) {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  if (body.status === "ready") {
+    await db.markQuoteReady(id, body.pdfUrl);
+  } else {
+    await db.markQuoteFailed(id, body.error?.slice(0, 500) || "Помилка генерації кошторису");
+  }
+
+  return Response.json({ ok: true });
+}
