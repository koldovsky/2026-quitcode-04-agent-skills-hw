@@ -0,0 +1,62 @@
+"use server";
+
+import { redirect } from "next/navigation";
+import { after } from "next/server";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField, type QuoteFormValues } from "@/lib/quote-form";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues }
+  | { status: "error"; message: string };
+
+// Only the start of the workflow is awaited: the n8n Webhook node must respond
+// immediately, and the finished PDF arrives later at /api/quotes/[id]/callback.
+const TRIGGER_TIMEOUT_MS = 15_000;
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: parsed.values };
+  }
+
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appUrl = process.env.APP_URL;
+  if (!webhookUrl || !appUrl) {
+    console.error("Quote requests are disabled: N8N_QUOTE_WEBHOOK_URL or APP_URL is not set");
+    return { status: "error", message: "Не вдалося надіслати запит. Спробуйте пізніше." };
+  }
+
+  const quote = await db.insertQuote(parsed.data);
+
+  // The callback URL comes from config, not from the Host header, so a forged
+  // request cannot make n8n deliver the quote to someone else's server.
+  const callbackUrl = new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString();
+
+  after(async () => {
+    try {
+      const response = await fetch(webhookUrl, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({
+          quoteId: quote.id,
+          company: quote.company,
+          email: quote.email,
+          description: quote.description,
+          budget: quote.budget,
+          callbackUrl,
+        }),
+        signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+      });
+      if (!response.ok) throw new Error(`n8n responded with ${response.status}`);
+    } catch (error) {
+      console.error(`Failed to start quote-request workflow for ${quote.id}`, error);
+      await db.completeQuote(quote.id, { status: "failed", error: "Не вдалося запустити підготовку кошторису" });
+    }
+  });
+
+  redirect(`/quotes/${quote.id}`);
+}
