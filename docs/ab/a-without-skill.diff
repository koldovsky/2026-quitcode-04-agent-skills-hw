+"use client";
+
+import { useActionState } from "react";
+import { requestQuote, type RequestQuoteState } from "@/app/quotes/actions";
+import { QUOTE_BUDGET_OPTIONS } from "@/lib/quotes";
+
+const initialState: RequestQuoteState = { status: "idle" };
+
+const inputClass =
+  "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500";
+
+export function QuoteForm() {
+  const [state, formAction, pending] = useActionState(requestQuote, initialState);
+  const errors = state.status === "invalid" ? state.errors : {};
+  const values = state.status === "invalid" ? state.values : undefined;
+
+  return (
+    <form action={formAction} className="space-y-4" noValidate>
+      <div className="grid gap-4 sm:grid-cols-2">
+        <label className="block text-sm font-medium">
+          Компанія
+          <input name="company" autoComplete="organization" defaultValue={values?.company} className={inputClass} />
+          {errors.company && <span className="mt-1 block text-xs text-red-600">{errors.company}</span>}
+        </label>
+        <label className="block text-sm font-medium">
+          Email
+          <input name="email" type="email" autoComplete="email" defaultValue={values?.email} className={inputClass} />
+          {errors.email && <span className="mt-1 block text-xs text-red-600">{errors.email}</span>}
+        </label>
+      </div>
+
+      <label className="block text-sm font-medium">
+        Опис задачі
+        <textarea name="description" rows={6} defaultValue={values?.description} className={inputClass} />
+        {errors.description && <span className="mt-1 block text-xs text-red-600">{errors.description}</span>}
+      </label>
+
+      <label className="block text-sm font-medium">
+        Бюджет
+        <select name="budget" defaultValue={values?.budget ?? ""} className={inputClass}>
+          {QUOTE_BUDGET_OPTIONS.map((option) => (
+            <option key={option.value} value={option.value}>
+              {option.label}
+            </option>
+          ))}
+        </select>
+        {errors.budget && <span className="mt-1 block text-xs text-red-600">{errors.budget}</span>}
+      </label>
+
+      <button
+        type="submit"
+        disabled={pending}
+        className="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60"
+      >
+        {pending ? "Надсилаємо…" : "Запросити кошторис"}
+      </button>
+    </form>
+  );
+}
diff --git a/lib/n8n-quote.ts b/lib/n8n-quote.ts
new file mode 100644
index 0000000..5803bdf
--- /dev/null
+++ b/lib/n8n-quote.ts
@@ -0,0 +1,50 @@
+import { timingSafeEqual } from "node:crypto";
+import { quotes, type Quote } from "./quotes";
+
+// The quote-request workflow takes 40–90 s, so we never wait for it to finish.
+// Its Webhook node must respond immediately ("Respond: Immediately"); the
+// finished quote comes back later via POST /api/quotes/[id]/callback.
+const TRIGGER_TIMEOUT_MS = 10_000;
+
+export async function triggerQuoteWorkflow(quote: Quote) {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appUrl = process.env.APP_BASE_URL;
+  if (!webhookUrl || !appUrl || !process.env.N8N_QUOTE_CALLBACK_SECRET) {
+    console.error("Quote workflow is not configured: set N8N_QUOTE_WEBHOOK_URL, APP_BASE_URL, N8N_QUOTE_CALLBACK_SECRET");
+    quotes.update(quote.id, { status: "failed", error: "not-configured" });
+    return;
+  }
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl: new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString(),
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    if (!response.ok) throw new Error(`n8n responded ${response.status}`);
+    // Don't overwrite a result if the callback somehow arrived first.
+    const current = quotes.get(quote.id);
+    if (current?.status === "pending") quotes.update(quote.id, { status: "processing" });
+  } catch (error) {
+    console.error(`Failed to start quote workflow for ${quote.id}`, error);
+    quotes.update(quote.id, { status: "failed", error: "trigger-failed" });
+  }
+}
+
+// n8n sends `Authorization: Bearer <N8N_QUOTE_CALLBACK_SECRET>` (Header Auth credential).
+export function isAuthorizedCallback(request: Request) {
+  const secret = process.env.N8N_QUOTE_CALLBACK_SECRET;
+  if (!secret) return false;
+  const header = request.headers.get("authorization") ?? "";
+  const expected = Buffer.from(`Bearer ${secret}`);
+  const actual = Buffer.from(header);
+  return actual.length === expected.length && timingSafeEqual(actual, expected);
+}
