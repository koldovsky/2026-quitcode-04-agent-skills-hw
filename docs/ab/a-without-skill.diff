+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField, type QuoteFormValues } from "@/lib/quote-form";
+import { createCallbackToken, startQuoteWorkflow } from "@/lib/quotes";
+
+const PUBLIC_FORM_WORKSPACE_ID = "ws_studio_nova";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues }
+  | { status: "error"; values: QuoteFormValues };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: parsed.values };
+  }
+
+  const { token, hash } = createCallbackToken();
+  const quote = await db.insertQuoteRequest({
+    ...parsed.data,
+    workspaceId: PUBLIC_FORM_WORKSPACE_ID,
+    callbackTokenHash: hash,
+  });
+
+  // Waits only for n8n to accept the job, not for the 40–90 s of PDF work: the
+  // status page picks up the result once n8n calls back.
+  const started = await startQuoteWorkflow(quote, token);
+  if (!started) {
+    await db.finishQuoteRequest(quote.id, { status: "failed" });
+    return { status: "error", values: parsed.values };
+  }
+
+  redirect(`/quotes/${quote.id}`);
+}
