@@ -0,0 +1,32 @@
+import { db } from "@/lib/db";
+import { callbackTokenMatches, parseQuoteCallback } from "@/lib/quotes";
+
+// Called by the n8n `quote-request` workflow when the PDF is ready (or the run failed):
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <callbackToken from the trigger payload>
+//   { "status": "ready", "pdfUrl": "https://…" } | { "status": "failed", "error": "…" }
+export async function POST(request: Request, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+  const token = request.headers.get("authorization")?.match(/^Bearer (\S+)$/)?.[1];
+  const quote = await db.getQuote(id);
+
+  // Same answer for an unknown quote and a wrong token, so the endpoint does not confirm ids.
+  if (!quote || !token || !callbackTokenMatches(token, quote.callbackTokenHash)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const result = parseQuoteCallback(await request.json().catch(() => null));
+  if (!result) {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  if (!(await db.completeQuote(quote.id, result))) {
+    return Response.json({ error: "quote is already completed" }, { status: 409 });
+  }
+
+  if (result.status === "failed") {
+    console.error(`Quote workflow failed for ${quote.id}: ${result.error}`);
+  }
+
+  return Response.json({ ok: true });
+}
