+"use server";
+
+import { after } from "next/server";
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField, type QuoteFormValues } from "@/lib/quote-form";
+import { createCallbackToken, triggerQuoteWorkflow } from "@/lib/quotes";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) return { status: "invalid", errors: parsed.errors, values: parsed.values };
+
+  const { token, hash } = createCallbackToken();
+  const quote = await db.insertQuote({ ...parsed.data, callbackTokenHash: hash });
+
+  // Start the workflow after the response so the visitor lands on the status
+  // page right away instead of waiting for n8n.
+  after(() => triggerQuoteWorkflow(quote, token));
+
+  redirect(`/quotes/${quote.id}`);
+}
