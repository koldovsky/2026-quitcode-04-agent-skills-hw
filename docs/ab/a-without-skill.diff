+import type { NextRequest } from "next/server";
+import { db } from "@/lib/db";
+import { parseQuoteCallback, verifyCallbackToken } from "@/lib/quotes";
+
+// n8n calls this when the `quote-request` workflow finishes; the contract is in lib/quotes.ts.
+// The URL is public, so the only proof of origin is the one-off token sent with that quote.
+
+const MAX_BODY_BYTES = 10_000;
+
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+  const token = request.headers.get("authorization")?.match(/^Bearer (\S+)$/)?.[1];
+
+  const quote = token ? await db.getQuote(id) : null;
+  // One answer for an unknown quote and a wrong token: the endpoint does not confirm which ids exist.
+  if (!quote || !token || !verifyCallbackToken(token, quote.callbackTokenHash)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const raw = await request.text();
+  if (new TextEncoder().encode(raw).length > MAX_BODY_BYTES) {
+    return Response.json({ error: "payload too large" }, { status: 413 });
+  }
+
+  let body: unknown;
+  try {
+    body = JSON.parse(raw);
+  } catch {
+    return Response.json({ error: "invalid JSON" }, { status: 400 });
+  }
+
+  const result = parseQuoteCallback(body);
+  if (!result) {
+    return Response.json(
+      { error: 'expected { "status": "ready", "pdfUrl": "https://…" } or { "status": "failed", "error": "…" }' },
+      { status: 400 },
+    );
+  }
+
+  const outcome = await db.finishQuote(quote.id, result);
+  if (outcome === "not_found") {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+  if (outcome === "updated" && result.status === "failed") {
+    console.error("quote.workflow failed", { quoteId: quote.id, reason: result.failureReason });
+  }
+
+  // A repeated callback (n8n retries) is acknowledged but does not change a final result.
+  return Response.json({ ok: true, updated: outcome === "updated" });
+}
