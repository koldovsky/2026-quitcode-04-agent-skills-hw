+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusPoller } from "@/components/quote-status-poller";
+import { getQuoteRequest } from "@/lib/data";
+import { quoteDisplayStatus } from "@/lib/quotes";
+
+// Anyone with the URL can open this page, so keep it out of search engines and
+// out of the Referer header sent to other sites.
+export const metadata: Metadata = {
+  title: "Статус кошторису · Studio Nova",
+  robots: { index: false, follow: false },
+  referrer: "no-referrer",
+};
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await getQuoteRequest(id);
+  if (!quote) notFound();
+
+  const status = quoteDisplayStatus(quote);
+
+  return (
+    <main className="mx-auto w-full max-w-xl flex-1 space-y-6 px-6 py-12">
+      <div className="space-y-1">
+        <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+        <p className="text-sm text-slate-500">Запит від {dateTimeFormat.format(new Date(quote.createdAt))}</p>
+      </div>
+
+      <section role="status" className="space-y-3 rounded-xl border border-slate-200 bg-white p-6 text-sm shadow-sm">
+        {status === "pending" && (
+          <>
+            <p className="text-base font-medium">Готуємо кошторис…</p>
+            <p className="text-slate-600">Зазвичай це займає 1–2 хвилини. Сторінка оновиться сама.</p>
+            <noscript>
+              <p className="text-slate-600">Оновіть сторінку, щоб перевірити статус.</p>
+            </noscript>
+          </>
+        )}
+
+        {status === "ready" && quote.pdfUrl && (
+          <>
+            <p className="text-base font-medium">Кошторис готовий.</p>
+            <a
+              href={quote.pdfUrl}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="inline-flex rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700"
+            >
+              Відкрити PDF
+            </a>
+          </>
+        )}
+
+        {status === "failed" && (
+          <>
+            <p className="text-base font-medium">Не вдалося підготувати кошторис.</p>
+            <p className="text-slate-600">
+              Спробуйте надіслати запит ще раз.{" "}
+              <Link href="/quotes/new" className="text-indigo-600 hover:text-indigo-800">
+                Новий запит
+              </Link>
+            </p>
+          </>
+        )}
+      </section>
+
+      {status === "pending" && <QuoteStatusPoller />}
+    </main>
+  );
+}
