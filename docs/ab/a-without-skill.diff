@@ -0,0 +1,21 @@
+"use client";
+
+import { useEffect } from "react";
+import { useRouter } from "next/navigation";
+
+const POLL_INTERVAL_MS = 4000;
+
+/** Re-renders the status page until the quote is final or `deadline` (epoch ms) passes. */
+export function QuoteStatusPoller({ deadline }: { deadline: number }) {
+  const router = useRouter();
+
+  useEffect(() => {
+    const timer = setInterval(() => {
+      if (Date.now() >= deadline) clearInterval(timer);
+      router.refresh();
+    }, POLL_INTERVAL_MS);
+    return () => clearInterval(timer);
+  }, [deadline, router]);
+
+  return null;
+}
