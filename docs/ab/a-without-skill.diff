+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await getQuote(id);
+  if (!quote) notFound();
+
+  const waiting = quote.status === "pending" && !quote.stalled;
+
+  return (
+    <div className="flex flex-1 flex-col">
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
+          <Link href="/" className="text-lg font-semibold tracking-tight">
+            Studio Nova
+          </Link>
+        </div>
+      </header>
+
+      <main className="mx-auto w-full max-w-2xl flex-1 space-y-6 px-6 py-12">
+        <div>
+          <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+          <p className="text-sm text-slate-500">
+            Запит від {dateTimeFormat.format(new Date(quote.createdAt))}
+            {quote.budget !== null && ` · бюджет ${usd.format(quote.budget)} / міс.`}
+          </p>
+        </div>
+
+        <section className="rounded-xl border border-slate-200 bg-white p-6 text-sm shadow-sm" aria-live="polite">
+          {waiting && (
+            <div className="flex items-start gap-3">
+              <span className="mt-0.5 h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-indigo-200 border-t-indigo-600" />
+              <div className="space-y-1">
+                <p className="font-medium">Готуємо кошторис…</p>
+                <p className="text-slate-600">
+                  Зазвичай це займає від 40 до 90 секунд. Сторінка оновиться автоматично — її можна
+                  не перезавантажувати.
+                </p>
+              </div>
+            </div>
+          )}
+
+          {quote.stalled && (
+            <div className="space-y-1">
+              <p className="font-medium">Кошторис готується довше, ніж зазвичай</p>
+              <p className="text-slate-600">
+                Запит не втрачено — оновіть цю сторінку трохи пізніше. Збережіть посилання на неї,
+                щоб повернутися до результату.
+              </p>
+            </div>
+          )}
+
+          {quote.status === "ready" && quote.pdfUrl && (
+            <div className="space-y-3">
+              <p className="font-medium text-emerald-700">Кошторис готовий</p>
+              <a
+                href={quote.pdfUrl}
+                target="_blank"
+                rel="noopener noreferrer"
+                className="inline-flex rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700"
+              >
+                Завантажити PDF
+              </a>
+            </div>
+          )}
+
+          {quote.status === "failed" && (
+            <div className="space-y-2">
+              <p className="font-medium text-red-700">Не вдалося підготувати кошторис</p>
+              <p className="text-slate-600">
+                <Link href="/quotes/new" className="text-indigo-600 hover:underline">
+                  Спробуйте надіслати запит ще раз
+                </Link>{" "}
+                або залиште{" "}
+                <Link href="/" className="text-indigo-600 hover:underline">
+                  звичайну заявку
+                </Link>
+                — менеджер зв&apos;яжеться з вами.
+              </p>
+            </div>
+          )}
+        </section>
+
+        {waiting && <QuoteStatusPoller />}
+      </main>
+    </div>
+  );
+}
