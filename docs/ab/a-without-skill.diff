+import { db } from "@/lib/db";
+import { parseQuoteCallback, verifyCallbackToken } from "@/lib/quotes";
+
+// n8n calls this when the "quote-request" workflow has finished:
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <callback.token from the payload that started the workflow>
+//   { "status": "ready", "pdfUrl": "https://…" } or { "status": "failed" }
+// The endpoint is public, so the quote id in the path proves nothing: only the
+// per-request token does.
+export async function POST(request: Request, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+  const quote = await db.getQuoteRequest(id);
+  // Same answer for an unknown id and a wrong token: nothing to probe for.
+  if (!quote || !verifyCallbackToken(request.headers.get("authorization"), quote.callbackTokenHash)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+
+  const result = parseQuoteCallback(body);
+  if (!result) {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  const saved = await db.finishQuoteRequest(quote.id, result);
+  if (!saved) {
+    return Response.json({ error: "quote already finished" }, { status: 409 });
+  }
+
+  return Response.json({ ok: true });
+}
