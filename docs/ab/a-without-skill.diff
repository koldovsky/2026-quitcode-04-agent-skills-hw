+import { createHash, timingSafeEqual } from "node:crypto";
+import { revalidatePath } from "next/cache";
+import { db } from "@/lib/db";
+
+// Called by the n8n `quote-request` workflow when the PDF is ready (or the run failed):
+//
+//   POST /api/quotes/callback
+//   Authorization: Bearer <N8N_QUOTE_CALLBACK_SECRET>
+//   { "quoteId": "quote_…", "status": "ready", "pdfUrl": "https://…" }
+//   { "quoteId": "quote_…", "status": "failed", "error": "…" }
+//
+// Anyone on the internet can reach this URL, so every request must carry the shared secret.
+
+type CallbackResult = { status: "ready"; pdfUrl: string } | { status: "failed"; error: string };
+
+function isAuthorized(request: Request, secret: string) {
+  const header = request.headers.get("authorization") ?? "";
+  const token = header.startsWith("Bearer ") ? header.slice("Bearer ".length) : "";
+  // Hash both sides so timingSafeEqual gets equal-length buffers and leaks nothing about length.
+  const digest = (value: string) => createHash("sha256").update(value).digest();
+  return token !== "" && timingSafeEqual(digest(token), digest(secret));
+}
+
+function parseBody(body: unknown): { quoteId: string; result: CallbackResult } | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { quoteId, status, pdfUrl, error } = body as Record<string, unknown>;
+  if (typeof quoteId !== "string" || !/^quote_[0-9a-f-]{36}$/.test(quoteId)) return null;
+
+  if (status === "ready") {
+    if (typeof pdfUrl !== "string" || !URL.canParse(pdfUrl)) return null;
+    // The link is rendered as <a href>, so only web URLs are allowed (no javascript:, data:).
+    if (!["https:", "http:"].includes(new URL(pdfUrl).protocol)) return null;
+    return { quoteId, result: { status: "ready", pdfUrl } };
+  }
+  if (status === "failed") {
+    const message = typeof error === "string" && error.trim() ? error.trim().slice(0, 500) : "unknown error";
+    return { quoteId, result: { status: "failed", error: message } };
+  }
+  return null;
+}
+
+export async function POST(request: Request) {
+  const secret = process.env.N8N_QUOTE_CALLBACK_SECRET;
+  if (!secret) {
+    console.error("N8N_QUOTE_CALLBACK_SECRET is not set; rejecting quote callback");
+    return Response.json({ error: "callback not configured" }, { status: 503 });
+  }
+  if (!isAuthorized(request, secret)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+
+  const parsed = parseBody(body);
+  if (!parsed) {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  const outcome = await db.completeQuote(parsed.quoteId, parsed.result);
+  if (outcome === "not-found") {
+    return Response.json({ error: "quote not found" }, { status: 404 });
+  }
+  if (outcome === "already-completed") {
+    return Response.json({ error: "quote already completed" }, { status: 409 });
+  }
+
+  if (parsed.result.status === "failed") {
+    console.error(`Quote workflow failed for ${parsed.quoteId}: ${parsed.result.error}`);
+  }
+  revalidatePath(`/quotes/${parsed.quoteId}`);
+  return Response.json({ ok: true });
+}
