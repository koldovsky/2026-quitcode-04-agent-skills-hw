+import type { NextRequest } from "next/server";
+import { revalidatePath } from "next/cache";
+import { db } from "@/lib/db";
+import { logAudit } from "@/lib/audit";
+
+// The n8n `quote-request` workflow POSTs here once the PDF-кошторис is ready.
+// Expected body: { status: "ready", pdfUrl } or { status: "failed", error }.
+
+function isAuthorized(request: NextRequest) {
+  const expected = process.env.N8N_CALLBACK_SECRET;
+  // Fail closed: without a configured secret the endpoint stays locked.
+  if (!expected) return false;
+  const header =
+    request.headers.get("x-callback-secret") ??
+    request.headers.get("authorization")?.replace(/^Bearer\s+/i, "") ??
+    "";
+  return header === expected;
+}
+
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  if (!isAuthorized(request)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const { id } = await ctx.params;
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+
+  const payload = body as { status?: unknown; pdfUrl?: unknown; error?: unknown };
+  const status = payload.status === "ready" ? "ready" : payload.status === "failed" ? "failed" : null;
+  if (!status) {
+    return Response.json({ error: "status must be 'ready' or 'failed'" }, { status: 400 });
+  }
+
+  if (status === "ready" && typeof payload.pdfUrl !== "string") {
+    return Response.json({ error: "pdfUrl is required when status is 'ready'" }, { status: 400 });
+  }
+
+  const updated = await db.updateQuoteResult(id, {
+    status,
+    pdfUrl: status === "ready" ? (payload.pdfUrl as string) : null,
+    error: status === "failed" ? (typeof payload.error === "string" ? payload.error : "Не вдалося підготувати кошторис.") : null,
+  });
+
+  if (!updated) {
+    return Response.json({ error: "quote not found" }, { status: 404 });
+  }
+
+  await logAudit(`quote.${status}`, id);
+  revalidatePath(`/quotes/${id}`);
+
+  return Response.json({ ok: true });
+}
