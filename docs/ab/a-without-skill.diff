+import type { NextRequest } from "next/server";
+import { db } from "@/lib/db";
+import { isValidCallbackToken, parseQuoteResult } from "@/lib/quotes";
+
+const MAX_BODY_BYTES = 10_000;
+
+// n8n calls this when the `quote-request` workflow ends:
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <callbackToken from the trigger payload>
+//   { "status": "ready", "pdfUrl": "https://…" }  or  { "status": "failed", "error": "…" }
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+  const token = request.headers.get("authorization")?.match(/^Bearer (\S+)$/)?.[1];
+  const quote = token ? await db.getQuote(id) : null;
+  // Unknown quote and wrong token look the same, so the endpoint does not reveal which ids exist.
+  if (!token || !quote || !isValidCallbackToken(token, quote.callbackTokenHash)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const raw = await request.text();
+  if (raw.length > MAX_BODY_BYTES) {
+    return Response.json({ error: "payload too large" }, { status: 413 });
+  }
+  let body: unknown;
+  try {
+    body = JSON.parse(raw);
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+  const result = parseQuoteResult(body);
+  if (!result) {
+    return Response.json(
+      { error: 'expected {"status":"ready","pdfUrl":"https://…"} or {"status":"failed"}' },
+      { status: 422 },
+    );
+  }
+
+  if (quote.status !== "pending") {
+    // A retry of the callback that already landed is fine; a different outcome is not.
+    const sameOutcome = quote.status === result.status && (result.status !== "ready" || quote.pdfUrl === result.pdfUrl);
+    return sameOutcome
+      ? Response.json({ ok: true })
+      : Response.json({ error: `quote is already ${quote.status}` }, { status: 409 });
+  }
+
+  const updated = await db.completeQuote(quote.id, result);
+  if (!updated) {
+    return Response.json({ error: "quote is already completed" }, { status: 409 });
+  }
+  return Response.json({ ok: true });
+}
