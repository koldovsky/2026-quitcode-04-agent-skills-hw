@@ -0,0 +1,36 @@
+import { revalidatePath } from "next/cache";
+import { db } from "@/lib/db";
+
+export async function POST(request: Request) {
+  const secret = request.headers.get("x-webhook-secret");
+  if (!secret || secret !== process.env.N8N_CALLBACK_SECRET) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+
+  const { quoteId, status, pdfUrl, errorMessage } = (body ?? {}) as Record<string, unknown>;
+
+  if (typeof quoteId !== "string" || (status !== "ready" && status !== "error")) {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  const quote = await db.getQuoteRequest(quoteId);
+  if (!quote) {
+    return Response.json({ error: "not found" }, { status: 404 });
+  }
+
+  await db.updateQuoteRequestStatus(quoteId, status, {
+    pdfUrl: typeof pdfUrl === "string" ? pdfUrl : null,
+    errorMessage: typeof errorMessage === "string" ? errorMessage : null,
+  });
+
+  revalidatePath(`/quotes/${quoteId}`);
+
+  return Response.json({ ok: true });
+}
