+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { startQuoteWorkflow } from "@/lib/n8n";
+import { parseQuoteForm, type QuoteFormField, type QuoteFormValues } from "@/lib/quote-form";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues }
+  | { status: "error"; message: string; values: QuoteFormValues };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: parsed.values };
+  }
+
+  // The row must exist before the trigger: n8n's callback looks it up by id.
+  const quote = await db.insertQuoteRequest(parsed.data);
+
+  // The workflow runs for 40-90 s, so only its start is awaited here; the result
+  // arrives at /api/quotes/callback and /quotes/[id] shows the status meanwhile.
+  if (await startQuoteWorkflow(quote)) {
+    await db.updateQuoteStatus(quote.id, "processing");
+    redirect(`/quotes/${quote.id}`);
+  }
+
+  await db.updateQuoteStatus(quote.id, "failed");
+  return {
+    status: "error",
+    message: "Не вдалося передати запит на обробку. Спробуйте ще раз за кілька хвилин.",
+    values: parsed.values,
+  };
+}
