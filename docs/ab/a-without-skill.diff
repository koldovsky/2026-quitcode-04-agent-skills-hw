--- /dev/null
+++ b/components/quote-status-refresher.tsx
@@ -0,0 +1,28 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useEffect } from "react";
+
+const POLL_INTERVAL_MS = 3000;
+// The workflow takes 40-90 s; a forgotten tab should not poll the server forever.
+const POLL_LIMIT_MS = 10 * 60 * 1000;
+
+// Renders nothing: re-renders the server component every few seconds while a quote is
+// still being prepared. The page stops rendering it once the status is final.
+export function QuoteStatusRefresher() {
+  const router = useRouter();
+
+  useEffect(() => {
+    const startedAt = Date.now();
+    const timer = setInterval(() => {
+      if (Date.now() - startedAt > POLL_LIMIT_MS) {
+        clearInterval(timer);
+      } else if (document.visibilityState === "visible") {
+        router.refresh();
+      }
+    }, POLL_INTERVAL_MS);
+    return () => clearInterval(timer);
+  }, [router]);
+
+  return null;
+}
