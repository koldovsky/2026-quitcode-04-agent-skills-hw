@@ -0,0 +1,82 @@
+import { db } from "@/lib/db";
+import { parseQuoteCallback, verifyCallbackSignature } from "@/lib/n8n";
+
+// Called by the n8n workflow "quote-request" when the PDF quote is ready (or has failed).
+// The contract is described in lib/n8n.ts.
+//
+// Status codes are chosen for n8n's "Retry On Fail": a 5xx is retried, so it is reserved
+// for problems that can go away (missing configuration, database). Bad input gets a 4xx.
+// A repeated delivery of an already applied event is a success, not an error.
+
+const MAX_BODY_BYTES = 16 * 1024;
+
+// Reads the body without ever holding more than maxBytes; null means "too large".
+async function readBody(request: Request, maxBytes: number): Promise<Buffer | null> {
+  if (Number(request.headers.get("content-length")) > maxBytes) return null;
+
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  const reader = request.body?.getReader();
+  while (reader) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    size += value.byteLength;
+    if (size > maxBytes) {
+      await reader.cancel();
+      return null;
+    }
+    chunks.push(value);
+  }
+  return Buffer.concat(chunks);
+}
+
+export async function POST(request: Request) {
+  const secret = process.env.N8N_CALLBACK_SECRET;
+  if (!secret) {
+    console.error("Quote callback rejected: N8N_CALLBACK_SECRET is not set");
+    return Response.json({ error: "callback is not configured" }, { status: 503 });
+  }
+
+  const timestamp = request.headers.get("x-n8n-timestamp");
+  const signature = request.headers.get("x-n8n-signature");
+  if (!timestamp || !signature) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const body = await readBody(request, MAX_BODY_BYTES);
+  if (!body) {
+    return Response.json({ error: "payload too large" }, { status: 413 });
+  }
+
+  const check = verifyCallbackSignature({ secret, timestamp, signature, body });
+  if (check !== "ok") {
+    console.warn(`Quote callback rejected: signature ${check}`);
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  let payload: unknown;
+  try {
+    payload = JSON.parse(body.toString("utf8"));
+  } catch {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  const callback = parseQuoteCallback(payload);
+  if (!callback) {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+  if (callback.outcome === "ignored") {
+    return Response.json({ ok: true, ignored: true });
+  }
+
+  const result =
+    callback.outcome === "ready"
+      ? await db.updateQuoteStatus(callback.quoteId, "ready", callback.documentUrl)
+      : await db.updateQuoteStatus(callback.quoteId, "failed");
+
+  if (result === "not_found") {
+    console.warn("Quote callback for an unknown quote request");
+    return Response.json({ error: "unknown quote request" }, { status: 404 });
+  }
+  return Response.json({ ok: true, updated: result === "updated" });
+}
