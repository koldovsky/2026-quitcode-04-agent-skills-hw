@@ -0,0 +1,73 @@
+import type { Quote } from "./types";
+
+// The `quote-request` workflow in n8n needs 40–90 s to prepare the PDF, so nothing here
+// waits for it. The Server Action only waits (briefly) for n8n to acknowledge the webhook;
+// the result arrives later, when the workflow calls POST /api/quotes/[id]/callback.
+const ACK_TIMEOUT_MS = 10_000;
+
+// The workflow normally finishes within 90 s. A quote still pending after this long
+// is shown as "taking longer than usual" instead of spinning silently.
+const STALE_AFTER_MS = 5 * 60 * 1000;
+
+export type TriggerResult =
+  | { status: "accepted" }
+  // No answer within ACK_TIMEOUT_MS. n8n may have started the run anyway, so the quote stays pending.
+  | { status: "unconfirmed" }
+  | { status: "failed" };
+
+export function isQuoteStale(quote: Quote) {
+  return quote.status === "pending" && Date.now() - Date.parse(quote.createdAt) > STALE_AFTER_MS;
+}
+
+function callbackUrlFor(quoteId: string) {
+  // Only from configuration: a URL built from the request's Host header could be spoofed
+  // into pointing n8n (and the callback secret it sends) at a foreign server.
+  const base = process.env.APP_BASE_URL;
+  return base ? new URL(`/api/quotes/${quoteId}/callback`, base).toString() : undefined;
+}
+
+// Log the error type only: messages of failed requests can contain the webhook URL.
+function describeError(error: unknown) {
+  if (!(error instanceof Error)) return "unknown error";
+  const code = (error.cause as { code?: string } | undefined)?.code;
+  return code ? `${error.name}, ${code}` : error.name;
+}
+
+export async function triggerQuoteWorkflow(quote: Quote): Promise<TriggerResult> {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  if (!webhookUrl) {
+    console.error(`Quote ${quote.id}: N8N_QUOTE_WEBHOOK_URL is not set`);
+    return { status: "failed" };
+  }
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl: callbackUrlFor(quote.id),
+      }),
+      signal: AbortSignal.timeout(ACK_TIMEOUT_MS),
+    });
+    // The answer's body is not needed; release the connection.
+    response.body?.cancel().catch(() => {});
+
+    if (!response.ok) {
+      console.error(`Quote ${quote.id}: n8n webhook answered ${response.status}`);
+      return { status: "failed" };
+    }
+    return { status: "accepted" };
+  } catch (error) {
+    if (error instanceof Error && error.name === "TimeoutError") {
+      console.error(`Quote ${quote.id}: n8n did not acknowledge the webhook within ${ACK_TIMEOUT_MS} ms`);
+      return { status: "unconfirmed" };
+    }
+    console.error(`Quote ${quote.id}: could not start the n8n workflow (${describeError(error)})`);
+    return { status: "failed" };
+  }
+}
