@@ -0,0 +1,82 @@
+import { createHash, timingSafeEqual } from "node:crypto";
+import { revalidatePath } from "next/cache";
+import type { NextRequest } from "next/server";
+import { db } from "@/lib/db";
+
+// Called by the n8n `quote-request` workflow when the PDF is ready (or failed):
+//   POST /api/quotes/<id>/callback
+//   Authorization: Bearer <N8N_CALLBACK_SECRET>
+//   { "status": "ready", "pdfUrl": "https://…" } | { "status": "failed", "error": "…" }
+
+const MAX_BODY_BYTES = 10_000;
+
+function isAuthorized(request: NextRequest) {
+  const secret = process.env.N8N_CALLBACK_SECRET;
+  if (!secret) return false;
+  const header = request.headers.get("authorization") ?? "";
+  const token = header.startsWith("Bearer ") ? header.slice("Bearer ".length) : "";
+  // Hash both sides so timingSafeEqual gets equal-length buffers.
+  const digest = (value: string) => createHash("sha256").update(value).digest();
+  return timingSafeEqual(digest(token), digest(secret));
+}
+
+function parsePdfUrl(value: unknown) {
+  if (typeof value !== "string" || value.length > 2000) return null;
+  try {
+    const url = new URL(value);
+    // The URL is rendered as a link, so only web protocols are accepted.
+    const allowHttp = process.env.NODE_ENV !== "production";
+    if (url.protocol === "https:" || (allowHttp && url.protocol === "http:")) return url.toString();
+  } catch {}
+  return null;
+}
+
+type CallbackResult =
+  | { status: "ready"; pdfUrl: string }
+  | { status: "failed"; error: string };
+
+function parseBody(body: unknown): CallbackResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+  if (status === "ready") {
+    const url = parsePdfUrl(pdfUrl);
+    return url ? { status, pdfUrl: url } : null;
+  }
+  if (status === "failed") {
+    return { status, error: typeof error === "string" && error.trim() ? error.trim().slice(0, 500) : "Невідома помилка" };
+  }
+  return null;
+}
+
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  if (!isAuthorized(request)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const raw = await request.text();
+  if (raw.length > MAX_BODY_BYTES) {
+    return Response.json({ error: "payload too large" }, { status: 413 });
+  }
+
+  let result: CallbackResult | null = null;
+  try {
+    result = parseBody(JSON.parse(raw));
+  } catch {}
+  if (!result) {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  const { id } = await ctx.params;
+  const quote = await db.getQuote(id);
+  if (!quote) {
+    return Response.json({ error: "quote not found" }, { status: 404 });
+  }
+
+  if (!(await db.completeQuote(id, result))) {
+    // Already final: a retried callback is not an error for n8n, but it changes nothing.
+    return Response.json({ ok: true, status: quote.status, changed: false });
+  }
+
+  revalidatePath(`/quotes/${id}`);
+  return Response.json({ ok: true, status: result.status, changed: true });
+}
