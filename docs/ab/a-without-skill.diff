+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { AutoRefresh } from "@/components/auto-refresh";
+import { isFinalStatus, quotes, QUOTE_BUDGET_OPTIONS, type QuoteStatus } from "@/lib/quotes";
+
+// The workflow usually takes 40–90 s; after this we tell the user it's running late.
+const SLOW_AFTER_MS = 3 * 60 * 1000;
+const POLL_INTERVAL_MS = 5000;
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+const STATUS_LABELS: Record<QuoteStatus, { label: string; className: string }> = {
+  pending: { label: "У черзі", className: "bg-slate-100 text-slate-700" },
+  processing: { label: "Готуємо кошторис", className: "bg-amber-100 text-amber-800" },
+  ready: { label: "Готово", className: "bg-emerald-100 text-emerald-800" },
+  failed: { label: "Помилка", className: "bg-red-100 text-red-800" },
+};
+
+function isRunningLate(createdAt: string) {
+  return Date.now() - Date.parse(createdAt) > SLOW_AFTER_MS;
+}
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = quotes.get(id);
+  if (!quote) notFound();
+
+  const done = isFinalStatus(quote.status);
+  const isSlow = !done && isRunningLate(quote.createdAt);
+  const status = STATUS_LABELS[quote.status];
+  const budgetLabel = QUOTE_BUDGET_OPTIONS.find((o) => o.value === String(quote.budget ?? ""))?.label ?? "—";
+
+  return (
+    <main className="mx-auto w-full max-w-2xl flex-1 space-y-6 px-6 py-12">
+      {!done && <AutoRefresh intervalMs={POLL_INTERVAL_MS} />}
+
+      <div className="flex items-start justify-between gap-4">
+        <div>
+          <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+          <p className="text-sm text-slate-500">Створено {dateTimeFormat.format(new Date(quote.createdAt))}</p>
+        </div>
+        <span className={`rounded-full px-3 py-1 text-xs font-medium ${status.className}`}>{status.label}</span>
+      </div>
+
+      <section className="rounded-lg border border-slate-200 bg-white p-5 text-sm" aria-live="polite">
+        {!done && (
+          <div className="space-y-1">
+            <p className="font-medium">Готуємо PDF-кошторис…</p>
+            <p className="text-slate-600">
+              {isSlow
+                ? "Це займає довше, ніж зазвичай. Сторінку можна залишити відкритою або повернутися пізніше за цим посиланням."
+                : "Зазвичай це 1–2 хвилини. Сторінка оновиться сама."}
+            </p>
+          </div>
+        )}
+        {quote.status === "ready" && quote.pdfUrl && (
+          <div className="space-y-3">
+            <p className="font-medium">Кошторис готовий.</p>
+            <a
+              href={quote.pdfUrl}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="inline-block rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700"
+            >
+              Завантажити PDF
+            </a>
+          </div>
+        )}
+        {quote.status === "failed" && (
+          <div className="space-y-2">
+            <p className="font-medium">Не вдалося підготувати кошторис.</p>
+            <p className="text-slate-600">
+              Ми вже знаємо про проблему. Спробуйте{" "}
+              <Link href="/quotes/new" className="text-indigo-600 hover:underline">
+                надіслати запит ще раз
+              </Link>{" "}
+              або напишіть нам.
+            </p>
+          </div>
+        )}
+      </section>
+
+      <dl className="grid grid-cols-1 gap-x-6 gap-y-3 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2">
+        <div>
+          <dt className="text-slate-500">Email</dt>
+          <dd className="font-medium break-words">{quote.email}</dd>
+        </div>
+        <div>
+          <dt className="text-slate-500">Бюджет</dt>
+          <dd className="font-medium">{budgetLabel}</dd>
+        </div>
+        <div className="sm:col-span-2">
+          <dt className="text-slate-500">Опис задачі</dt>
+          <dd className="whitespace-pre-line text-slate-700">{quote.description}</dd>
+        </div>
+      </dl>
+    </main>
+  );
+}
