+import { db } from "@/lib/db";
+import { isValidCallbackToken } from "@/lib/quotes";
+import type { QuoteResult } from "@/lib/types";
+
+// Called by the n8n quote-request workflow when it finishes:
+//   POST /api/quotes/<id>/callback
+//   Authorization: Bearer <callback.token from the trigger payload>
+//   { "status": "ready", "pdfUrl": "https://…" } or { "status": "failed", "error": "…" }
+export async function POST(request: Request, { params }: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await params;
+
+  const token = request.headers.get("authorization")?.match(/^Bearer (.+)$/)?.[1];
+  const quote = await db.getQuote(id);
+  // Same answer for an unknown quote and a wrong token, so ids cannot be probed.
+  if (!quote || !token || !isValidCallbackToken(quote, token)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return Response.json({ error: "invalid JSON" }, { status: 400 });
+  }
+
+  const result = parseResult(body);
+  if (!result) {
+    return Response.json({ error: "expected { status: 'ready', pdfUrl } or { status: 'failed', error }" }, { status: 400 });
+  }
+
+  const updated = await db.completeQuote(quote.id, result);
+  if (!updated) {
+    return Response.json({ error: "quote already completed" }, { status: 409 });
+  }
+
+  return Response.json({ ok: true });
+}
+
+function parseResult(body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready" && typeof pdfUrl === "string") {
+    // Only http(s) links end up in the page's <a href>, never javascript: etc.
+    try {
+      const url = new URL(pdfUrl);
+      if (url.protocol === "https:" || url.protocol === "http:") return { status, pdfUrl: url.toString() };
+    } catch {}
+    return null;
+  }
+
+  if (status === "failed") {
+    const message = typeof error === "string" && error.trim() ? error.trim().slice(0, 500) : "Невідома помилка";
+    return { status, error: message };
+  }
+
+  return null;
+}
