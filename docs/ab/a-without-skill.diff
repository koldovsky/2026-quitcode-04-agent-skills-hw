+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusPoller } from "@/components/quote-status-poller";
+import { getQuote } from "@/lib/data";
+import { getQuoteProgress } from "@/lib/quotes";
+
+// Anyone with the link sees this page, so it shows no email and stays out of search engines.
+export const metadata = { title: "Кошторис · Studio Nova", robots: { index: false, follow: false } };
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await getQuote(id);
+  if (!quote) notFound();
+
+  const { stale, polling } = getQuoteProgress(quote);
+
+  return (
+    <div className="flex flex-1 flex-col">
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
+          <Link href="/" className="text-lg font-semibold tracking-tight">
+            Studio Nova
+          </Link>
+        </div>
+      </header>
+
+      <main className="mx-auto w-full max-w-2xl flex-1 space-y-6 px-6 py-12">
+        <div>
+          <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+          <p className="text-sm text-slate-500">
+            Запит від {dateTimeFormat.format(new Date(quote.createdAt))}
+          </p>
+        </div>
+
+        <section aria-live="polite" className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
+          {quote.status === "processing" && (
+            <div className="space-y-2">
+              <p className="flex items-center gap-2 font-medium">
+                <span className="h-2.5 w-2.5 animate-pulse rounded-full bg-indigo-500" aria-hidden />
+                Готуємо кошторис…
+              </p>
+              {stale ? (
+                <p className="text-sm text-amber-700">
+                  Це займає довше, ніж зазвичай. {polling
+                    ? "Сторінка оновиться, щойно кошторис буде готовий."
+                    : "Оновіть сторінку пізніше або напишіть нам."}
+                </p>
+              ) : (
+                <p className="text-sm text-slate-600">
+                  Зазвичай це 40–90 секунд. Сторінка оновиться сама — її можна не перезавантажувати.
+                </p>
+              )}
+            </div>
+          )}
+
+          {quote.status === "ready" && quote.pdfUrl && (
+            <div className="space-y-3">
+              <p className="font-medium text-emerald-700">Кошторис готовий.</p>
+              <a
+                href={quote.pdfUrl}
+                target="_blank"
+                rel="noopener noreferrer"
+                className="inline-flex rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
+              >
+                Завантажити PDF
+              </a>
+            </div>
+          )}
+
+          {quote.status === "failed" && (
+            <div className="space-y-3">
+              <p className="font-medium text-red-700">Не вдалося підготувати кошторис.</p>
+              <p className="text-sm text-slate-600">
+                Спробуйте надіслати запит ще раз — або менеджер зв&apos;яжеться з вами напряму.
+              </p>
+              <Link href="/quotes/new" className="inline-flex text-sm font-medium text-indigo-600 hover:text-indigo-800">
+                Новий запит →
+              </Link>
+            </div>
+          )}
+        </section>
+
+        <section className="space-y-2 rounded-xl border border-slate-200 bg-white p-6 text-sm">
+          <h2 className="font-medium">Опис задачі</h2>
+          <p className="whitespace-pre-line text-slate-700">{quote.description}</p>
+        </section>
+
+        <QuoteStatusPoller active={polling} />
+      </main>
+    </div>
+  );
+}
