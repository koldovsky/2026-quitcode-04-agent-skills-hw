@@ -0,0 +1,37 @@
+"use server";
+
+import { randomBytes } from "node:crypto";
+import { redirect } from "next/navigation";
+import { after } from "next/server";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+import { startQuoteWorkflow } from "@/lib/quote-workflow";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | {
+      status: "invalid";
+      errors: Partial<Record<QuoteFormField, string>>;
+      values: Partial<Record<QuoteFormField, string>>;
+    };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: parsed.values };
+  }
+
+  const quote = await db.insertQuote({
+    ...parsed.data,
+    callbackToken: randomBytes(32).toString("base64url"),
+  });
+
+  // The workflow takes 40–90 s, so the visitor goes straight to the status page
+  // and the webhook call runs after the response is sent.
+  after(() => startQuoteWorkflow(quote));
+
+  redirect(`/quotes/${quote.id}`);
+}
