+"use client";
+
+import { useActionState } from "react";
+import { requestQuote, type RequestQuoteState } from "@/app/quotes/actions";
+
+const initialState: RequestQuoteState = { status: "idle" };
+
+const inputClass =
+  "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500";
+
+export function QuoteForm() {
+  const [state, formAction, pending] = useActionState(requestQuote, initialState);
+  const errors = state.status === "invalid" ? state.errors : {};
+  // React clears the form after an action, so the typed values are sent back by the server.
+  const values = state.status === "idle" ? undefined : state.values;
+
+  return (
+    <form action={formAction} className="space-y-4" noValidate>
+      <div className="grid gap-4 sm:grid-cols-2">
+        <label className="block text-sm font-medium">
+          Компанія
+          <input
+            name="company"
+            autoComplete="organization"
+            defaultValue={values?.company}
+            maxLength={120}
+            className={inputClass}
+          />
+          {errors.company && <span className="mt-1 block text-xs text-red-600">{errors.company}</span>}
+        </label>
+        <label className="block text-sm font-medium">
+          Email
+          <input
+            name="email"
+            type="email"
+            autoComplete="email"
+            defaultValue={values?.email}
+            maxLength={200}
+            className={inputClass}
+          />
+          {errors.email && <span className="mt-1 block text-xs text-red-600">{errors.email}</span>}
+        </label>
+      </div>
+
+      <label className="block text-sm font-medium">
+        Опис задачі
+        <textarea
+          name="description"
+          rows={5}
+          defaultValue={values?.description}
+          maxLength={2000}
+          className={inputClass}
+        />
+        {errors.description && <span className="mt-1 block text-xs text-red-600">{errors.description}</span>}
+      </label>
+
+      <label className="block text-sm font-medium">
+        Орієнтовний бюджет, $ <span className="font-normal text-slate-500">(необов&apos;язково)</span>
+        <input
+          name="budget"
+          inputMode="numeric"
+          placeholder="наприклад, 3000"
+          defaultValue={values?.budget}
+          className={inputClass}
+        />
+        {errors.budget && <span className="mt-1 block text-xs text-red-600">{errors.budget}</span>}
+      </label>
+
+      {state.status === "error" && (
+        <p role="alert" className="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
+          {state.message}
+        </p>
+      )}
+
+      <button
+        type="submit"
+        disabled={pending}
+        className="w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 disabled:opacity-60"
+      >
+        {pending ? "Надсилаємо…" : "Отримати кошторис"}
+      </button>
+    </form>
+  );
+}
