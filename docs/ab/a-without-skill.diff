+++ b/lib/quotes.ts
@@ -0,0 +1,116 @@
+import { randomUUID } from "node:crypto";
+
+// Quote requests live in memory next to the rest of the demo data (see lib/db.ts).
+
+export const QUOTE_STATUSES = ["pending", "processing", "ready", "failed"] as const;
+export type QuoteStatus = (typeof QUOTE_STATUSES)[number];
+
+export type Quote = {
+  id: string;
+  company: string;
+  email: string;
+  description: string;
+  budget: number | null;
+  status: QuoteStatus;
+  pdfUrl: string | null;
+  error: string | null;
+  createdAt: string;
+  updatedAt: string;
+};
+
+export type NewQuote = Pick<Quote, "company" | "email" | "description" | "budget">;
+
+type QuoteStore = { quotes: Map<string, Quote> };
+
+const globalForQuotes = globalThis as unknown as { leadDeskQuotes?: QuoteStore };
+const store = (globalForQuotes.leadDeskQuotes ??= { quotes: new Map() });
+
+export const quotes = {
+  insert(input: NewQuote): Quote {
+    const now = new Date().toISOString();
+    // /quotes/[id] is public, so the id must be unguessable.
+    const quote: Quote = {
+      ...input,
+      id: `q_${randomUUID()}`,
+      status: "pending",
+      pdfUrl: null,
+      error: null,
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.quotes.set(quote.id, quote);
+    return structuredClone(quote);
+  },
+
+  get(id: string): Quote | null {
+    const quote = store.quotes.get(id);
+    return quote ? structuredClone(quote) : null;
+  },
+
+  update(id: string, patch: Partial<Pick<Quote, "status" | "pdfUrl" | "error">>): Quote | null {
+    const quote = store.quotes.get(id);
+    if (!quote) return null;
+    Object.assign(quote, patch, { updatedAt: new Date().toISOString() });
+    return structuredClone(quote);
+  },
+};
+
+export function isFinalStatus(status: QuoteStatus) {
+  return status === "ready" || status === "failed";
+}
+
+// ---------------------------------------------------------------------------
+// Form parsing
+// ---------------------------------------------------------------------------
+
+export const QUOTE_BUDGET_OPTIONS = [
+  { value: "", label: "Ще не визначились" },
+  { value: "1000", label: "до $1 000" },
+  { value: "3000", label: "$1 000–3 000" },
+  { value: "10000", label: "$3 000–10 000" },
+  { value: "25000", label: "понад $10 000" },
+] as const;
+
+export type QuoteFormField = "company" | "email" | "description" | "budget";
+
+export type QuoteFormValues = Record<QuoteFormField, string>;
+
+export type QuoteParseResult =
+  | { ok: true; data: NewQuote }
+  | { ok: false; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues };
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function text(formData: FormData, name: QuoteFormField, max: number) {
+  const value = formData.get(name);
+  return typeof value === "string" ? value.trim().slice(0, max) : "";
+}
+
+export function parseQuoteForm(formData: FormData): QuoteParseResult {
+  const values: QuoteFormValues = {
+    company: text(formData, "company", 120),
+    email: text(formData, "email", 200).toLowerCase(),
+    description: text(formData, "description", 4000),
+    budget: text(formData, "budget", 10),
+  };
+
+  const errors: Partial<Record<QuoteFormField, string>> = {};
+  if (!values.company) errors.company = "Вкажіть назву компанії";
+  if (!EMAIL_RE.test(values.email)) errors.email = "Перевірте email";
+  if (values.description.length < 20) errors.description = "Опишіть задачу детальніше (від 20 символів)";
+  if (values.budget && !QUOTE_BUDGET_OPTIONS.some((option) => option.value === values.budget)) {
+    errors.budget = "Оберіть бюджет зі списку";
+  }
+
+  if (Object.keys(errors).length > 0) return { ok: false, errors, values };
+
+  return {
+    ok: true,
+    data: {
+      company: values.company,
+      email: values.email,
+      description: values.description,
+      budget: values.budget ? Number(values.budget) : null,
+    },
+  };
+}
