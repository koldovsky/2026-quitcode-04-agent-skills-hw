+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField, type QuoteFormValues } from "@/lib/quote-form";
+import { createCallbackToken, startQuoteWorkflow } from "@/lib/quotes";
+
+const PUBLIC_FORM_WORKSPACE_ID = "ws_studio_nova";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues }
+  | { status: "error"; message: string; values: QuoteFormValues };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: parsed.values };
+  }
+
+  const callback = createCallbackToken();
+  const quote = await db.insertQuote({
+    ...parsed.data,
+    workspaceId: PUBLIC_FORM_WORKSPACE_ID,
+    callbackTokenHash: callback.hash,
+  });
+
+  // Only the start is awaited (n8n answers right away); the result arrives at the callback route.
+  const started = await startQuoteWorkflow(quote, callback.token);
+  if (!started.ok) {
+    console.error("quote.start_failed", { quoteId: quote.id, reason: started.reason });
+    await db.settleQuote(quote.id, { status: "failed" });
+    return {
+      status: "error",
+      message: "Не вдалося надіслати запит. Спробуйте ще раз за хвилину.",
+      values: {
+        company: parsed.data.company,
+        email: parsed.data.email,
+        description: parsed.data.description,
+        budget: parsed.data.budget === null ? "" : String(parsed.data.budget),
+      },
+    };
+  }
+
+  redirect(`/quotes/${quote.id}`);
+}
