+++ b/lib/n8n.ts
@@ -0,0 +1,153 @@
+import { createHmac, timingSafeEqual } from "node:crypto";
+import type { QuoteRequest } from "./types";
+
+// Integration with the n8n workflow "quote-request" (prepares a PDF quote, 40-90 s).
+//
+// The workflow is asynchronous, so nothing here waits for it:
+//   1. startQuoteWorkflow() POSTs the request to the workflow's Webhook node. That node must
+//      answer at once (Respond: Immediately, or an early Respond to Webhook node) and the
+//      URL must be the production one (/webhook/...): /webhook-test/... works only while
+//      the editor is listening.
+//   2. When the PDF is ready, an HTTP Request node at the end of the workflow POSTs a signed
+//      callback to /api/quotes/callback (app/api/quotes/callback/route.ts).
+//
+// Callback contract (the same one tools/mock-n8n.mjs sends):
+//   headers  x-n8n-timestamp  unix seconds
+//            x-n8n-signature  sha256=<hex HMAC-SHA256(N8N_CALLBACK_SECRET, "<timestamp>.<raw body>")>
+//   body     { "version": 1,
+//              "event": "quote-request.completed" | "quote-request.failed",
+//              "data": { "correlationId": "<quote id>", "result": { "documentUrl": "https://..." } } }
+// correlationId is the x-correlation-id header of the trigger request; the workflow echoes it.
+
+export const QUOTE_CALLBACK_PATH = "/api/quotes/callback";
+
+const EVENT_COMPLETED = "quote-request.completed";
+const EVENT_FAILED = "quote-request.failed";
+const TRIGGER_TIMEOUT_MS = 10_000;
+const CALLBACK_TOLERANCE_S = 5 * 60;
+
+// Errors are reduced to a name and code on purpose: a full fetch error can carry the
+// webhook URL, and n8n webhook paths are often treated as secrets.
+function describeError(error: unknown) {
+  if (!(error instanceof Error)) return "unknown error";
+  const code = (error.cause as { code?: string } | undefined)?.code;
+  return code ? `${error.name} (${code})` : error.name;
+}
+
+// Hands a quote request to n8n. Resolves to true once n8n has accepted it (any 2xx);
+// the outcome arrives later as a callback. Never throws.
+export async function startQuoteWorkflow(quote: QuoteRequest): Promise<boolean> {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appBaseUrl = process.env.APP_BASE_URL;
+  const missing = [
+    !webhookUrl && "N8N_QUOTE_WEBHOOK_URL",
+    !appBaseUrl && "APP_BASE_URL",
+  ].filter(Boolean);
+  if (!webhookUrl || !appBaseUrl) {
+    console.error(`Quote ${quote.id} was not sent to n8n: ${missing.join(", ")} not set`);
+    return false;
+  }
+
+  // The callback address comes from configuration, never from the incoming request's Host.
+  let callbackUrl: string;
+  try {
+    callbackUrl = new URL(QUOTE_CALLBACK_PATH, appBaseUrl).toString();
+  } catch {
+    console.error(`Quote ${quote.id} was not sent to n8n: APP_BASE_URL is not a valid URL`);
+    return false;
+  }
+
+  const headers: Record<string, string> = {
+    "content-type": "application/json",
+    "idempotency-key": `quote-request:${quote.id}`,
+    "x-correlation-id": quote.id,
+  };
+  const token = process.env.N8N_WEBHOOK_TOKEN;
+  if (token) headers["x-n8n-token"] = token;
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers,
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl,
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+      // Custom headers (x-n8n-token) would follow a cross-origin redirect.
+      redirect: "error",
+    });
+    await response.body?.cancel();
+    if (!response.ok) {
+      console.error(`n8n rejected quote ${quote.id}: HTTP ${response.status}`);
+      return false;
+    }
+    return true;
+  } catch (error) {
+    console.error(`Failed to send quote ${quote.id} to n8n: ${describeError(error)}`);
+    return false;
+  }
+}
+
+export type SignatureCheck = "ok" | "malformed" | "stale" | "mismatch";
+
+// Checks the HMAC over the exact bytes n8n sent, not over re-serialized JSON.
+export function verifyCallbackSignature(input: {
+  secret: string;
+  timestamp: string;
+  signature: string;
+  body: Buffer;
+  nowMs?: number;
+}): SignatureCheck {
+  if (!/^[0-9]{1,12}$/.test(input.timestamp)) return "malformed";
+  const match = /^sha256=([0-9a-f]{64})$/i.exec(input.signature);
+  if (!match) return "malformed";
+
+  const nowMs = input.nowMs ?? Date.now();
+  if (Math.abs(nowMs / 1000 - Number(input.timestamp)) > CALLBACK_TOLERANCE_S) return "stale";
+
+  const expected = createHmac("sha256", input.secret)
+    .update(`${input.timestamp}.`)
+    .update(input.body)
+    .digest();
+  return timingSafeEqual(expected, Buffer.from(match[1], "hex")) ? "ok" : "mismatch";
+}
+
+export type QuoteCallback =
+  | { outcome: "ready"; quoteId: string; documentUrl: string }
+  | { outcome: "failed"; quoteId: string }
+  | { outcome: "ignored" };
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+// The link ends up in an href, so only a plain https URL is accepted.
+function parseDocumentUrl(value: unknown) {
+  if (typeof value !== "string" || value.length > 2048) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
+
+// Returns null when the (already authenticated) payload does not match the contract.
+export function parseQuoteCallback(payload: unknown): QuoteCallback | null {
+  if (!isRecord(payload) || payload.version !== 1 || typeof payload.event !== "string") return null;
+  if (payload.event !== EVENT_COMPLETED && payload.event !== EVENT_FAILED) return { outcome: "ignored" };
+
+  const data = payload.data;
+  if (!isRecord(data) || typeof data.correlationId !== "string" || data.correlationId.length > 64) return null;
+  const quoteId = data.correlationId;
+
+  if (payload.event === EVENT_FAILED) return { outcome: "failed", quoteId };
+
+  const documentUrl = isRecord(data.result) ? parseDocumentUrl(data.result.documentUrl) : null;
+  return documentUrl ? { outcome: "ready", quoteId, documentUrl } : null;
+}
