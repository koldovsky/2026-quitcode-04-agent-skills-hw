+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import type { QuoteRequest, QuoteResult } from "./types";
+
+// Contract with the n8n workflow "quote-request":
+//
+// 1. LeadDesk POSTs the request to N8N_QUOTE_WEBHOOK_URL. The Webhook node must respond
+//    immediately: the workflow itself runs for 40–90 s, far longer than a form submit may wait.
+// 2. When the PDF is ready (or the workflow gives up), n8n POSTs to `callbackUrl` with
+//    `Authorization: Bearer <callbackToken>` and a JSON body:
+//      { "status": "ready", "pdfUrl": "https://…/quote.pdf" }   or   { "status": "failed" }
+
+const START_TIMEOUT_MS = 10_000;
+
+// n8n gets the token itself; LeadDesk stores only its hash.
+export function createCallbackToken() {
+  const token = randomBytes(32).toString("base64url");
+  return { token, hash: hashToken(token).toString("hex") };
+}
+
+function hashToken(token: string) {
+  return createHash("sha256").update(token).digest();
+}
+
+export function isValidCallbackToken(authorization: string | null, quote: QuoteRequest) {
+  const token = authorization?.match(/^Bearer\s+(\S+)$/i)?.[1];
+  if (!token) return false;
+  // Both sides are SHA-256 digests, so the lengths always match as timingSafeEqual requires.
+  return timingSafeEqual(hashToken(token), Buffer.from(quote.callbackTokenHash, "hex"));
+}
+
+// `reason` is safe to log: never the error message, which can quote the webhook URL (a credential).
+export type StartQuoteResult = { ok: true } | { ok: false; reason: string };
+
+export async function startQuoteWorkflow(quote: QuoteRequest, callbackToken: string): Promise<StartQuoteResult> {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appUrl = process.env.APP_URL;
+  if (!webhookUrl || !appUrl) return { ok: false, reason: "not_configured" };
+
+  let response: Response;
+  try {
+    response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl: new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString(),
+        callbackToken,
+      }),
+      signal: AbortSignal.timeout(START_TIMEOUT_MS),
+    });
+  } catch (error) {
+    return { ok: false, reason: error instanceof Error ? error.name : "unknown" };
+  }
+  return response.ok ? { ok: true } : { ok: false, reason: `http_${response.status}` };
+}
+
+export type QuoteCallbackParseResult = { ok: true; data: QuoteResult } | { ok: false; error: string };
+
+export function parseQuoteCallback(body: unknown): QuoteCallbackParseResult {
+  if (typeof body !== "object" || body === null) return { ok: false, error: "body must be a JSON object" };
+  const { status, pdfUrl } = body as Record<string, unknown>;
+
+  if (status === "failed") return { ok: true, data: { status: "failed" } };
+  if (status !== "ready") return { ok: false, error: 'status must be "ready" or "failed"' };
+
+  // The URL ends up in an <a href> on a public page: only plain web links, never javascript: etc.
+  const url = typeof pdfUrl === "string" && pdfUrl.length <= 2000 && URL.canParse(pdfUrl) ? new URL(pdfUrl) : null;
+  const allowHttp = process.env.NODE_ENV !== "production";
+  if (!url || !(url.protocol === "https:" || (allowHttp && url.protocol === "http:"))) {
+    return { ok: false, error: "pdfUrl must be an https URL" };
+  }
+  return { ok: true, data: { status: "ready", pdfUrl: url.toString() } };
+}
