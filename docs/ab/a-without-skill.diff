@@ -0,0 +1,21 @@
+"use client";
+
+import { useEffect } from "react";
+import { useRouter } from "next/navigation";
+
+const POLL_INTERVAL_MS = 5000;
+
+// Re-renders the server page while the quote is processing; the server decides when to stop.
+export function QuoteStatusPoller({ active }: { active: boolean }) {
+  const router = useRouter();
+
+  useEffect(() => {
+    if (!active) return;
+    const timer = setInterval(() => {
+      if (document.visibilityState === "visible") router.refresh();
+    }, POLL_INTERVAL_MS);
+    return () => clearInterval(timer);
+  }, [active, router]);
+
+  return null;
+}
