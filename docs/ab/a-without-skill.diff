+import { revalidatePath } from "next/cache";
+import { NextResponse, type NextRequest } from "next/server";
+import { db } from "@/lib/db";
+
+type CallbackBody = {
+  status?: unknown;
+  pdfUrl?: unknown;
+  error?: unknown;
+};
+
+// Викликається n8n-воркфлоу `quote-request`, коли PDF-кошторис готовий (або впав).
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const secret = process.env.N8N_CALLBACK_SECRET;
+  if (secret && request.headers.get("x-n8n-secret") !== secret) {
+    return NextResponse.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const { id } = await ctx.params;
+  const body: CallbackBody | null = await request.json().catch(() => null);
+  if (!body || (body.status !== "ready" && body.status !== "failed")) {
+    return NextResponse.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  const updated = await db.updateQuoteRequestResult(id, {
+    status: body.status,
+    pdfUrl: typeof body.pdfUrl === "string" ? body.pdfUrl : null,
+    error: typeof body.error === "string" ? body.error : null,
+  });
+
+  if (!updated) {
+    return NextResponse.json({ error: "not found" }, { status: 404 });
+  }
+
+  revalidatePath(`/quotes/${id}`);
+  return NextResponse.json({ ok: true });
+}
