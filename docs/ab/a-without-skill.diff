+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusPoller } from "@/components/quote-status-poller";
+import { db } from "@/lib/db";
+import { QUOTE_BUDGET_OPTIONS } from "@/lib/quote-form";
+import type { QuoteStatus } from "@/lib/types";
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+// The workflow normally finishes in 40–90 s; past these marks we tell the user
+// it is taking longer and eventually stop polling an abandoned tab.
+const SLOW_AFTER_MS = 3 * 60 * 1000;
+const STOP_POLLING_AFTER_MS = 15 * 60 * 1000;
+
+const STATUS_LABELS: Record<QuoteStatus, string> = {
+  pending: "Готуємо",
+  ready: "Готово",
+  failed: "Помилка",
+};
+
+const STATUS_STYLES: Record<QuoteStatus, string> = {
+  pending: "bg-amber-50 text-amber-700 ring-amber-200",
+  ready: "bg-emerald-50 text-emerald-700 ring-emerald-200",
+  failed: "bg-red-50 text-red-700 ring-red-200",
+};
+
+// Server-only and computed per request, so reading the clock here is intended.
+function pendingAge(createdAt: string) {
+  return Date.now() - Date.parse(createdAt);
+}
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await db.getQuote(id);
+  if (!quote) notFound();
+
+  const age = pendingAge(quote.createdAt);
+  const budgetLabel = QUOTE_BUDGET_OPTIONS.find((option) => option.value === String(quote.budget ?? ""))?.label;
+
+  return (
+    <div className="space-y-6">
+      <div className="flex items-start justify-between gap-4">
+        <div>
+          <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+          <p className="text-sm text-slate-500">Запит від {dateTimeFormat.format(new Date(quote.createdAt))}</p>
+        </div>
+        <span
+          className={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${STATUS_STYLES[quote.status]}`}
+        >
+          {STATUS_LABELS[quote.status]}
+        </span>
+      </div>
+
+      <section className="space-y-3 rounded-lg border border-slate-200 bg-white p-5 text-sm" aria-live="polite">
+        {quote.status === "pending" && (
+          <>
+            <p className="font-medium">Готуємо ваш кошторис…</p>
+            <p className="text-slate-600">
+              {age < SLOW_AFTER_MS
+                ? "Зазвичай це займає до півтори хвилини. Сторінка оновиться автоматично."
+                : "Це триває довше, ніж зазвичай. Можете закрити сторінку — посилання на неї залишиться робочим."}
+            </p>
+            {age < STOP_POLLING_AFTER_MS ? (
+              <QuoteStatusPoller />
+            ) : (
+              <Link href={`/quotes/${quote.id}`} className="text-indigo-600 hover:text-indigo-800">
+                Перевірити ще раз
+              </Link>
+            )}
+          </>
+        )}
+
+        {quote.status === "ready" && quote.pdfUrl && (
+          <>
+            <p className="font-medium">Кошторис готовий.</p>
+            <a
+              href={quote.pdfUrl}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="inline-flex rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700"
+            >
+              Завантажити PDF
+            </a>
+          </>
+        )}
+
+        {quote.status === "failed" && (
+          <>
+            <p className="font-medium">Не вдалося підготувати кошторис.</p>
+            <p className="text-slate-600">{quote.error}</p>
+            <Link href="/quotes/new" className="text-indigo-600 hover:text-indigo-800">
+              Надіслати запит ще раз
+            </Link>
+          </>
+        )}
+      </section>
+
+      <dl className="grid grid-cols-1 gap-x-6 gap-y-3 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2">
+        <div>
+          <dt className="text-slate-500">Бюджет</dt>
+          <dd className="font-medium">{budgetLabel ?? "—"}</dd>
+        </div>
+        <div>
+          <dt className="text-slate-500">Номер запиту</dt>
+          <dd className="font-medium break-all">{quote.id}</dd>
+        </div>
+        <div className="sm:col-span-2">
+          <dt className="text-slate-500">Опис задачі</dt>
+          <dd className="whitespace-pre-line text-slate-700">{quote.description}</dd>
+        </div>
+      </dl>
+    </div>
+  );
+}
