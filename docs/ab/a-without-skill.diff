+const QUOTE_TIMEOUT_MS = 5 * 60 * 1000;
+
+export async function getQuote(id: string) {
+  const quote = await db.getQuote(id);
+  if (!quote) return null;
+  const stalled = quote.status === "pending" && Date.now() - Date.parse(quote.createdAt) > QUOTE_TIMEOUT_MS;
+  return { ...quote, stalled };
+}
