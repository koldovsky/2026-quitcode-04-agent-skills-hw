@@ -0,0 +1,47 @@
+"use server";
+
+import { redirect } from "next/navigation";
+import { after } from "next/server";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormData, type QuoteFormField } from "@/lib/quote-form";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors };
+  }
+
+  const quote = await db.insertQuoteRequest(parsed.data);
+
+  after(() => triggerQuoteWorkflow(quote.id, parsed.data));
+
+  redirect(`/quotes/${quote.id}`);
+}
+
+async function triggerQuoteWorkflow(quoteId: string, data: QuoteFormData) {
+  try {
+    const response = await fetch(process.env.N8N_QUOTE_WEBHOOK_URL!, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId,
+        ...data,
+        callbackUrl: `${process.env.APP_URL}/api/quotes/${quoteId}/complete`,
+        callbackSecret: process.env.N8N_CALLBACK_SECRET,
+      }),
+    });
+    if (!response.ok) {
+      throw new Error(`n8n responded with ${response.status}`);
+    }
+  } catch (error) {
+    console.error(`Failed to start quote workflow for ${quoteId}`, error);
+    await db.failQuoteRequest(quoteId, "Не вдалося запустити формування кошторису");
+  }
+}
