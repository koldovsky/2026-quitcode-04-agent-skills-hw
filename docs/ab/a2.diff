+export const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+export function formText(formData: FormData, name: string, max = 200) {
+  const value = formData.get(name);
+  return typeof value === "string" ? value.trim().slice(0, max) : "";
