+"use client";
+
+import { useEffect } from "react";
+import { useRouter } from "next/navigation";
+
+// Re-renders the server page every few seconds while the quote is still being prepared.
+// The page stops rendering this component once the status is final.
+export function QuoteStatusRefresher({ intervalMs = 5000 }: { intervalMs?: number }) {
+  const router = useRouter();
+
+  useEffect(() => {
+    const timer = setInterval(() => router.refresh(), intervalMs);
+    return () => clearInterval(timer);
+  }, [router, intervalMs]);
+
+  return null;
+}
