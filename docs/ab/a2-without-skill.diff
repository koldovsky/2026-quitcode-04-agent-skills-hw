+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { createCallbackToken } from "@/lib/quote-callback";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+
+const PUBLIC_FORM_WORKSPACE_ID = "ws_studio_nova";
+const TRIGGER_TIMEOUT_MS = 15_000;
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | {
+      status: "invalid";
+      errors: Partial<Record<QuoteFormField, string>>;
+      values: Partial<Record<QuoteFormField, string>>;
+    }
+  | { status: "error"; values: Partial<Record<QuoteFormField, string>> };
+
+// Public form, no session: the action only starts the workflow and returns at once.
+// The PDF arrives 40–90 s later through the callback route, never inside this request.
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) return { status: "invalid", errors: parsed.errors, values: parsed.values };
+
+  const { data } = parsed;
+  const values = { ...data, budget: data.budget === null ? "" : String(data.budget) };
+
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appBaseUrl = process.env.APP_BASE_URL;
+  if (!webhookUrl || !appBaseUrl) {
+    console.error("quote.misconfigured: N8N_QUOTE_WEBHOOK_URL or APP_BASE_URL is not set");
+    return { status: "error", values };
+  }
+
+  const { token, hash } = createCallbackToken();
+  const quote = await db.insertQuoteRequest({
+    ...data,
+    workspaceId: PUBLIC_FORM_WORKSPACE_ID,
+    callbackTokenHash: hash,
+  });
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl: new URL(`/api/quotes/${quote.id}/callback`, appBaseUrl).toString(),
+        callbackToken: token,
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    if (!response.ok) throw new Error(`n8n responded ${response.status}`);
+  } catch (error) {
+    console.error(`quote.trigger_failed ${quote.id}`, error);
+    await db.completeQuoteRequest(quote.id, { status: "failed", error: "trigger_failed" });
+    return { status: "error", values };
+  }
+
+  console.info("quote.requested", { quoteId: quote.id });
+  redirect(`/quotes/${quote.id}`);
+}
