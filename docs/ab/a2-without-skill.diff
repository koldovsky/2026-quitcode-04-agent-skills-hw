+import type { QuoteRequest } from "@/lib/types";
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+const usd = new Intl.NumberFormat("uk-UA", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
+
+type DisplayStatus = QuoteRequest["status"] | "timeout";
+
+// Server Component rendered per request (and on every refresh while pending), so reading the clock is fine.
+function displayStatus(quote: QuoteRequest): DisplayStatus {
+  if (quote.status === "pending" && Date.now() - Date.parse(quote.createdAt) > QUOTE_TIMEOUT_MS) return "timeout";
+  return quote.status;
+}
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await db.getQuoteRequest(id);
+  if (!quote) notFound();
