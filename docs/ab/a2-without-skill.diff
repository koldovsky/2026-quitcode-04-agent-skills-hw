+import type { NextRequest } from "next/server";
+import { db } from "@/lib/db";
+import { verifyCallbackToken } from "@/lib/quote-callback";
+
+// Called by the n8n `quote-request` workflow when the PDF is ready (or it gave up):
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <callbackToken from the trigger payload>
+//   { "status": "ready", "pdfUrl": "https://…" } | { "status": "failed", "error": "…" }
+
+const MAX_BODY_BYTES = 10_000;
+
+type CallbackResult = { status: "ready"; pdfUrl: string } | { status: "failed"; error: string };
+
+function parseResult(body: unknown): CallbackResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready") {
+    if (typeof pdfUrl !== "string" || pdfUrl.length > 2000) return null;
+    try {
+      // Rendered as a link on a public page: only plain web URLs, never javascript:/data:.
+      const url = new URL(pdfUrl);
+      if (url.protocol !== "https:" && url.protocol !== "http:") return null;
+      return { status, pdfUrl: url.toString() };
+    } catch {
+      return null;
+    }
+  }
+
+  if (status === "failed") {
+    return { status, error: typeof error === "string" && error ? error.slice(0, 500) : "unknown" };
+  }
+
+  return null;
+}
+
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+
+  const token = request.headers.get("authorization")?.match(/^Bearer (.+)$/)?.[1];
+  const quote = token ? await db.getQuoteRequest(id) : null;
+  // Same answer for "no such quote" and "wrong token", so ids cannot be probed.
+  if (!token || !quote || !verifyCallbackToken(token, quote.callbackTokenHash)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const raw = await request.text();
+  if (raw.length > MAX_BODY_BYTES) {
+    return Response.json({ error: "payload too large" }, { status: 413 });
+  }
+
+  let body: unknown;
+  try {
+    body = JSON.parse(raw);
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+
+  const result = parseResult(body);
+  if (!result) {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  // n8n may retry: a request that is already ready/failed is left as is, and the retry still gets 200.
+  const updated = await db.completeQuoteRequest(quote.id, result);
+  if (result.status === "failed") {
+    console.error(`quote.workflow_failed ${quote.id}`, result.error);
+  } else {
+    console.info("quote.ready", { quoteId: quote.id, updated });
+  }
+
+  return Response.json({ ok: true, updated });
+}
