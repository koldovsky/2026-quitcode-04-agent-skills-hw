+  const status = displayStatus(quote);
+
+  const details: Array<[string, string]> = [
+    ["Компанія", quote.company],
+    ["Email", quote.email],
+    ["Бюджет", quote.budget === null ? "—" : `${usd.format(quote.budget)} / міс.`],
+    ["Надіслано", dateTimeFormat.format(new Date(quote.createdAt))],
+  ];
+
+  return (
+    <div className="flex flex-1 flex-col">
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
+          <Link href="/" className="text-lg font-semibold tracking-tight">
+            Studio Nova
+          </Link>
+        </div>
+      </header>
+
+      <main className="mx-auto w-full max-w-3xl flex-1 space-y-6 px-6 py-12">
+        <h1 className="text-3xl font-semibold tracking-tight">Кошторис</h1>
+
+        <section role="status" aria-live="polite" className="rounded-lg border border-slate-200 bg-white p-5 text-sm">
+          {status === "pending" && (
+            <div className="flex items-center gap-3">
+              <span className="h-3 w-3 animate-pulse rounded-full bg-indigo-500" aria-hidden />
+              <div>
+                <p className="font-medium">Готуємо кошторис…</p>
+                <p className="text-slate-600">
+                  Зазвичай це займає до двох хвилин. Сторінка оновиться сама — її можна не перезавантажувати.
+                </p>
+              </div>
+            </div>
+          )}
+          {status === "ready" && quote.pdfUrl && (
+            <div className="space-y-3">
+              <p className="font-medium text-green-700">Кошторис готовий.</p>
+              <a
+                href={quote.pdfUrl}
+                target="_blank"
+                rel="noopener noreferrer"
+                className="inline-block rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700"
+              >
+                Завантажити PDF
+              </a>
+            </div>
+          )}
+          {status === "failed" && (
+            <div className="space-y-2">
+              <p className="font-medium text-red-700">Не вдалося підготувати кошторис.</p>
+              <p className="text-slate-600">
+                <Link href="/quotes/new" className="text-indigo-600 underline">
+                  Спробуйте ще раз
+                </Link>{" "}
+                або{" "}
+                <Link href="/" className="text-indigo-600 underline">
+                  залиште заявку
+                </Link>{" "}
+                — менеджер підготує кошторис вручну.
+              </p>
+            </div>
+          )}
+          {status === "timeout" && (
+            <div className="space-y-2">
+              <p className="font-medium text-amber-700">Кошторис готується довше, ніж зазвичай.</p>
+              <p className="text-slate-600">
+                Щойно він буде готовий, він з&apos;явиться на цій сторінці. Можна повернутися сюди пізніше.
+              </p>
+            </div>
+          )}
+        </section>
+
+        <dl className="grid grid-cols-1 gap-x-6 gap-y-3 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2">
