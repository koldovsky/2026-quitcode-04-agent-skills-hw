@@ -0,0 +1,79 @@
+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { createCallbackToken } from "@/lib/quote-callback";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+import type { Quote } from "@/lib/types";
+
+// The quote-request workflow runs 40-90 s. Its Webhook node must answer right away
+// ("Respond: Immediately"); the result arrives later at /api/quotes/[id]/callback.
+const TRIGGER_TIMEOUT_MS = 10_000;
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors };
+  }
+
+  const { token, hash } = createCallbackToken();
+  const quote = await db.insertQuote({ ...parsed.data, callbackTokenHash: hash });
+
+  await triggerQuoteWorkflow(quote, token);
+
+  redirect(`/quotes/${quote.id}`);
+}
+
+async function triggerQuoteWorkflow(quote: Quote, callbackToken: string) {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  // Built from config, not from the Host header: a forged Host would send the token elsewhere.
+  const appUrl = process.env.APP_URL;
+  if (!webhookUrl || !appUrl) {
+    console.error("N8N_QUOTE_WEBHOOK_URL or APP_URL is not set");
+    await failQuote(quote.id);
+    return;
+  }
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        callbackUrl: new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString(),
+        callbackToken,
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    if (!response.ok) {
+      console.error(`n8n rejected quote ${quote.id}: HTTP ${response.status}`);
+      await failQuote(quote.id);
+    }
+  } catch (error) {
+    if (error instanceof DOMException && error.name === "TimeoutError") {
+      // n8n may well have started the run and will still call back; keep the quote pending.
+      console.warn(`n8n did not answer for quote ${quote.id} within ${TRIGGER_TIMEOUT_MS} ms`);
+      return;
+    }
+    console.error(`Failed to start quote-request for ${quote.id}`, error);
+    await failQuote(quote.id);
+  }
+}
+
+function failQuote(id: string) {
+  return db.completeQuote(id, {
+    status: "failed",
+    error: "Не вдалося запустити підготовку кошторису. Спробуйте ще раз трохи пізніше.",
+  });
+}
