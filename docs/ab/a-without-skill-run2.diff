+import type { NextRequest } from "next/server";
+import { db } from "@/lib/db";
+import { verifyCallbackToken } from "@/lib/quote-callback";
+import type { QuoteResult } from "@/lib/types";
+
+// Called by the n8n quote-request workflow when the PDF is ready (or the run failed):
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <callbackToken from the trigger payload>
+//   { "status": "ready", "pdfUrl": "https://…" }  or  { "status": "failed", "error": "…" }
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+  const quote = await db.getQuote(id);
+  // Same answer for an unknown quote and a wrong token: the endpoint does not confirm ids.
+  if (!quote || !verifyCallbackToken(request.headers.get("authorization"), quote.callbackTokenHash)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const result = parseResult(quote.id, await request.json().catch(() => null));
+  if (!result) {
+    return Response.json({ error: "invalid payload" }, { status: 400 });
+  }
+
+  if (!(await db.completeQuote(quote.id, result))) {
+    // Re-read: a parallel callback may have completed the quote after the read above.
+    const current = (await db.getQuote(quote.id))?.status;
+    // n8n retries a step that timed out on its side: repeating the same outcome is not an error.
+    return current === result.status
+      ? Response.json({ ok: true })
+      : Response.json({ error: `quote is already ${current}` }, { status: 409 });
+  }
+
+  return Response.json({ ok: true });
+}
+
+function parseResult(quoteId: string, body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready") {
+    // Rendered as a link on a public page: only http(s), never javascript: or data: URLs.
+    if (typeof pdfUrl !== "string" || pdfUrl.length > 2000 || !URL.canParse(pdfUrl)) return null;
+    const { protocol } = new URL(pdfUrl);
+    return protocol === "https:" || protocol === "http:" ? { status, pdfUrl } : null;
+  }
+
+  if (status === "failed") {
+    // n8n errors can name nodes, credentials or hosts; keep them in the log, not on the public page.
+    console.error(`quote-request failed for ${quoteId}:`, typeof error === "string" ? error.slice(0, 500) : error);
+    return { status, error: "Під час підготовки кошторису сталася помилка. Спробуйте ще раз трохи пізніше." };
+  }
+
+  return null;
+}
