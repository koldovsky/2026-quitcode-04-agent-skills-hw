diff --git a/lib/quote-callback.ts b/lib/quote-callback.ts
new file mode 100644
index 0000000..f3c79d1
--- /dev/null
+++ b/lib/quote-callback.ts
@@ -0,0 +1,21 @@
+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+
+// Each quote gets its own callback token. It travels to n8n once, in the trigger payload, and
+// n8n sends it back as `Authorization: Bearer <token>`. Only its hash is stored, so a leaked
+// store dump cannot complete quotes, and a token for one quote is useless for any other.
+
+export function createCallbackToken() {
+  const token = randomBytes(32).toString("base64url");
+  return { token, hash: hashToken(token) };
+}
+
+function hashToken(token: string) {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+export function verifyCallbackToken(authorization: string | null, expectedHash: string) {
+  const token = authorization?.match(/^Bearer (\S+)$/)?.[1];
+  if (!token) return false;
+  // Both sides are sha256 hex digests, so the lengths always match.
+  return timingSafeEqual(Buffer.from(hashToken(token)), Buffer.from(expectedHash));
+}
