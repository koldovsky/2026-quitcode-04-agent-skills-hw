+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { RefreshWhilePending } from "@/components/refresh-while-pending";
+import { db } from "@/lib/db";
+import type { Quote } from "@/lib/types";
+
+// Anyone with the link can open this page, so keep it out of search engines and Referer headers.
+export const metadata: Metadata = {
+  title: "Кошторис · Studio Nova",
+  robots: { index: false, follow: false },
+  referrer: "no-referrer",
+};
+
+// The workflow takes up to 90 s; well past that, tell the visitor instead of spinning forever.
+const SLOW_AFTER_MS = 5 * 60 * 1000;
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+const usd = new Intl.NumberFormat("uk-UA", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
+
+function isSlow(quote: Quote) {
+  return Date.now() - Date.parse(quote.createdAt) > SLOW_AFTER_MS;
+}
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await db.getQuote(id);
+  if (!quote) notFound();
+
+  const details: Array<[string, string]> = [
+    ["Компанія", quote.company],
+    ["Email", quote.email],
+    ["Бюджет", quote.budget === null ? "не визначено" : `${usd.format(quote.budget)} / міс.`],
+    ["Надіслано", dateTimeFormat.format(new Date(quote.createdAt))],
+  ];
+
+  return (
+    <div className="flex flex-1 flex-col">
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
+          <Link href="/" className="text-lg font-semibold tracking-tight">
+            Studio Nova
+          </Link>
+        </div>
+      </header>
+
+      <main className="mx-auto w-full max-w-3xl flex-1 space-y-6 px-6 py-12">
+        <h1 className="text-2xl font-semibold tracking-tight">Запит на кошторис</h1>
+
+        <QuoteStatus quote={quote} />
+
+        <dl className="grid grid-cols-1 gap-x-6 gap-y-3 rounded-lg border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2">
+          {details.map(([label, value]) => (
+            <div key={label}>
+              <dt className="text-slate-500">{label}</dt>
+              <dd className="font-medium break-words">{value}</dd>
+            </div>
+          ))}
+        </dl>
+
+        <section className="space-y-2 rounded-lg border border-slate-200 bg-white p-5 text-sm">
+          <h2 className="font-medium">Опис задачі</h2>
+          <p className="whitespace-pre-line text-slate-700">{quote.description}</p>
+        </section>
+      </main>
+    </div>
+  );
+}
+
+function QuoteStatus({ quote }: { quote: Quote }) {
+  if (quote.status === "ready" && quote.pdfUrl) {
+    return (
+      <section className="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-emerald-200 bg-emerald-50 p-5">
+        <p className="font-medium text-emerald-800">Кошторис готовий</p>
+        <a
+          href={quote.pdfUrl}
+          target="_blank"
+          rel="noopener noreferrer"
+          className="rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700"
+        >
+          Завантажити PDF
+        </a>
+      </section>
+    );
+  }
+
+  if (quote.status === "failed") {
+    return (
+      <section className="space-y-3 rounded-lg border border-red-200 bg-red-50 p-5">
+        <p className="font-medium text-red-800">Не вдалося підготувати кошторис</p>
+        <p className="text-sm text-red-700">{quote.error}</p>
+        <Link href="/quotes/new" className="inline-block text-sm font-medium text-red-800 underline">
+          Надіслати запит ще раз
+        </Link>
+      </section>
+    );
+  }
+
+  return (
+    <section className="flex items-start gap-3 rounded-lg border border-sky-200 bg-sky-50 p-5" aria-live="polite">
+      <span className="mt-1 h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-sky-300 border-t-sky-700" />
+      <div>
+        <p className="font-medium text-sky-800">Готуємо кошторис…</p>
+        <p className="text-sm text-sky-700">
+          {isSlow(quote)
+            ? "Це займає довше, ніж зазвичай. Збережіть посилання на цю сторінку й поверніться пізніше."
+            : "Зазвичай це 1–2 хвилини. Сторінка оновиться сама."}
+        </p>
+      </div>
+      <RefreshWhilePending />
+    </section>
+  );
+}
