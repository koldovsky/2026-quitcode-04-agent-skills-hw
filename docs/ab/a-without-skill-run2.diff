+"use client";
+
+import { useEffect } from "react";
+import { useRouter } from "next/navigation";
+
+// Re-renders the server page every few seconds; render it only while the quote is pending,
+// so polling stops by itself once the page comes back with a final status.
+export function RefreshWhilePending({ intervalMs = 5000 }: { intervalMs?: number }) {
+  const router = useRouter();
+
+  useEffect(() => {
+    const timer = setInterval(() => router.refresh(), intervalMs);
+    return () => clearInterval(timer);
+  }, [router, intervalMs]);
+
+  return null;
+}
