+"use server";
+
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+import { after } from "next/server";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField } from "@/lib/quote-form";
+import { createCallbackToken, triggerQuoteWorkflow } from "@/lib/quotes";
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>> };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors };
+  }
+
+  const requestHeaders = await headers();
+  const ipAddress = requestHeaders.get("x-forwarded-for")?.split(",")[0].trim() ?? "127.0.0.1";
+
+  const { token, hash } = createCallbackToken();
+  const quote = await db.insertQuote({ ...parsed.data, callbackTokenHash: hash, ipAddress });
+
+  // Start the workflow after the response: the visitor lands on the status page immediately
+  // instead of waiting for n8n; the result arrives later via /api/quotes/[id]/callback.
+  after(() => triggerQuoteWorkflow(quote, token));
+
+  redirect(`/quotes/${quote.id}`);
+}
