+import type { NextRequest } from "next/server";
+import { db } from "@/lib/db";
+import { parseQuoteResult, verifyCallbackToken } from "@/lib/quotes";
+
+const MAX_BODY_BYTES = 16 * 1024;
+
+// n8n calls this when the quote-request workflow finishes:
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <callbackToken from the trigger payload>
+//   { "status": "ready", "pdfUrl": "https://…" } | { "status": "failed", "error": "…" }
+export async function POST(request: NextRequest, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+  const token = request.headers.get("authorization")?.match(/^Bearer (\S+)$/)?.[1];
+  const quote = await db.getQuote(id);
+
+  // Same answer for an unknown quote and a wrong token: do not reveal which quote ids exist.
+  if (!quote || !token || !verifyCallbackToken(token, quote.callbackTokenHash)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const raw = await request.text();
+  if (raw.length > MAX_BODY_BYTES) {
+    return Response.json({ error: "payload too large" }, { status: 413 });
+  }
+
+  let body: unknown;
+  try {
+    body = JSON.parse(raw);
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+
+  const result = parseQuoteResult(body);
+  if (!result) {
+    return Response.json({ error: "expected {status:'ready',pdfUrl} or {status:'failed',error}" }, { status: 400 });
+  }
+
+  if (quote.status !== "pending") {
+    // n8n retries on errors/timeouts: repeating the same outcome is fine, changing it is not.
+    return quote.status === result.status
+      ? Response.json({ ok: true, duplicate: true })
+      : Response.json({ error: `quote is already ${quote.status}` }, { status: 409 });
+  }
+
+  await db.finishQuote(quote.id, result);
+  return Response.json({ ok: true });
+}
