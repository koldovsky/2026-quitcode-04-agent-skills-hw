+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import { db } from "./db";
+import { budgetLabel } from "./quote-form";
+import type { Quote, QuoteResult } from "./types";
+
+// The workflow runs 40–90 s. Its webhook should answer right away ("Respond: Immediately" in n8n)
+// and report the result later via the callback, so we only wait for the acknowledgement.
+const TRIGGER_TIMEOUT_MS = 15_000;
+
+// A pending quote older than this is shown as delayed: the callback most likely never came.
+const QUOTE_STALE_AFTER_MS = 5 * 60 * 1000;
+
+export function isQuoteStale(quote: Quote, now = Date.now()) {
+  return quote.status === "pending" && now - Date.parse(quote.createdAt) > QUOTE_STALE_AFTER_MS;
+}
+
+function sha256(value: string) {
+  return createHash("sha256").update(value).digest();
+}
+
+// One-time secret per quote: n8n receives it in the trigger and sends it back as a Bearer token.
+export function createCallbackToken() {
+  const token = randomBytes(32).toString("base64url");
+  return { token, hash: sha256(token).toString("hex") };
+}
+
+export function verifyCallbackToken(token: string, expectedHash: string) {
+  const expected = Buffer.from(expectedHash, "hex");
+  const actual = sha256(token);
+  return expected.length === actual.length && timingSafeEqual(expected, actual);
+}
+
+export async function triggerQuoteWorkflow(quote: Quote, callbackToken: string) {
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  const appUrl = process.env.APP_URL;
+  if (!webhookUrl || !appUrl) {
+    console.error(`Quote ${quote.id}: N8N_QUOTE_WEBHOOK_URL or APP_URL is not set`);
+    await db.finishQuote(quote.id, { status: "failed", error: "not_configured" });
+    return;
+  }
+
+  // Built from APP_URL, not the request Host header, so a spoofed Host cannot redirect n8n.
+  const callbackUrl = new URL(`/api/quotes/${quote.id}/callback`, appUrl).toString();
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        company: quote.company,
+        email: quote.email,
+        description: quote.description,
+        budget: quote.budget,
+        budgetLabel: budgetLabel(quote.budget),
+        requestedAt: quote.createdAt,
+        callbackUrl,
+        callbackToken,
+      }),
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    if (!response.ok) {
+      console.error(`Quote ${quote.id}: n8n answered ${response.status}`);
+      await db.finishQuote(quote.id, { status: "failed", error: "trigger_rejected" });
+    }
+  } catch (error) {
+    if (error instanceof DOMException && error.name === "TimeoutError") {
+      // n8n may still be running the workflow (webhook set to respond at the end):
+      // keep the quote pending and let the callback or the stale timeout decide.
+      console.warn(`Quote ${quote.id}: n8n did not acknowledge within ${TRIGGER_TIMEOUT_MS} ms`);
+      return;
+    }
+    console.error(`Quote ${quote.id}: failed to reach n8n`, error);
+    await db.finishQuote(quote.id, { status: "failed", error: "trigger_unreachable" });
+  }
+}
+
+// Expected body: { "status": "ready", "pdfUrl": "https://…" } or { "status": "failed", "error": "…" }.
+export function parseQuoteResult(body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready") {
+    if (typeof pdfUrl !== "string" || pdfUrl.length > 2000) return null;
+    // Only http(s): the link is rendered on a public page, so javascript:/data: URLs are rejected.
+    if (!URL.canParse(pdfUrl) || !["https:", "http:"].includes(new URL(pdfUrl).protocol)) return null;
+    return { status: "ready", pdfUrl };
+  }
+
+  if (status === "failed") {
+    return { status: "failed", error: typeof error === "string" ? error.slice(0, 500) : "workflow_failed" };
+  }
+
+  return null;
+}
