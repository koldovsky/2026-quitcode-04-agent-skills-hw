+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusRefresher } from "@/components/quote-status-refresher";
+import { db } from "@/lib/db";
+
+export const metadata = { title: "Статус кошторису · Studio Nova" };
+
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = UUID_RE.test(id) ? await db.getQuote(id) : null;
+  if (!quote) notFound();
+
+  const pending = quote.status === "queued" || quote.status === "sent";
+
+  return (
+    <div className="flex flex-1 flex-col">
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
+          <Link href="/" className="text-lg font-semibold tracking-tight">
+            Studio Nova
+          </Link>
+        </div>
+      </header>
+
+      <main className="mx-auto w-full max-w-2xl flex-1 space-y-6 px-6 py-12">
+        <div>
+          <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+          <p className="text-sm text-slate-500">Запит від {dateTimeFormat.format(new Date(quote.createdAt))}</p>
+        </div>
+
+        <section className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" aria-live="polite">
+          {pending && (
+            <div className="space-y-2">
+              <p className="flex items-center gap-2 font-medium">
+                <span className="h-2 w-2 animate-pulse rounded-full bg-indigo-500" aria-hidden />
+                Готуємо кошторис…
+              </p>
+              <p className="text-sm text-slate-600">
+                Зазвичай це займає одну-дві хвилини. Сторінка оновиться сама.
+              </p>
+              <QuoteStatusRefresher />
+            </div>
+          )}
+
+          {quote.status === "ready" && (
+            <div className="space-y-3">
+              <p className="font-medium text-emerald-700">Кошторис готовий.</p>
+              {quote.documentUrl ? (
+                <a
+                  href={quote.documentUrl}
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  className="inline-flex rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
+                >
+                  Відкрити PDF
+                </a>
+              ) : (
+                <p className="text-sm text-slate-600">Посилання на документ недоступне — менеджер зв&apos;яжеться з вами.</p>
+              )}
+            </div>
+          )}
+
+          {quote.status === "failed" && (
+            <div className="space-y-2">
+              <p className="font-medium text-red-700">Не вдалося підготувати кошторис.</p>
+              <p className="text-sm text-slate-600">
+                Спробуйте ще раз або{" "}
+                <Link href="/" className="text-indigo-600 hover:underline">
+                  залиште заявку
+                </Link>{" "}
+                — менеджер зв&apos;яжеться з вами.
+              </p>
+              <Link href="/quotes/new" className="inline-block text-sm text-indigo-600 hover:underline">
+                Новий запит на кошторис
+              </Link>
+            </div>
+          )}
+        </section>
+      </main>
+    </div>
+  );
+}
