+import { timingSafeEqual } from "crypto";
+import { revalidatePath } from "next/cache";
+import { db } from "@/lib/db";
+import type { QuoteResult } from "@/lib/types";
+
+// n8n calls this once the `quote-request` workflow finishes (40-90s later)
+// with the PDF result, authenticated by a header shared secret.
+function isAuthorized(request: Request) {
+  const expected = process.env.N8N_CALLBACK_SECRET;
+  if (!expected) return false;
+
+  const provided = request.headers.get("x-webhook-secret") ?? "";
+  const expectedBuf = Buffer.from(expected);
+  const providedBuf = Buffer.from(provided);
+  if (expectedBuf.length !== providedBuf.length) return false;
+  return timingSafeEqual(expectedBuf, providedBuf);
+}
+
+function parseBody(body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready" && typeof pdfUrl === "string" && pdfUrl) {
+    return { status: "ready", pdfUrl };
+  }
+  if (status === "failed" && typeof error === "string" && error) {
+    return { status: "failed", error };
+  }
+  return null;
+}
+
+export async function POST(request: Request, { params }: RouteContext<"/api/quotes/[id]/callback">) {
+  if (!isAuthorized(request)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const { id } = await params;
+  const quote = await db.getQuoteRequest(id);
+  if (!quote) {
+    return Response.json({ error: "quote not found" }, { status: 404 });
+  }
+
+  const result = parseBody(await request.json().catch(() => null));
+  if (!result) {
+    return Response.json({ error: "invalid body" }, { status: 400 });
+  }
+
+  const applied = await db.completeQuoteRequest(id, result);
+  if (applied) revalidatePath(`/quotes/${id}`);
+
+  return Response.json({ ok: true });
+}
