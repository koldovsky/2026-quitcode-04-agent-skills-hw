+++ b/components/quote-status-poller.tsx
@@ -0,0 +1,20 @@
+"use client";
+
+import { useEffect } from "react";
+import { useRouter } from "next/navigation";
+
+const POLL_INTERVAL_MS = 4000;
+
+// Keeps a pending quote page fresh without the visitor reloading manually:
+// the workflow finishes server-side (40-90s) and calls back into our API,
+// so we just re-render this route until the status leaves "pending".
+export function QuoteStatusPoller() {
+  const router = useRouter();
+
+  useEffect(() => {
+    const interval = setInterval(() => router.refresh(), POLL_INTERVAL_MS);
+    return () => clearInterval(interval);
+  }, [router]);
+
+  return null;
+}
