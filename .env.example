# LeadDesk local settings. Copy this file to .env.local and put real values there.
# .env* files are git-ignored (except this example), so real values never reach git.
# All four are server-only: never add a NEXT_PUBLIC_ prefix.

# Production webhook base of n8n (ends with /webhook, never /webhook-test).
# Locally it points at the offline mock: node tools/mock-n8n.mjs
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook

# Value of the x-n8n-token header = the n8n Header Auth credential value.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_TOKEN=change-me-webhook-token

# HMAC secret of the callbacks = Hmac Secret of the n8n Crypto credential.
N8N_CALLBACK_SECRET=change-me-callback-secret

# Where n8n reaches this app (callbackUrl = APP_BASE_URL/api/n8n/<event>).
APP_BASE_URL=http://127.0.0.1:3000
