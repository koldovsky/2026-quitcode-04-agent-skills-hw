# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.

# n8n webhook contract (.claude/skills/integrating-n8n-webhooks). Server-only, never NEXT_PUBLIC_.
# Events: lead-created (public lead form), quote-request (/quotes/new). Locally: node tools/mock-n8n.mjs
# Production webhook base URL, ends with /webhook (the event name is appended in code).
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
# Header Auth value sent as x-n8n-token.
N8N_WEBHOOK_TOKEN=change-me-webhook-token
# HMAC secret for signed n8n callbacks to /api/n8n/<event>.
N8N_CALLBACK_SECRET=change-me-callback-secret
# Where n8n can reach this app for callbacks.
APP_BASE_URL=http://127.0.0.1:3000
