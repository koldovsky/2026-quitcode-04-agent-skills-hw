# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.
# All N8N_* values are server-only: never prefix them with NEXT_PUBLIC_.

# Base of the n8n PRODUCTION webhooks (ends with /webhook, never /webhook-test).
# The event is appended: <base>/lead-created, <base>/quote-request.
# Locally it points at the offline n8n mock:
#   node --env-file=.env.local .claude/skills/integrating-n8n-webhooks/scripts/mock-n8n.mjs --mode respond-202 --delay 5000
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook

# Value of the x-n8n-token header (= Header Auth credential in n8n).
N8N_WEBHOOK_TOKEN=change-me-webhook-token

# HMAC secret for callbacks from n8n (= Hmac Secret of the Crypto credential in n8n).
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
N8N_CALLBACK_SECRET=change-me-callback-secret

# Address at which n8n reaches this app's callback routes (/api/n8n/<event>).
APP_BASE_URL=http://127.0.0.1:3000
