# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.

# n8n (server-only, never NEXT_PUBLIC_). Contract: .claude/skills/integrating-n8n-webhooks.
# Production base URL — ends with /webhook (never the editor's test URL). Locally: the offline mock
#   node --env-file=.env.local .claude/skills/integrating-n8n-webhooks/scripts/mock-n8n.mjs --mode respond-202
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
# Header Auth value for x-n8n-token. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_TOKEN=change-me-webhook-token
# HMAC secret n8n signs callbacks with (Crypto credential). Generate the same way.
N8N_CALLBACK_SECRET=change-me-callback-secret
# Where n8n reaches this app's callbacks: ${APP_BASE_URL}/api/n8n/<event>
APP_BASE_URL=http://127.0.0.1:3000
# Events: ${N8N_WEBHOOK_BASE_URL}/lead-created (public lead form), /quote-request (/quotes/new).
# See docs/n8n-integrations.md.
