# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.

# n8n contract (.claude/skills/integrating-n8n-webhooks). Server-only: never prefix with NEXT_PUBLIC_.
# Production webhook base (/webhook, not /webhook-test); the event name is appended: .../webhook/lead-created,
# .../webhook/quote-request. Locally it points at the offline n8n mock: node --env-file=.env.local tools/mock-n8n.mjs
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
# Value of the x-n8n-token header (= Header Auth credential in n8n)
N8N_WEBHOOK_TOKEN=change-me-webhook-token
# HMAC secret for callbacks from n8n (= Crypto credential in n8n). Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
N8N_CALLBACK_SECRET=change-me-callback-secret
# Address where n8n reaches this app's callbacks: ${APP_BASE_URL}/api/n8n/<event>
APP_BASE_URL=http://127.0.0.1:3000
