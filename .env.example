# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.

# n8n — contract in .claude/skills/integrating-n8n-webhooks; events in docs/n8n-integrations.md.
# lib/n8n/client.ts calls ${N8N_WEBHOOK_BASE_URL}/<event>: lead-created (public form) and
# quote-request (/quotes/new, callback to app/api/n8n/[event]). Locally the offline mock:
#   node --env-file=.env.local tools/mock-n8n.mjs --mode respond-202 --delay 5000
# Server-only — never with the NEXT_PUBLIC_ prefix. Real values go to .env.local; generate secrets with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Production webhook base (always /webhook, never /webhook-test); locally the n8n mock.
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
# Value of the x-n8n-token header; the same as the Header Auth credential in n8n.
N8N_WEBHOOK_TOKEN=change-me-webhook-token
# HMAC key for callbacks from n8n; the same as the Hmac Secret of the Crypto credential in n8n.
N8N_CALLBACK_SECRET=change-me-callback-secret
# App address as n8n sees it (for callbackUrl).
APP_BASE_URL=http://127.0.0.1:3000
