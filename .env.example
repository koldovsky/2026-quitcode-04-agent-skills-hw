# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.

# n8n webhook that receives every new lead from the public form.
# Locally it points at the offline n8n mock: node tools/mock-n8n.mjs
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/lead-created

# Production n8n webhook base — commit only the production path here; a local
# test path belongs in your own .env.local, never here.
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
# Value of the x-n8n-token header n8n expects on incoming webhook calls.
N8N_WEBHOOK_TOKEN=change-me-webhook-token
# HMAC secret used to verify n8n's callback signature (x-n8n-signature).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
N8N_CALLBACK_SECRET=change-me-callback-secret
# Address n8n uses to reach this app's callback routes.
APP_BASE_URL=http://127.0.0.1:3000
