# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.

# --- n8n (server-only). Real values only in .env.local, never /webhook-test/ here. ---
# Locally everything points at the offline n8n mock:
#   node --env-file=.env.local tools/mock-n8n.mjs --mode respond-202 --delay 5000
# Base of published n8n webhooks; the event is appended: {base}/lead-created, {base}/quote-request.
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
# Header Auth token n8n checks on incoming webhooks (sent as x-n8n-token).
N8N_WEBHOOK_TOKEN=change-me-webhook-token
# Shared secret n8n signs its callbacks with (HMAC-SHA256 over "timestamp.rawBody").
N8N_CALLBACK_SECRET=change-me-callback-secret
# Public base URL of this app; callbackUrl = {APP_BASE_URL}/api/n8n/<event>.
APP_BASE_URL=http://127.0.0.1:3000
