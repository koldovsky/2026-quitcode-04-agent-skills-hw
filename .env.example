# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.

# n8n contract (see docs/n8n-integrations.md). Server-only: never a NEXT_PUBLIC_ prefix.
# Production webhook base only (…/webhook), never the test URL. Real secrets go to .env.local.
# Locally: node --env-file=.env.local .claude/skills/integrating-n8n-webhooks/scripts/mock-n8n.mjs --mode respond-202
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
# Value of the x-n8n-token header (= the Header Auth credential of the n8n Webhook node).
N8N_WEBHOOK_TOKEN=change-me-webhook-token
# HMAC secret of the callbacks (= the Hmac Secret of the n8n Crypto credential).
N8N_CALLBACK_SECRET=change-me-callback-secret
# Address of this app as n8n sees it: callbacks go to ${APP_BASE_URL}/api/n8n/<event>.
APP_BASE_URL=http://127.0.0.1:3000
